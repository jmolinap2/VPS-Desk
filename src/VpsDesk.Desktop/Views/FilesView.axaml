<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:files="using:VpsDesk.Domain.Files"
             x:Class="VpsDesk.Desktop.Views.FilesView"
             x:DataType="vm:FilesViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Files_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Files_Subtitle}" Foreground="#8290A3" FontSize="11" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" Foreground="#8290A3" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Content="{DynamicResource Common_Up}" Command="{Binding GoParentCommand}" IsEnabled="{Binding CanGoParent}" />
        <TextBox Grid.Column="1" Text="{Binding CurrentPath}" PlaceholderText="/var/www" />
        <Button Grid.Column="2" Content="{DynamicResource Common_Go}" Command="{Binding NavigatePathCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="3" Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="1.05*,1.45*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Files_RemoteDirectory}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Files_RemoteDirectoryHelp}" Foreground="#66758A" FontSize="11" />
          </StackPanel>

          <Border Grid.Row="1" Background="#0E131B" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#8290A3" TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="10">
            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="files:RemoteFileEntry">
                  <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Kind}" Foreground="#66758A" FontSize="10" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="#A8B4C5" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" Content="{DynamicResource Files_OpenSelected}" Command="{Binding OpenSelectedCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Files_TextEditor}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EditorPath}" Foreground="#8290A3" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Border Grid.Row="1" Background="#111722" CornerRadius="8" Padding="10">
            <TextBlock Text="{DynamicResource Files_EditorHelp}" Foreground="#8290A3" FontSize="11" TextWrapping="Wrap" />
          </Border>

          <TextBox Grid.Row="2"
                   Text="{Binding EditorContent}"
                   IsReadOnly="{Binding !HasOpenTextFile}"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Background="#080B10"
                   BorderThickness="0"
                   Padding="14"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />

          <StackPanel Grid.Row="3" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource Files_Save}" Command="{Binding RequestSaveCommand}" IsEnabled="{Binding HasOpenTextFile}" />
              <Button Content="{DynamicResource Files_CloseEditor}" Command="{Binding CloseEditorCommand}" IsEnabled="{Binding HasOpenTextFile}" />
            </StackPanel>

            <Border Background="#201A12" BorderBrush="#55452E" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding HasPendingSave}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding PendingSaveMessage}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{DynamicResource Files_ConfirmSave}" Command="{Binding ConfirmSaveCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSaveCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
