<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:services="using:VpsDesk.Desktop.Services"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileProjectsView"
             x:DataType="vm:ProjectsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <!--
    Proyectos para teléfono: en vez de dos listas lado a lado (0.9* / 1.35*),
    una sola lista a la vez en pestañas, y las acciones de cada lista en una
    barra fija abajo. Menos elementos juntos, cada uno con espacio para leerse.
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- proyecto activo -->
    <Border Grid.Row="0" Classes="surface" Margin="16,12,16,0">
      <StackPanel Spacing="4">
        <TextBlock Classes="t-overline" Text="{DynamicResource Ui_ActiveProject}" />
        <TextBlock Classes="t-title" Text="{Binding ActiveProjectName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="t-mono" Text="{Binding ActiveProjectPath}" TextTrimming="CharacterEllipsis" />
        <Border Classes="status accent" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding ActiveProjectMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ActiveProjectMode}" />
        </Border>
      </StackPanel>
    </Border>

    <!-- selector de lista + estado -->
    <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="8">
      <Border Classes="seg-track">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
          <Button x:Name="AssociatedTab" Classes="seg active" Click="OnTabClick" Tag="associated">
            <TextBlock>
              <Run Text="{DynamicResource Ui_AssociatedLabel}" /><Run Text="  " /><Run Text="{Binding AssociatedProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
          <Button x:Name="DiscoveredTab" Grid.Column="1" Classes="seg" Click="OnTabClick" Tag="discovered">
            <TextBlock>
              <Run Text="{DynamicResource Ui_Discovered}" /><Run Text="  " /><Run Text="{Binding DiscoveredProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <TextBlock Classes="t-label" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="2,0" />
    </StackPanel>

    <!-- listas -->
    <Panel Grid.Row="2">
     <Panel x:Name="AssociatedPane">
      <StackPanel x:Name="AssociatedEmpty" IsVisible="{Binding !HasProjects}" VerticalAlignment="Top" Spacing="10" Margin="40,32" IsHitTestVisible="False">
        <Path Classes="icon tertiary" Data="{StaticResource Icon.Box}" Width="28" Height="28" HorizontalAlignment="Center" />
        <TextBlock Classes="t-body-s" Text="{DynamicResource Projects_EmptyAssociated}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox x:Name="AssociatedList" Classes="projects" Margin="16,0,16,8" Background="Transparent"
               ItemsSource="{Binding AssociatedProjects}" SelectedItem="{Binding SelectedProject}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="services:ProjectWorkspace">
            <Border Classes="surface" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="t-body" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="status accent" VerticalAlignment="Center"><TextBlock Text="{Binding ModeLabel}" /></Border>
                </Grid>
                <TextBlock Classes="t-mono" Text="{Binding RemoteRepositoryPath}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="t-label" Text="{Binding CapabilitySummary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
     </Panel>
     <Panel x:Name="DiscoveredPane" IsVisible="False">
      <StackPanel x:Name="DiscoveredEmpty" IsVisible="{Binding !HasDiscoveredProjects}" VerticalAlignment="Top" Spacing="10" Margin="40,32" IsHitTestVisible="False">
        <Path Classes="icon tertiary" Data="{StaticResource Icon.Folder}" Width="28" Height="28" HorizontalAlignment="Center" />
        <TextBlock Classes="t-body-s" Text="{DynamicResource Projects_EmptyDiscovered}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <ListBox x:Name="DiscoveredList" Classes="projects" Margin="16,0,16,8" Background="Transparent"
               ItemsSource="{Binding DiscoveredProjects}" SelectedItem="{Binding SelectedDiscovery}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectDiscoveryItem">
            <Border Classes="surface" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="t-body" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="status accent" VerticalAlignment="Center"><TextBlock Text="{Binding ModeLabel}" /></Border>
                </Grid>
                <TextBlock Classes="t-mono" Text="{Binding RemoteRepositoryPath}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis">
                  <Run Text="{DynamicResource Ui_BranchLabel}" /><Run Text="{Binding Branch}" Foreground="{DynamicResource Brush.Text.Tertiary}" /><Run Text="{DynamicResource Ui_ComposeLabel}" /><Run Text="{Binding ComposeFile}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </TextBlock>
                <Border Classes="status info" HorizontalAlignment="Left" IsVisible="{Binding AlreadyAssociated}"><TextBlock Text="{DynamicResource Ui_Associated}" /></Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
     </Panel>
    </Panel>

    <!-- acciones de la lista visible: secundaria a la izquierda, principal a la derecha -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Bar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
      <Panel>
        <Grid x:Name="AssociatedActions" ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Content="{DynamicResource Ui_RemoveAssociation}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasActiveProject}" />
          <Button Grid.Column="1" Classes="btn-primary" HorizontalAlignment="Stretch" Content="{DynamicResource Ui_UseSelected}" Command="{Binding ActivateSelectedCommand}" IsEnabled="{Binding HasActiveProject}" />
        </Grid>
        <Grid x:Name="DiscoveredActions" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
          <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Content="{DynamicResource Ui_DiscoverProjects}" Command="{Binding DiscoverCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="1" Classes="btn-primary" HorizontalAlignment="Stretch" Content="{DynamicResource Ui_AssociateProject}" Command="{Binding AssociateSelectedCommand}" IsEnabled="{Binding HasDiscoveredProjects}" />
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
