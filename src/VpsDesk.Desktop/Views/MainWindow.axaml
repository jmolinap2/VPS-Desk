<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VpsDesk.Desktop.ViewModels"
        xmlns:views="using:VpsDesk.Desktop.Views"
        x:Class="VpsDesk.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VPS Desk"
        Width="1080"
        Height="820"
        MinWidth="900"
        MinHeight="640">
  <Grid ColumnDefinitions="224,*" RowDefinitions="64,*">
    <Border Grid.RowSpan="2" Background="#0E1219" BorderBrush="#202734" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="72,60,*">
        <StackPanel Margin="20,18,12,12">
          <TextBlock Text="VPS Desk" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource App_Subtitle}" FontSize="11" Foreground="#8290A3" />
        </StackPanel>

        <Border Grid.Row="1" Margin="12,4" Padding="12,8" Background="#151B25" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="{Binding SelectedServerName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#8290A3" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
          <StackPanel Margin="4,12">
            <Button Classes="nav" Content="{DynamicResource Nav_Servers}" Command="{Binding NavigateCommand}" CommandParameter="Servers" />
            <Button Classes="nav" Content="{DynamicResource Nav_Dashboard}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
            <Button Classes="nav" Content="{DynamicResource Nav_Containers}" Command="{Binding NavigateCommand}" CommandParameter="Containers" />
            <Button Classes="nav" Content="{DynamicResource Nav_Deployments}" Command="{Binding NavigateCommand}" CommandParameter="Deployments" />
            <Button Classes="nav" Content="{DynamicResource Nav_Logs}" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
            <Button Classes="nav" Content="{DynamicResource Nav_Storage}" Command="{Binding NavigateCommand}" CommandParameter="Storage" />
            <Button Classes="nav" Content="{DynamicResource Nav_Files}" Command="{Binding NavigateCommand}" CommandParameter="Files" />
            <Button Classes="nav" Content="{DynamicResource Nav_Terminal}" Command="{Binding NavigateCommand}" CommandParameter="Terminal" />
            <Button Classes="nav" Content="{DynamicResource Nav_Security}" Command="{Binding NavigateCommand}" CommandParameter="Security" />
            <Border Height="1" Background="#202734" Margin="12,12" />
            <Button Classes="nav" Content="{DynamicResource Nav_Settings}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#0D1118" BorderBrush="#202734" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding LocalizedHeaderTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LocalizedHeaderSubtitle}" FontSize="11" Foreground="#8290A3" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="#1A2230" CornerRadius="14" Padding="10,5">
            <TextBlock Text="{Binding CompatibilityLabel}" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Background="#1A2230" CornerRadius="14" Padding="10,5">
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Button Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" IsVisible="{Binding IsDashboardPage}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Grid.Row="1">
      <views:DashboardView IsVisible="{Binding IsDashboardPage}" />
      <views:ServersView IsVisible="{Binding IsServersPage}" />
      <views:ContainersView IsVisible="{Binding IsContainersPage}" />

      <Grid IsVisible="{Binding IsDeploymentsPage}">
        <views:DeploymentsView DataContext="{Binding DeploymentsModule}" />
      </Grid>

      <Grid IsVisible="{Binding IsLogsPage}">
        <views:LogsView DataContext="{Binding LogsModule}" />
      </Grid>

      <Grid IsVisible="{Binding IsStoragePage}">
        <views:StorageView DataContext="{Binding StorageModule}" />
      </Grid>

      <Grid IsVisible="{Binding IsFilesPage}">
        <views:FilesView DataContext="{Binding FilesModule}" />
      </Grid>

      <Grid IsVisible="{Binding IsSecurityPage}">
        <views:SecurityView DataContext="{Binding SecurityModule}" />
      </Grid>

      <Grid IsVisible="{Binding IsPendingUtilityPage}" Margin="24">
        <Border Classes="card" HorizontalAlignment="Stretch" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding LocalizedHeaderTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Shell_PendingModule}" TextWrapping="Wrap" Foreground="#8290A3" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
