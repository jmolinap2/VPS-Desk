<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:security="using:VpsDesk.Domain.Security"
             x:Class="VpsDesk.Desktop.Views.SecurityView"
             x:DataType="vm:SecurityViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Security_Title}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Security_Subtitle}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding LastChecked}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
        <Button Content="{DynamicResource Security_RunAudit}" Command="{Binding RunAuditCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14">
      <Border Classes="surface">
        <StackPanel>
          <TextBlock Text="{DynamicResource Security_Passed}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
          <TextBlock Text="{Binding PassedCount}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="surface">
        <StackPanel>
          <TextBlock Text="{DynamicResource Security_Warnings}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
          <TextBlock Text="{Binding WarningCount}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="surface">
        <StackPanel>
          <TextBlock Text="{DynamicResource Security_Critical}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
          <TextBlock Text="{Binding CriticalCount}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="surface">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="10">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Checks}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="security:SecurityCheck">
              <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12" Margin="0,3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Severity}" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
