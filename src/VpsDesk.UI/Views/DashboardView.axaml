<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
    <conv:ConnectionToBrushConverter x:Key="ConnectionToBrush" />
    <conv:CapabilityToBrushConverter x:Key="CapabilityToBrush" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="18">
      <!-- acceso directo a despliegues, igual que en el panel del teléfono -->
      <Button Command="{Binding NavigateCommand}" CommandParameter="Deployments"
              Content="{DynamicResource Nav_Deployments}"
              HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" Foreground="White" FontWeight="SemiBold"
              Padding="20,11" CornerRadius="{DynamicResource Radius.M}" BorderThickness="0" />

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
        <Border Classes="surface" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="CPU" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="{DynamicResource Brush.Border.Strong}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsage}"
                           Foreground="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{Binding LoadSummary}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="surface" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Memory}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="{DynamicResource Brush.Border.Strong}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsage}"
                           Foreground="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{Binding MemorySummary}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="surface" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Disk}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding DiskUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="{DynamicResource Brush.Border.Strong}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiskUsage}"
                           Foreground="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{DynamicResource Dashboard_RootFilesystem}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Classes="surface" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Uptime}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionToBrush}}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Uptime}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="1" Background="{DynamicResource Brush.Border.Strong}" Margin="0,0,0,3" />
            <TextBlock Text="{DynamicResource Dashboard_Network}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            <TextBlock Text="{Binding NetworkSummary}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" Margin="0,-7,2,0">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Security_Passed}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Security_Warnings}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Security_Critical}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14" MinHeight="360">
        <Border Classes="surface">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{DynamicResource Dashboard_Performance}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Dashboard_PerformanceHelp}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
            </Grid>
            <lvc:CartesianChart Grid.Row="1" Margin="0,18,0,0" LegendPosition="Top">
              <lvc:CartesianChart.Series>
                <lvc:XamlLineSeries SeriesName="CPU" Values="{Binding CpuSeries}" Fill="{x:Null}" GeometrySize="0" />
                <lvc:XamlLineSeries SeriesName="Memory" Values="{Binding MemorySeries}" Fill="{x:Null}" GeometrySize="0" />
              </lvc:CartesianChart.Series>
            </lvc:CartesianChart>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="surface">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Dashboard_Services}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="9" Height="9"
                         Fill="{Binding DockerStatus, Converter={StaticResource CapabilityToBrush}}"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Docker" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding DockerStatus}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              </Grid>
            </Border>
            <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="9" Height="9"
                         Fill="{Binding NginxStatus, Converter={StaticResource CapabilityToBrush}}"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Nginx" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding NginxStatus}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="surface">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource Dashboard_RecentActivity}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Dashboard_RecentActivityHelp}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RecentActivity.Count, StringFormat={}{0} eventos}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
          </Grid>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="activity:OperationHistoryEntry">
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12" Margin="0,3">
                  <Grid ColumnDefinitions="Auto,1.3*,1.8*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM HH:mm}}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Environment}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Outcome}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Grid.Row="1"
                     Text="{DynamicResource Dashboard_NoRecentActivity}"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"
                     IsVisible="{Binding !HasRecentActivity}"
                     Margin="0,8,0,0" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
