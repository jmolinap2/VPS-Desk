<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             xmlns:deploy="using:VpsDesk.Application.Deployments"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.MobileDeploymentsView"
             x:DataType="vm:DeploymentsViewModel">
  <!--
    Despliegues para teléfono (docs/DESIGN_SYSTEM.md). Jerarquía de lectura, de arriba abajo:
      1. DESTINO: a qué servidor y proyecto se va a tocar, con el entorno (PROD) siempre visible.
      2. QUÉ DESPLEGAR: un toque para Completo / Backend / Frontend / Solo migraciones.
      3. PROTECCIONES: qué red de seguridad habrá (copia, snapshot, ahorro de datos); el detalle
         está en una hoja, no en la pantalla principal.
      4. Estado y ejecución en curso.
    Abajo, siempre al alcance del pulgar: Prevuelo (secundario) y Desplegar (única acción principal).
    Todos los modales (confirmar, prevuelo, postvuelo, progreso) son hojas inferiores con salida
    siempre visible: ver DeploymentModals.
  -->
  <UserControl.Resources>
    <conv:DeploymentStatusMessageConverter x:Key="DeploymentStatusMessageConverter" />
    <conv:OutcomeLabelConverter x:Key="OutcomeLabel" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- la configuración aparece con un fundido y un leve descenso desde la tarjeta de destino -->
    <Style Selector="StackPanel.reveal">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.reveal.enter">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- selector Nuevo despliegue / Historial -->
    <Border Grid.Row="0" Classes="seg-track" Margin="16,12,16,8">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
        <Button Classes="seg" Classes.active="{Binding IsNewDeploymentView}"
                Content="{DynamicResource Deployments_NewDeployment}" Command="{Binding ShowNewDeploymentCommand}" />
        <Button Grid.Column="1" Classes="seg" Classes.active="{Binding IsHistoryView}"
                Content="{DynamicResource Deployments_History}" Command="{Binding ShowHistoryCommand}" />
      </Grid>
    </Border>

    <!-- ═══════════ NUEVO DESPLIEGUE ═══════════ -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsNewDeploymentView}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,4,16,24" Spacing="12">

        <!-- 1 · Destino: toca para editar la configuración -->
        <Button Classes="row" Command="{Binding ToggleDeploymentConfigurationCommand}"
                AutomationProperties.Name="{DynamicResource Deployments_Target}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="t-overline" Text="{DynamicResource Deployments_Target}" VerticalAlignment="Center" />
                <Border Classes="status danger" IsVisible="{Binding IsProductionServer}">
                  <TextBlock Text="{Binding EnvironmentLabel}" />
                </Border>
                <Border Classes="status warning" IsVisible="{Binding IsStagingServer}">
                  <TextBlock Text="{Binding EnvironmentLabel}" />
                </Border>
              </StackPanel>
              <TextBlock Classes="t-headline" Text="{Binding ActiveServerName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="t-mono" Text="{Binding RemoteRepositoryPath}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon tertiary" Data="{StaticResource Icon.Branch}" Width="16" Height="16" />
                <TextBlock Classes="t-label" Text="{Binding Branch}" />
                <TextBlock Classes="t-label" Text="·" />
                <TextBlock Classes="t-label" Text="{Binding ComposeFile}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <!-- acción explícita: «Editar» / «Ocultar» + flecha que gira -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="t-label accent" Text="{DynamicResource Deployments_EditConfig}" VerticalAlignment="Center"
                         IsVisible="{Binding IsDeploymentConfigurationCollapsed}" />
              <TextBlock Classes="t-label accent" Text="{DynamicResource Deployments_Hide}" VerticalAlignment="Center"
                         IsVisible="{Binding IsDeploymentConfigurationExpanded}" />
              <Panel VerticalAlignment="Center">
                <Path Classes="icon accent" Data="{StaticResource Icon.ChevronDown}" IsVisible="{Binding IsDeploymentConfigurationCollapsed}" />
                <Path Classes="icon accent" Data="{StaticResource Icon.ChevronDown}" RenderTransform="rotate(180deg)"
                      IsVisible="{Binding IsDeploymentConfigurationExpanded}" />
              </Panel>
            </StackPanel>
          </Grid>
        </Button>

        <!-- configuración editable (se despliega desde la tarjeta de destino) -->
        <StackPanel x:Name="ConfigPanel" Classes="reveal" Spacing="12" IsVisible="{Binding IsDeploymentConfigurationExpanded}">
          <Border Classes="surface">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Deployments_RemoteRepository}" />
                <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding RemoteRepositoryPath}"
                         PlaceholderText="{DynamicResource Deployments_ProjectPathPlaceholder}" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="48"
                          ItemsSource="{Binding AvailableProjects}"
                          SelectedItem="{Binding SelectedProjectSuggestion}"
                          IsVisible="{Binding HasProjectSuggestions}"
                          PlaceholderText="{DynamicResource Deployments_ProjectPlaceholder}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="deploy:DeploymentProjectCandidate">
                      <TextBlock Text="{Binding RemoteRepositoryPath}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Deployments_Branch}" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="48" ItemsSource="{Binding AvailableBranches}"
                          SelectedItem="{Binding Branch}"
                          PlaceholderText="{DynamicResource Deployments_BranchPlaceholder}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Deployments_ComposeFile}" />
                <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding ComposeFile}" PlaceholderText="docker-compose.yml" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="48"
                          ItemsSource="{Binding AvailableComposeFiles}" SelectedItem="{Binding SelectedComposeSuggestion}"
                          PlaceholderText="{DynamicResource Deployments_ComposePlaceholder}" />
              </StackPanel>

              <!-- acciones secundarias: envuelven en vez de cortarse -->
              <WrapPanel>
                <Button Classes="btn-secondary" Content="{DynamicResource Deployments_Discover}"
                        Command="{Binding DiscoverRemoteOptionsCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                <Button Classes="btn-secondary" Content="{DynamicResource Deployments_PullSource}"
                        Command="{Binding PullSourceCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                <Button Classes="btn-secondary" Content="{DynamicResource Deployments_SaveProfile}"
                        Command="{Binding SaveProfileCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="surface">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_ProjectModel}" />
                  <TextBlock Classes="t-body-s" Text="{Binding ProjectModelStatus}" TextWrapping="Wrap"
                             Foreground="{Binding ProjectModelStatus, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="status success" IsVisible="{Binding HasProjectRecipe}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding ProjectRecipeFileName}" />
                </Border>
              </Grid>
              <TextBlock Classes="t-body-s" IsVisible="{Binding !HasProjectRecipe}" TextWrapping="Wrap"
                         Text="{DynamicResource Deployments_ProjectModelNoRecipe}" />
              <TextBlock Classes="t-body-s" IsVisible="{Binding HasProjectRecipe}" TextWrapping="Wrap"
                         Text="{DynamicResource Deployments_ProjectModelRecipe}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2 · Qué desplegar -->
        <Border Classes="surface">
          <StackPanel Spacing="12">
            <TextBlock Classes="t-overline" Text="{DynamicResource Deployments_WhatToRun}" />
            <ListBox Classes="chips" ItemsSource="{Binding QuickChoices}" SelectedItem="{Binding SelectedQuickChoice}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeploymentChoice">
                  <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding HasMigrationRecipe}" Spacing="10">
              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_RunMigrations}" TextWrapping="Wrap" />
                  <TextBlock Classes="t-label" Text="{DynamicResource Deployments_MigrationsHint}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding RunMigrations}"
                              IsEnabled="{Binding !MigrationOnly}"
                              AutomationProperties.Name="{DynamicResource Deployments_RunMigrations}" />
              </Grid>
              <ComboBox HorizontalAlignment="Stretch" MinHeight="48" ItemsSource="{Binding MigrationModes}"
                        SelectedItem="{Binding SelectedMigrationMode}" IsVisible="{Binding ShowMigrationOptions}"
                        PlaceholderText="{DynamicResource Deployments_MigrationScope}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="deploy:ProjectMigrationMode">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel IsVisible="{Binding RequiresMigrationInput}" Spacing="6">
                <TextBlock Classes="t-label" Text="{Binding MigrationInputLabel}" />
                <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding MigrationInput}" PlaceholderText="{Binding MigrationInputPlaceholder}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 3 · Protecciones: resumen vivo; el detalle está en la hoja de opciones -->
        <Button Classes="row" Command="{Binding OpenAdvancedOptionsCommand}"
                AutomationProperties.Name="{DynamicResource Deployments_OptionsTitle}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="8">
              <TextBlock Classes="t-overline" Text="{DynamicResource Deployments_Protections}" />
              <WrapPanel>
                <Border Classes="status" Classes.success="{Binding HasBackupProtection}" Margin="0,0,8,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon success" Data="{StaticResource Icon.Check}" Width="14" Height="14" IsVisible="{Binding HasBackupProtection}" />
                    <TextBlock Text="{DynamicResource Deployments_ProtCopy}" />
                  </StackPanel>
                </Border>
                <Border Classes="status" Classes.success="{Binding HasSnapshotProtection}" Margin="0,0,8,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon success" Data="{StaticResource Icon.Check}" Width="14" Height="14" IsVisible="{Binding HasSnapshotProtection}" />
                    <TextBlock Text="{DynamicResource Deployments_ProtSnapshot}" />
                  </StackPanel>
                </Border>
                <Border Classes="status" Classes.success="{Binding HasDataSaverProtection}" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon success" Data="{StaticResource Icon.Check}" Width="14" Height="14" IsVisible="{Binding HasDataSaverProtection}" />
                    <TextBlock Text="{DynamicResource Deployments_ProtDataSaver}" />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
            <Path Grid.Column="1" Classes="icon tertiary" Data="{StaticResource Icon.ChevronRight}" />
          </Grid>
        </Button>

        <!-- estado actual -->
        <Border CornerRadius="{DynamicResource Radius.M}" Padding="14" BorderThickness="1"
                Background="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=background}"
                BorderBrush="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=border}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1" VerticalAlignment="Top"
                    BorderBrush="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=border}">
              <TextBlock Text="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=glyph}"
                         Foreground="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}"
                         FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                       Foreground="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}" />
          </Grid>
        </Border>

        <!-- ejecución: progreso + (Salida | Pasos) en pestañas -->
        <Border Classes="surface" IsVisible="{Binding HasExecutionActivity}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_Execution}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="status success" IsVisible="{Binding IsDeploymentRunning}">
                <TextBlock Text="{DynamicResource Deployments_Live}" />
              </Border>
            </Grid>

            <TextBlock Classes="t-body" FontWeight="SemiBold" Text="{Binding DeploymentOutcomeTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="t-body-s" Text="{Binding DeploymentNextAction}" TextWrapping="Wrap" IsVisible="{Binding !IsDeploymentRunning}" />
            <Button Content="{DynamicResource Recovery_RestoreSnapshot}"
                    Command="{Binding RequestRestoreDeploymentSnapshotCommand}"
                    IsVisible="{Binding SuggestDeploymentRestore}" IsEnabled="{Binding CanRestoreDeploymentSnapshot}"
                    HorizontalAlignment="Stretch" Classes="btn-danger" />
            <StackPanel Spacing="8" IsVisible="{Binding IsDeploymentRunning}">
              <views:DeploymentJet HorizontalAlignment="Left" />
              <TextBlock Classes="t-headline" Text="{Binding DeploymentProgressText}" TextWrapping="Wrap"
                         views:DeploymentAttention.IsRunning="{Binding IsDeploymentRunning}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DeploymentProgressPercent}" Height="6" />
              <TextBlock Classes="t-label" Text="{Binding DeploymentLastActivity}" TextWrapping="Wrap" />
            </StackPanel>

            <Button Classes="btn-secondary" Content="{Binding OutputFollowLabel}" Command="{Binding ToggleOutputFollowCommand}"
                    HorizontalAlignment="Stretch" />
            <TextBlock Classes="t-label" Text="{Binding OutputFollowHint}" TextWrapping="Wrap" />

            <Border Classes="seg-track">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                <Button x:Name="OutputTabButton" Classes="seg active" Content="{DynamicResource Deployments_TabOutput}" Click="OnExecutionTabClick" Tag="output" />
                <Button x:Name="StepsTabButton" Grid.Column="1" Classes="seg" Content="{DynamicResource Deployments_TabSteps}" Click="OnExecutionTabClick" Tag="steps" />
              </Grid>
            </Border>

            <Border x:Name="OutputPanel" Background="{DynamicResource Brush.Surface.Code}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Height="320">
              <TextBox Text="{Binding DeploymentOutput}" views:TextBoxAutoScroll.IsEnabled="{Binding FollowDeploymentOutput, Mode=TwoWay}"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Code.Text}"
                       Background="Transparent" BorderThickness="0" Padding="12"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>

            <ItemsControl x:Name="StepsPanel" ItemsSource="{Binding Steps}" IsVisible="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="deploy:DeploymentStepResult">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                    <Border Classes="check-icon" Classes.passed="{Binding Succeeded}" Classes.failed="{Binding !Succeeded}">
                      <Panel>
                        <Path Classes="icon success ok" Data="{StaticResource Icon.Check}" />
                        <Path Classes="icon danger bad" Data="{StaticResource Icon.Close}" />
                      </Panel>
                    </Border>
                    <TextBlock Grid.Column="1" Classes="t-body" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="t-mono" Text="{Binding ExitCode, StringFormat=exit {0}}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════ HISTORIAL ═══════════ -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsHistoryView}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,4,16,24" Spacing="12">
        <TextBlock Classes="t-label" Text="{DynamicResource Deployments_HistoryHelp}" TextWrapping="Wrap" Margin="2,0" />

        <!-- estado vacío: dice qué pasa y ofrece la acción que lo resuelve -->
        <StackPanel IsVisible="{Binding HasNoHistory}" Spacing="12" Margin="0,40,0,0" HorizontalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.Accent.Subtle}" HorizontalAlignment="Center">
            <Path Classes="icon accent" Data="{StaticResource Icon.Rocket}" Width="28" Height="28" />
          </Border>
          <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_HistoryEmptyTitle}" HorizontalAlignment="Center" />
          <TextBlock Classes="t-body-s" Text="{DynamicResource Deployments_HistoryEmptyBody}" TextWrapping="Wrap"
                     TextAlignment="Center" MaxWidth="280" />
          <Button Classes="btn-primary" HorizontalAlignment="Center" Content="{DynamicResource Deployments_NewDeployment}"
                  Command="{Binding ShowNewDeploymentCommand}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding DeploymentHistory}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="activity:OperationHistoryEntry">
              <Border Classes="surface" Margin="0,0,0,8" Tapped="OnHistoryEntryTapped">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="t-label" Text="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="status"
                            Classes.success="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Success}}"
                            Classes.warning="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Warning}}"
                            Classes.danger="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Failed}}">
                      <TextBlock Text="{Binding Outcome, Converter={StaticResource OutcomeLabel}}" />
                    </Border>
                  </Grid>
                  <TextBlock Classes="t-body" FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Classes="t-label" Text="{Binding ServerName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════ BARRA FIJA: Prevuelo (secundario) · Desplegar (principal) ═══════════ -->
    <Border Grid.Row="2" IsVisible="{Binding IsNewDeploymentView}" Background="{DynamicResource Brush.Surface.Bar}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Spacing="10">
        <TextBlock Classes="t-label accent" Text="{Binding ExecutionSummaryLine}" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Content="{DynamicResource Deployments_PreflightShort}"
                  Command="{Binding RunPreflightCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="1" Classes="btn-primary" HorizontalAlignment="Stretch" Content="{DynamicResource Deployments_Execute}"
                  Command="{Binding StartDeploymentCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- ═══════════ DETALLE DE HISTORIAL (hoja inferior) ═══════════ -->
    <Border x:Name="HistoryScrim" Classes="m-scrim" Classes.open="{Binding IsHistorySheetOpen}" Grid.RowSpan="3"
            PointerPressed="OnHistoryScrimPressed" />
    <Border Classes="m-sheet" Classes.open="{Binding IsHistorySheetOpen}" Grid.RowSpan="3" VerticalAlignment="Bottom" MaxHeight="640">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Classes="sheet-handle" Margin="0,10,0,4" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,4,8,4">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Classes="t-title" Text="{DynamicResource Deployments_HistoryDetail}" VerticalAlignment="Center" />
            <Border Classes="status"
                    Classes.success="{Binding SelectedHistoryEntry.Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Success}}"
                    Classes.warning="{Binding SelectedHistoryEntry.Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Warning}}"
                    Classes.danger="{Binding SelectedHistoryEntry.Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Failed}}">
              <TextBlock Text="{Binding SelectedHistoryEntry.Outcome, Converter={StaticResource OutcomeLabel}}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="btn-icon" Command="{Binding CloseHistorySheetCommand}"
                  AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}">
            <Path Classes="icon" Data="{StaticResource Icon.Close}" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20,8,20,24" Spacing="14">
            <TextBlock Classes="t-body" Text="{Binding SelectedHistoryEntry.Summary}" TextWrapping="Wrap" />

            <Border Classes="surface-inset">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Server}" /><TextBlock Grid.Column="1" Classes="t-body-s" Text="{Binding SelectedHistoryEntry.ServerName}" TextWrapping="Wrap" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Environment}" /><TextBlock Grid.Column="1" Classes="t-body-s" Text="{Binding SelectedHistoryEntry.Environment}" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Repository}" /><TextBlock Grid.Column="1" Classes="t-mono" Text="{Binding SelectedHistoryEntry.RemoteRepositoryPath}" TextWrapping="Wrap" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Branch}" /><TextBlock Grid.Column="1" Classes="t-body-s" Text="{Binding SelectedHistoryEntry.Branch}" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Compose}" /><TextBlock Grid.Column="1" Classes="t-mono" Text="{Binding SelectedHistoryEntry.ComposeFile}" TextWrapping="Wrap" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_Duration}" /><TextBlock Grid.Column="1" Classes="t-body-s" Text="{Binding SelectedHistoryEntry.Duration, StringFormat={}{0:g}}" /></Grid>
                <Grid ColumnDefinitions="110,*"><TextBlock Classes="t-label" Text="{DynamicResource Deployments_FailedStep}" /><TextBlock Grid.Column="1" Classes="t-body-s danger" Text="{Binding SelectedHistoryEntry.FailedStep}" TextWrapping="Wrap" /></Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="t-overline" Text="{DynamicResource Deployments_HistoryChecks}" />
            <TextBox Text="{Binding SelectedHistoryEntry.Details}" IsReadOnly="True" AcceptsReturn="True" MinHeight="90" MaxHeight="170"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="12" />

            <TextBlock Classes="t-overline" Text="{DynamicResource Deployments_HistoryOutput}" />
            <TextBox Text="{Binding SelectedHistoryEntry.Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     MinHeight="140" MaxHeight="260" Background="{DynamicResource Brush.Surface.Code}"
                     Foreground="{DynamicResource Brush.Code.Text}"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Content="{DynamicResource Common_Close}"
                    Command="{Binding CloseHistorySheetCommand}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ═══════════ OPCIONES DEL PASE (hoja inferior) ═══════════ -->
    <Border x:Name="OptionsScrim" Classes="m-scrim" Classes.open="{Binding IsAdvancedOptionsOpen}" Grid.RowSpan="3"
            PointerPressed="OnOptionsScrimPressed" />
    <Border Classes="m-sheet" Classes.open="{Binding IsAdvancedOptionsOpen}" Grid.RowSpan="3" VerticalAlignment="Bottom" MaxHeight="680">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Classes="sheet-handle" Margin="0,10,0,4" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,4,16,8">
          <TextBlock Classes="t-title" Text="{DynamicResource Deployments_OptionsTitle}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="btn-primary" MinHeight="40" Content="{DynamicResource Deployments_Done}"
                  Command="{Binding CloseAdvancedOptionsCommand}" />
        </Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,4,16,24" Spacing="12">

            <!-- seguridad y estrategia: una fila por interruptor -->
            <Border Classes="surface">
              <StackPanel Spacing="12">
                <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_Safety}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_RequireEnv}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding RequireEnvironmentFile}"
                                AutomationProperties.Name="{DynamicResource Deployments_RequireEnv}" />
                </Grid>
                <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EnvironmentFileName}" PlaceholderText=".env" IsVisible="{Binding RequireEnvironmentFile}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_PullImages}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding PullImages}" IsEnabled="{Binding !MigrationOnly}"
                                AutomationProperties.Name="{DynamicResource Deployments_PullImages}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_BuildImages}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding BuildImages}" IsEnabled="{Binding !MigrationOnly}"
                                AutomationProperties.Name="{DynamicResource Deployments_BuildImages}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_CleanBuildCache}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding CleanBuildCache}" IsEnabled="{Binding !MigrationOnly}"
                                AutomationProperties.Name="{DynamicResource Deployments_CleanBuildCache}" />
                </Grid>

                <StackPanel Spacing="6">
                  <TextBlock Classes="t-label" Text="{DynamicResource Deployments_HealthUrls}" TextWrapping="Wrap" />
                  <TextBox Text="{Binding HttpHealthUrls}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                           IsEnabled="{Binding !MigrationOnly}" PlaceholderText="https://app.example.com/health" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ahorro de datos: se evalúa al ejecutar; en "Automático" depende de la red medida -->
            <Border Classes="surface">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_DataSaver}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="btn-icon" Command="{Binding RefreshDataSaverStatusCommand}"
                          AutomationProperties.Name="{DynamicResource Common_Refresh}" ToolTip.Tip="{DynamicResource Common_Refresh}">
                    <Path Classes="icon" Data="{StaticResource Icon.Refresh}" />
                  </Button>
                </Grid>
                <TextBlock Classes="t-body-s accent" Text="{Binding DataSaverStatus}" TextWrapping="Wrap" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="48" SelectedIndex="{Binding DataSaverModeIndex}">
                  <ComboBoxItem Content="{DynamicResource Deployments_DataSaverAuto}" />
                  <ComboBoxItem Content="{DynamicResource Deployments_DataSaverAlways}" />
                  <ComboBoxItem Content="{DynamicResource Deployments_DataSaverNever}" />
                </ComboBox>
                <TextBlock Classes="t-label" TextWrapping="Wrap" Text="{DynamicResource Deployments_DataSaverHelp}" />
              </StackPanel>
            </Border>

            <!-- punto de restauración del VPS completo -->
            <Border Classes="surface">
              <StackPanel Spacing="12">
                <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_RestorePoint}" />
                <TextBlock Classes="t-body-s" Text="{Binding SnapshotSummary}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48" IsVisible="{Binding IsSnapshotConfigured}">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_SnapshotBefore}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding SnapshotBeforeDeploy}"
                                AutomationProperties.Name="{DynamicResource Deployments_SnapshotBefore}" />
                </Grid>
                <WrapPanel>
                  <Button Classes="btn-secondary" Content="{DynamicResource Deployments_CreateSnapshot}"
                          Command="{Binding RequestCreateSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}" Margin="0,0,8,8" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Deployments_RestoreAction}"
                          Command="{Binding RequestRestoreSnapshotCommand}" IsEnabled="{Binding CanRestoreSnapshot}" Margin="0,0,8,8" />
                  <Button Classes="btn-icon" Command="{Binding RefreshSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}"
                          AutomationProperties.Name="{DynamicResource Common_Refresh}" ToolTip.Tip="{DynamicResource Common_Refresh}">
                    <Path Classes="icon" Data="{StaticResource Icon.Refresh}" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- copia descargable de la aplicación -->
            <Border Classes="surface" IsVisible="{Binding IsAppBackupConfigured}">
              <StackPanel Spacing="12">
                <TextBlock Classes="t-headline" Text="{DynamicResource Deployments_AppCopy}" />
                <TextBlock Classes="t-body-s" Text="{Binding AppBackupSummary}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="48">
                  <TextBlock Classes="t-body" Text="{DynamicResource Deployments_CopyBefore}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding BackupBeforeDeploy}"
                                AutomationProperties.Name="{DynamicResource Deployments_CopyBefore}" />
                </Grid>
                <WrapPanel>
                  <Button Classes="btn-secondary" Content="{DynamicResource Deployments_CreateCopy}"
                          Command="{Binding CreateAppBackupCommand}" IsEnabled="{Binding CanUseAppBackups}" Margin="0,0,8,8" />
                  <Button Classes="btn-icon" Command="{Binding RefreshAppBackupsCommand}"
                          AutomationProperties.Name="{DynamicResource Common_Refresh}" ToolTip.Tip="{DynamicResource Common_Refresh}">
                    <Path Classes="icon" Data="{StaticResource Icon.Refresh}" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- modales: confirmar, prevuelo, postvuelo y progreso (hojas inferiores en el teléfono) -->
    <views:DeploymentModals Grid.RowSpan="3" />
  </Grid>
</UserControl>
