<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
    <conv:ConnectionToBrushConverter x:Key="ConnectionToBrush" />
    <conv:CapabilityToBrushConverter x:Key="CapabilityToBrush" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="18">
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
        <Border Classes="card" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="CPU" Foreground="#8290A3" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"
                       Foreground="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                       FontSize="30" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="#27303D" CornerRadius="4" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsage}"
                           Foreground="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{Binding LoadSummary}" FontSize="11" Foreground="#66758A" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Memory}" Foreground="#8290A3" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F0}%}"
                       Foreground="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                       FontSize="30" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="#27303D" CornerRadius="4" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsage}"
                           Foreground="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{Binding MemorySummary}" FontSize="11" Foreground="#66758A" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Disk}" Foreground="#8290A3" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding DiskUsage, StringFormat={}{0:F0}%}"
                       Foreground="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                       FontSize="30" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="8" Background="#27303D" CornerRadius="4" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiskUsage}"
                           Foreground="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
            <TextBlock Text="{DynamicResource Dashboard_RootFilesystem}" FontSize="11" Foreground="#66758A" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Classes="card" ClipToBounds="True" MinHeight="186">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Dashboard_Uptime}" Foreground="#8290A3" />
              <Ellipse Grid.Column="1" Width="9" Height="9"
                       Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionToBrush}}"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Uptime}" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Border Height="1" Background="#27303D" Margin="0,0,0,3" />
            <TextBlock Text="{DynamicResource Dashboard_Network}" Foreground="#8290A3" FontSize="11" />
            <TextBlock Text="{Binding NetworkSummary}" FontSize="11" Foreground="#66758A" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" Margin="0,-7,2,0">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Dashboard_StatusNormal}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Dashboard_StatusElevated}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Dashboard_StatusCritical}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14" MinHeight="360">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{DynamicResource Dashboard_Performance}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Dashboard_PerformanceHelp}" FontSize="11" Foreground="#8290A3" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="#8290A3" VerticalAlignment="Center" />
            </Grid>
            <lvc:CartesianChart Grid.Row="1" Margin="0,18,0,0" LegendPosition="Top">
              <lvc:CartesianChart.Series>
                <lvc:XamlLineSeries SeriesName="CPU" Values="{Binding CpuSeries}" Fill="{x:Null}" GeometrySize="0" />
                <lvc:XamlLineSeries SeriesName="Memory" Values="{Binding MemorySeries}" Fill="{x:Null}" GeometrySize="0" />
              </lvc:CartesianChart.Series>
            </lvc:CartesianChart>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Dashboard_Services}" FontSize="16" FontWeight="SemiBold" />
            <Border Background="#0E131B" CornerRadius="8" Padding="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="9" Height="9"
                         Fill="{Binding DockerStatus, Converter={StaticResource CapabilityToBrush}}"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Docker" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding DockerStatus}" Foreground="#8290A3" />
              </Grid>
            </Border>
            <Border Background="#0E131B" CornerRadius="8" Padding="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="9" Height="9"
                         Fill="{Binding NginxStatus, Converter={StaticResource CapabilityToBrush}}"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Nginx" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding NginxStatus}" Foreground="#8290A3" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#8290A3" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource Dashboard_RecentActivity}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Dashboard_RecentActivityHelp}" Foreground="#8290A3" FontSize="11" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RecentActivity.Count, StringFormat={}{0} eventos}" Foreground="#66758A" VerticalAlignment="Center" />
          </Grid>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="activity:OperationHistoryEntry">
                <Border Background="#0E131B" CornerRadius="8" Padding="12" Margin="0,3">
                  <Grid ColumnDefinitions="Auto,1.3*,1.8*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM HH:mm}}" Foreground="#66758A" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Environment}" Foreground="#66758A" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Outcome}" FontWeight="SemiBold" Foreground="#A8B4C5" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Grid.Row="1"
                     Text="{DynamicResource Dashboard_NoRecentActivity}"
                     Foreground="#66758A"
                     IsVisible="{Binding !HasRecentActivity}"
                     Margin="0,8,0,0" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
