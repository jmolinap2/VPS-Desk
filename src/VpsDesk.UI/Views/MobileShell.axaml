<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             xmlns:services="using:VpsDesk.Desktop.Services"
             x:Class="VpsDesk.Desktop.Views.MobileShell"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Host para pantallas angostas (teléfono): barra superior con botón de
    menú + el mismo PageHost que usa el escritorio, y un cajón de
    navegación (drawer) que se superpone en vez de un sidebar fijo de
    250px. El escritorio sigue usando MainShell sin cambios.
  -->
  <Grid RowDefinitions="56,*">

    <!-- barra superior -->
    <Border Grid.Row="0" Background="#0E1219" BorderBrush="#202734" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="MenuButton" Click="OnMenuButtonClick"
                Background="Transparent" BorderThickness="0"
                Width="48" Height="48" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <TextBlock Text="&#9776;" FontSize="20" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding LocalizedHeaderTitle}"
                    FontSize="16" FontWeight="SemiBold"
                    VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,16,0" />
      </Grid>
    </Border>

    <!-- contenido -->
    <views:PageHost Grid.Row="1" />

    <!-- scrim -->
    <Border x:Name="Scrim" Grid.RowSpan="2" Background="#000000" Opacity="0.55"
            IsVisible="False" PointerPressed="OnScrimPointerPressed" />

    <!-- cajón de navegación -->
    <Border x:Name="Drawer" Grid.RowSpan="2" Width="270" HorizontalAlignment="Left"
            Background="#0E1219" BorderBrush="#202734" BorderThickness="0,0,1,0"
            IsVisible="False">
      <Grid RowDefinitions="72,60,90,*">
        <StackPanel Margin="20,18,12,12">
          <TextBlock Text="VPS Desk" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource App_Subtitle}" FontSize="11" Foreground="#8290A3" />
        </StackPanel>

        <Border Grid.Row="1" Margin="12,4" Padding="12,8" Background="#151B25" CornerRadius="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="SERVIDOR" FontSize="8" FontWeight="Bold" Foreground="#66758A" />
              <TextBlock Text="{Binding SelectedServerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ConnectionStatus}" FontSize="10" Foreground="#8290A3" />
            </StackPanel>
            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12,5" Padding="10,8" Background="#101720" BorderBrush="#202A38" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="PROYECTO ACTIVO" FontSize="8" FontWeight="Bold" Foreground="#66758A" />
              <TextBlock Grid.Column="1" Text="{Binding ActiveProjectMode}" FontSize="8" Foreground="#5EEAD4" TextTrimming="CharacterEllipsis" MaxWidth="105" />
            </Grid>
            <ComboBox ItemsSource="{Binding ProjectsModule.AssociatedProjects}"
                      SelectedItem="{Binding ProjectsModule.SelectedProject}"
                      PlaceholderText="Sin proyecto activo"
                      MinHeight="30" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="services:ProjectWorkspace">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding ActiveProjectContext}" FontSize="8" Foreground="#66758A" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3">
          <StackPanel Margin="4,10">
            <TextBlock Text="SERVIDOR" FontSize="8" FontWeight="Bold" Foreground="#56657A" Margin="14,4,0,5" />
            <Button Classes="nav" Classes.active="{Binding IsServersPage}" Content="{DynamicResource Nav_Servers}" Command="{Binding NavigateCommand}" CommandParameter="Servers" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsDashboardPage}" Content="{DynamicResource Nav_Dashboard}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsContainersPage}" Content="{DynamicResource Nav_Containers}" Command="{Binding NavigateCommand}" CommandParameter="Containers" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsLogsPage}" Content="{DynamicResource Nav_Logs}" Command="{Binding NavigateCommand}" CommandParameter="Logs" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsStoragePage}" Content="{DynamicResource Nav_Storage}" Command="{Binding NavigateCommand}" CommandParameter="Storage" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsFilesPage}" Content="{DynamicResource Nav_Files}" Command="{Binding NavigateCommand}" CommandParameter="Files" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsTerminalPage}" Content="{DynamicResource Nav_Terminal}" Command="{Binding NavigateCommand}" CommandParameter="Terminal" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsSecurityPage}" Content="{DynamicResource Nav_Security}" Command="{Binding NavigateCommand}" CommandParameter="Security" Click="OnNavItemClick" />

            <Border Height="1" Background="#202734" Margin="12,10" />
            <TextBlock Text="PROYECTO" FontSize="8" FontWeight="Bold" Foreground="#56657A" Margin="14,2,0,5" />
            <Button Classes="nav" Classes.active="{Binding IsProjectsPage}" Content="{Binding LocalizedProjectsNavigationLabel}" Command="{Binding NavigateCommand}" CommandParameter="Projects" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsDeploymentsPage}" Content="{DynamicResource Nav_Deployments}" Command="{Binding NavigateCommand}" CommandParameter="Deployments" Click="OnNavItemClick" />
            <Button Classes="nav" Classes.active="{Binding IsEnvironmentPage}" Content="{DynamicResource Nav_Environment}" Command="{Binding NavigateCommand}" CommandParameter="Environment" Click="OnNavItemClick" />

            <Border Height="1" Background="#202734" Margin="12,12" />
            <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Content="{DynamicResource Nav_Settings}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Click="OnNavItemClick" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
