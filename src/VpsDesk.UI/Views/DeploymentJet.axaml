<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VpsDesk.Desktop.ViewModels" x:DataType="vm:DeploymentsViewModel"
             x:Class="VpsDesk.Desktop.Views.DeploymentJet"
             Width="76" Height="36" IsHitTestVisible="False">
  <UserControl.Styles>
    <Style Selector="Grid.jet.running">
      <Style.Animations>
        <Animation Duration="0:0:1.8" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="translateY(2px)" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="translateY(-2px)" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="translateY(2px)" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Grid Classes="jet" Classes.running="{Binding IsDeploymentRunning}">
    <!-- Estelas y silueta vectorial: ligeras en escritorio y teléfono. -->
    <Path Data="M 4,15 L 25,15 M 9,21 L 26,21 M 16,26 L 29,26" Stroke="#5EEAD4" StrokeThickness="2" Opacity="0.6" />
    <Path Data="M 23,18 L 38,15 L 31,6 L 39,6 L 49,14 L 62,14 Q 69,14 72,18 Q 69,22 62,22 L 49,22 L 39,30 L 31,30 L 38,21 Z" Fill="#5EEAD4" />
    <Path Data="M 52,15 L 61,15 Q 64,15 66,18 L 52,18 Z" Fill="#134E4A" />
  </Grid>
</UserControl>
