<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:files="using:VpsDesk.Domain.Files"
             xmlns:views="using:VpsDesk.Desktop.Views"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileFilesView"
             x:DataType="vm:FilesViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <!--
    Explorador SFTP para teléfono. Cada elemento es una tarjeta: tocarla abre la
    carpeta o la vista previa, y el botón "Editar" abre el editor. El editor de
    texto ocupa la pantalla y se desliza desde la derecha.
  -->
  <UserControl.Styles>
    <Style Selector="Grid.full-overlay">
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(28px)" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource Motion.Standard}" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Motion.Standard}" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.full-overlay.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Margin="16,12,16,10" Spacing="12">
        <!-- ruta actual: subir · ruta · ir · actualizar (el título ya está en la barra superior) -->
        <Border Classes="surface" Padding="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
            <Button Classes="btn-icon" Command="{Binding GoParentCommand}" IsEnabled="{Binding CanGoParent}" AutomationProperties.Name="{DynamicResource Common_Up}" ToolTip.Tip="{DynamicResource Common_Up}"><Path Classes="icon" Data="{StaticResource Icon.ArrowUp}" /></Button>
            <TextBox Grid.Column="1" Text="{Binding CurrentPath}" PlaceholderText="/var/www" FontFamily="{DynamicResource Font.Mono}" MinHeight="48" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Classes="btn-primary" Content="{DynamicResource Common_Go}" Command="{Binding NavigatePathCommand}" IsEnabled="{Binding !IsBusy}" Padding="14,0" />
            <Button Grid.Column="3" Classes="btn-icon" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{DynamicResource Common_Refresh}" ToolTip.Tip="{DynamicResource Common_Refresh}"><Path Classes="icon" Data="{StaticResource Icon.Refresh}" /></Button>
          </Grid>
        </Border>

        <!-- accesos rápidos -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="{DynamicResource Ui_Home}" Command="{Binding GoHomeCommand}" />
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="/" Command="{Binding GoRootCommand}" />
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="/opt" Command="{Binding GoOptCommand}" />
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="/etc" Command="{Binding GoEtcCommand}" />
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="/var/log" Command="{Binding GoVarLogCommand}" />
            <Button Classes="btn-secondary" MinHeight="40" Padding="16,0" Content="/srv" Command="{Binding GoSrvCommand}" />
          </StackPanel>
        </ScrollViewer>

        <TextBlock Classes="t-label" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="2,0" />
      </StackPanel>

      <TextBlock DockPanel.Dock="Bottom" Classes="t-label" Margin="18,6,18,14" IsVisible="{Binding !HasNoEntries}">
        <Run Text="{Binding Entries.Count}" /><Run Text=" " /><Run Text="{DynamicResource Files_ItemsLabel}" />
      </TextBlock>

      <!-- lista de entradas: tarjetas de ancho completo -->
      <Panel Margin="16,0,16,0">
        <StackPanel IsVisible="{Binding HasNoEntries}" VerticalAlignment="Top" Spacing="10" Margin="24,32" IsHitTestVisible="False">
          <Path Classes="icon tertiary" Data="{StaticResource Icon.Folder}" Width="28" Height="28" HorizontalAlignment="Center" />
          <TextBlock Classes="t-body-s" Text="{DynamicResource Files_EmptyFolder}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox Classes="file-entries" x:Name="EntriesHost" ItemsSource="{Binding Entries}" Margin="0,0,0,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="files:RemoteFileEntry">
              <Border Classes="surface" Padding="12,12" Margin="0,0,0,8" Tapped="OnEntryTapped">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="48" Height="48" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.Surface.Inset}" VerticalAlignment="Center">
                    <Grid>
                      <Path Classes="icon" Data="{StaticResource Icon.Folder}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDirectory}"  />
                      <Path Classes="icon" Data="{StaticResource Icon.File}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsDirectory}"  />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="t-body" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                      <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" IsVisible="{Binding !IsDirectory}" />
                      <Border Classes="status warning" IsVisible="{Binding IsSensitive}">
                        <TextBlock Text="{DynamicResource Files_Sensitive}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="btn-secondary" MinHeight="40" Padding="14,0" Content="{DynamicResource Files_Edit}" IsVisible="{Binding CanEdit}"
                            Command="{Binding #EntriesHost.((vm:FilesViewModel)DataContext).EditEntryCommand}"
                            CommandParameter="{Binding}" />
                    <Path Classes="icon" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" IsVisible="{Binding !CanEdit}"  />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>

    <!-- editor de texto a pantalla completa -->
    <Grid Classes="full-overlay" Classes.open="{Binding HasOpenTextFile}" RowDefinitions="Auto,*">
      <Border Background="{DynamicResource Brush.Surface.Inset}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="10,8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Button Classes="btn-icon" Command="{Binding CloseEditorCommand}" AutomationProperties.Name="{DynamicResource Files_CloseEditor}" ToolTip.Tip="{DynamicResource Files_CloseEditor}"><Path Classes="icon" Data="{StaticResource Icon.ArrowLeft}" /></Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{DynamicResource Files_TextEditor}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EditorPath}" Classes="t-mono" FontSize="{DynamicResource Font.Size.11}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
      <views:MobileFileEditor Grid.Row="1" Margin="12" />
    </Grid>

    <!-- vista previa de imagen -->
    <Border Classes="m-scrim" PointerPressed="OnScrimPressed" Classes.open="{Binding HasImagePreview}" />
    <Border Classes="m-sheet" Classes.open="{Binding HasImagePreview}" VerticalAlignment="Bottom" Padding="20,16,20,22">
      <StackPanel Spacing="12">
        <Border Classes="sheet-handle" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding ImagePreviewName}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Classes="btn-icon" Grid.Column="1" Command="{Binding CloseImagePreviewCommand}" AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}"><Path Classes="icon" Data="{StaticResource Icon.Close}" /></Button>
        </Grid>
        <Border Classes="surface-inset" Padding="6">
          <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxHeight="360" />
        </Border>
        <TextBlock Text="{Binding ImagePreviewMeta}" Classes="t-mono" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
