<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:services="using:VpsDesk.Desktop.Services"
             x:Class="VpsDesk.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Border Classes="card" Padding="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="Proyecto activo" Foreground="#8290A3" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ActiveProjectName}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ActiveProjectPath}" Foreground="#91A0B5" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" />
          <TextBlock Text="{Binding ActiveProjectMode}" Foreground="#5EEAD4" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Usar seleccionado"
                  Command="{Binding ActivateSelectedCommand}"
                  IsEnabled="{Binding HasActiveProject}" />
          <Button Content="Detectar proyectos"
                  Command="{Binding DiscoverCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="#0F766E"
                  Foreground="White"
                  FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#0E131B" CornerRadius="8" Padding="12">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#9AA8BA" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="0.9*,1.35*" ColumnSpacing="14">
      <Border Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Proyectos asociados" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Cada proyecto conserva su ruta, rama, Compose, .env y opciones de despliegue."
                       Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding AssociatedProjects}"
                   SelectedItem="{Binding SelectedProject}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="services:ProjectWorkspace">
                <Border Background="#0E131B" CornerRadius="8" Padding="11" Margin="0,3">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="#5EEAD4" FontSize="9" />
                    </Grid>
                    <TextBlock Text="{Binding RemoteRepositoryPath}"
                               Foreground="#8290A3"
                               FontSize="10"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CapabilitySummary}" Foreground="#66758A" FontSize="9" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="Selecciona un proyecto para cambiar el contexto de Despliegues y Variables .env."
                       Foreground="#66758A" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Quitar asociación"
                    Command="{Binding RemoveSelectedCommand}"
                    IsEnabled="{Binding HasActiveProject}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Descubiertos en el VPS" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="VPS Desk busca repositorios Git con Docker Compose. .vpsdesk.yml es opcional: solo añade capacidades del proyecto."
                       Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding DiscoveredProjects}"
                   SelectedItem="{Binding SelectedDiscovery}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectDiscoveryItem">
                <Border Background="#0E131B" CornerRadius="8" Padding="12" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding RemoteRepositoryPath}"
                                 Foreground="#8290A3"
                                 FontSize="10"
                                 FontFamily="Cascadia Mono,Consolas,monospace" />
                      <TextBlock Text="{Binding CapabilitySummary}" Foreground="#66758A" FontSize="10" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Branch, StringFormat=Rama: {0}}" Foreground="#66758A" FontSize="9" />
                        <TextBlock Text="{Binding ComposeFile, StringFormat=Compose: {0}}" Foreground="#66758A" FontSize="9" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                      <Border Background="#102A24" CornerRadius="10" Padding="8,4">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="#5EEAD4" FontSize="9" />
                      </Border>
                      <TextBlock Text="ASOCIADO"
                                 IsVisible="{Binding AlreadyAssociated}"
                                 Foreground="#93C5FD"
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="Modo estándar = compatible sin archivo especial. Integración VPS Desk = el proyecto declara targets/migraciones adicionales."
                       Foreground="#66758A" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Asociar proyecto"
                    Command="{Binding AssociateSelectedCommand}"
                    IsEnabled="{Binding HasDiscoveredProjects}"
                    Background="#0F766E"
                    Foreground="White"
                    FontWeight="SemiBold" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
