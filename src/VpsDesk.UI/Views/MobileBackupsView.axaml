<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:VpsDesk.Desktop.Views"
 x:Class="VpsDesk.Desktop.Views.MobileBackupsView" Classes="mature" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
 <!-- Comparte inventario, exportación y confirmaciones con escritorio. -->
 <UserControl.Styles>
  <Style Selector="ComboBox">
   <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button">
   <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="TabItem">
   <Setter Property="MinHeight" Value="48" />
  </Style>
 </UserControl.Styles>
 <views:BackupsView />
</UserControl>
