<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileDashboardView"
             x:DataType="vm:MainWindowViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <!--
    Panel para teléfono (docs/DESIGN_SYSTEM.md). Se responde en menos de 10 segundos a «¿está
    sano el VPS?»: servidor, acceso directo a desplegar, cuatro métricas, rendimiento, servicios y
    actividad reciente. El color de cada métrica lo decide el umbral (UsageToBrush) y siempre va
    acompañado de la cifra.
  -->
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
    <conv:ConnectionToBrushConverter x:Key="ConnectionToBrush" />
    <conv:CapabilityToBrushConverter x:Key="CapabilityToBrush" />
    <conv:OutcomeLabelConverter x:Key="OutcomeLabel" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="16,12,16,28" Spacing="12">

      <TextBlock Classes="t-overline" Text="{Binding SelectedServerName}" TextTrimming="CharacterEllipsis" />

      <!-- acceso directo: desplegar es la acción más frecuente desde el panel -->
      <Button Classes="btn-primary" Command="{Binding NavigateCommand}" CommandParameter="Deployments"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{DynamicResource Nav_Deployments}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Path Grid.Column="1" Classes="icon on-accent" Data="{StaticResource Icon.ChevronRight}" />
        </Grid>
      </Button>

      <!-- métricas 2×2: nada truncado, cada tarjeta respira -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="surface" Padding="16">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="t-label" Text="CPU" />
              <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}" />
            </Grid>
            <TextBlock Classes="t-display" FontFeatures="tnum" Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,6,0,6" />
            <Border Height="6" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsage}"
                           Foreground="{Binding CpuUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=cpu}"
                           Background="Transparent" BorderThickness="0" Height="6" />
            </Border>
            <TextBlock Classes="t-label" Text="{Binding LoadSummary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="surface" Padding="14">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_Memory}" />
              <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}" />
            </Grid>
            <TextBlock Classes="t-display" FontFeatures="tnum" Text="{Binding MemoryUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,6,0,6" />
            <Border Height="6" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsage}"
                           Foreground="{Binding MemoryUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=memory}"
                           Background="Transparent" BorderThickness="0" Height="6" />
            </Border>
            <TextBlock Classes="t-label" Text="{Binding MemorySummary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="surface" Padding="14">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_Disk}" />
              <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}" />
            </Grid>
            <TextBlock Classes="t-display" FontFeatures="tnum" Text="{Binding DiskUsage, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,6,0,6" />
            <Border Height="6" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiskUsage}"
                           Foreground="{Binding DiskUsage, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                           Background="Transparent" BorderThickness="0" Height="6" />
            </Border>
            <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_RootFilesystem}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="surface" Padding="14">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_Uptime}" />
              <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionToBrush}}" />
            </Grid>
            <TextBlock Classes="t-title" Text="{Binding Uptime}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_Network}" Margin="0,8,0,0" />
            <TextBlock Classes="t-label" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding NetworkSummary}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- rendimiento -->
      <Border Classes="surface">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Dashboard_Performance}" />
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_PerformanceHelp}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="status" VerticalAlignment="Top">
              <TextBlock Text="{Binding LastChecked}" />
            </Border>
          </Grid>
          <lvc:CartesianChart Height="150" LegendPosition="Top">
            <lvc:CartesianChart.Series>
              <lvc:XamlLineSeries SeriesName="CPU" Values="{Binding CpuSeries}" Fill="{x:Null}" GeometrySize="0" />
              <lvc:XamlLineSeries SeriesName="RAM" Values="{Binding MemorySeries}" Fill="{x:Null}" GeometrySize="0" />
            </lvc:CartesianChart.Series>
          </lvc:CartesianChart>
        </StackPanel>
      </Border>

      <!-- servicios -->
      <Border Classes="surface">
        <StackPanel Spacing="12">
          <TextBlock Classes="t-headline" Text="{DynamicResource Dashboard_Services}" />
          <Border Classes="surface-inset" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding DockerStatus, Converter={StaticResource CapabilityToBrush}}" />
              <TextBlock Grid.Column="1" Classes="t-body" Text="Docker" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="t-label" Text="{Binding DockerStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
            </Grid>
          </Border>
          <Border Classes="surface-inset" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding NginxStatus, Converter={StaticResource CapabilityToBrush}}" />
              <TextBlock Grid.Column="1" Classes="t-body" Text="Nginx" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="t-label" Text="{Binding NginxStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
            </Grid>
          </Border>
          <TextBlock Classes="t-label" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- actividad reciente -->
      <Border Classes="surface">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Dashboard_RecentActivity}" />
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_RecentActivityHelp}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
              <TextBlock Classes="t-label" Text="{Binding RecentActivity.Count}" />
              <TextBlock Classes="t-label" Text="{DynamicResource Dashboard_EventsLabel}" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding RecentActivity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="activity:OperationHistoryEntry">
                <Border Classes="surface-inset" Padding="14,12" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="t-body" FontWeight="SemiBold" Text="{Binding ServerName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="status"
                              Classes.success="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Success}}"
                              Classes.warning="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Warning}}"
                              Classes.danger="{Binding Outcome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static activity:OperationOutcome.Failed}}">
                        <TextBlock Text="{Binding Outcome, Converter={StaticResource OutcomeLabel}}" />
                      </Border>
                    </Grid>
                    <TextBlock Classes="t-body-s" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Classes="t-label" Text="{Binding StartedAt, StringFormat={}{0:dd/MM HH:mm}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding !HasRecentActivity}" Spacing="8" Margin="0,8" HorizontalAlignment="Center">
            <TextBlock Classes="t-body-s" Text="{DynamicResource Dashboard_NoRecentActivity}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
