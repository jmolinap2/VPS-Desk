<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:deploy="using:VpsDesk.Application.Deployments"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             x:Class="VpsDesk.Desktop.Views.DeploymentsView"
             x:DataType="vm:DeploymentsViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Deployments_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Deployments_Subtitle}" Foreground="#8290A3" FontSize="11" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{DynamicResource Deployments_LastValidation}" Foreground="#66758A" FontSize="10" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding LastChecked}" Foreground="#8290A3" HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="{DynamicResource Deployments_NewDeployment}" Command="{Binding ShowNewDeploymentCommand}" />
      <Button Content="{DynamicResource Deployments_History}" Command="{Binding ShowHistoryCommand}" />
      <TextBlock Text="{Binding DeploymentHistory.Count, StringFormat={}{0} registros}" Foreground="#66758A" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>

    <Grid Grid.Row="2" IsVisible="{Binding IsNewDeploymentView}" RowDefinitions="Auto,*" RowSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel ToolTip.Tip="{DynamicResource Deployments_RemoteRepositoryTooltip}">
              <TextBlock Text="{DynamicResource Deployments_RemoteRepository}" Foreground="#8290A3" FontSize="11" />
              <TextBox Text="{Binding RemoteRepositoryPath}" PlaceholderText="/root/mi-app" />
              <ComboBox Margin="0,5,0,0"
                        ItemsSource="{Binding AvailableProjects}"
                        SelectedItem="{Binding SelectedProjectSuggestion}"
                        IsVisible="{Binding HasProjectSuggestions}"
                        PlaceholderText="{DynamicResource Deployments_ProjectPlaceholder}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="deploy:DeploymentProjectCandidate">
                    <TextBlock Text="{Binding RemoteRepositoryPath}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <Button Content="{DynamicResource Deployments_Discover}"
                      Command="{Binding DiscoverRemoteOptionsCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="{DynamicResource Deployments_RunPreflight}"
                      Command="{Binding RunPreflightCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="{DynamicResource Deployments_Execute}"
                      Command="{Binding StartDeploymentCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Background="#0F766E"
                      Foreground="White"
                      FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource Deployments_Branch}" Foreground="#8290A3" FontSize="11" />
              <TextBox Text="{Binding Branch}" PlaceholderText="main" />
              <ComboBox Margin="0,5,0,0"
                        ItemsSource="{Binding AvailableBranches}"
                        SelectedItem="{Binding SelectedBranchSuggestion}"
                        PlaceholderText="{DynamicResource Deployments_BranchPlaceholder}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{DynamicResource Deployments_ComposeFile}" Foreground="#8290A3" FontSize="11" />
              <TextBox Text="{Binding ComposeFile}" PlaceholderText="docker-compose.yml" />
              <ComboBox Margin="0,5,0,0"
                        ItemsSource="{Binding AvailableComposeFiles}"
                        SelectedItem="{Binding SelectedComposeSuggestion}"
                        PlaceholderText="{DynamicResource Deployments_ComposePlaceholder}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource Deployments_Safety}" FontWeight="SemiBold" Margin="0,0,0,6" />
              <CheckBox Content="{DynamicResource Deployments_RequireEnv}" IsChecked="{Binding RequireEnvironmentFile}" />
              <TextBox Text="{Binding EnvironmentFileName}" PlaceholderText=".env" Margin="22,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
              <CheckBox Content="{DynamicResource Deployments_PullImages}" IsChecked="{Binding PullImages}" />
              <CheckBox Content="{DynamicResource Deployments_BuildImages}" IsChecked="{Binding BuildImages}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="{DynamicResource Deployments_HealthUrls}" Foreground="#8290A3" FontSize="11" />
              <TextBox Text="{Binding HttpHealthUrls}"
                       AcceptsReturn="True"
                       MinHeight="62"
                       PlaceholderText="https://app.example.com/health" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource Deployments_SaveProfile}"
                    Command="{Binding SaveProfileCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Bottom" />
          </Grid>

          <Border Grid.Row="4" Background="#0E131B" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#8290A3" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="14">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <StackPanel>
              <TextBlock Text="{DynamicResource Deployments_Process}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Deployments_ProcessHelp}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="deploy:DeploymentStepResult">
                    <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding ExitCode, StringFormat=exit {0}}" Foreground="#66758A" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <StackPanel>
              <TextBlock Text="{DynamicResource Deployments_Output}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Deployments_OutputHelp}" Foreground="#66758A" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Text="{Binding DeploymentOutput}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="12"
                     Background="#080B10"
                     BorderThickness="0"
                     Padding="14"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.RowSpan="2" Background="#B0000000" IsVisible="{Binding HasPendingDeploy}">
        <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource Deployments_ConfirmTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PendingDeployMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelDeployCommand}" />
              <Button Content="{DynamicResource Deployments_Confirm}" Command="{Binding ConfirmDeployCommand}" Background="#0F766E" Foreground="White" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding IsHistoryView}" ColumnDefinitions="0.85*,1.45*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Deployments_History}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Deployments_HistoryHelp}" Foreground="#66758A" FontSize="11" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding DeploymentHistory}" SelectedItem="{Binding SelectedHistoryEntry}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="activity:OperationHistoryEntry">
                <Border Background="#0E131B" CornerRadius="8" Padding="11" Margin="0,3">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Foreground="#8290A3" />
                      <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ServerName}" Foreground="#66758A" FontSize="10" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Deployments_HistoryDetail}" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Servidor" Foreground="#66758A" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedHistoryEntry.ServerName}" />
              <TextBlock Grid.Row="1" Text="Entorno" Foreground="#66758A" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Environment}" />
              <TextBlock Grid.Row="2" Text="Repositorio" Foreground="#66758A" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHistoryEntry.RemoteRepositoryPath}" />
              <TextBlock Grid.Row="3" Text="Rama" Foreground="#66758A" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Branch}" />
              <TextBlock Grid.Row="4" Text="Compose" Foreground="#66758A" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedHistoryEntry.ComposeFile}" />
              <TextBlock Grid.Row="5" Text="Resultado" Foreground="#66758A" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Outcome}" />
              <TextBlock Grid.Row="6" Text="Duración" Foreground="#66758A" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Duration, StringFormat={}{0:g}}" />
              <TextBlock Grid.Row="7" Text="Paso fallido" Foreground="#66758A" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedHistoryEntry.FailedStep}" />
            </Grid>
            <TextBlock Text="{DynamicResource Deployments_HistoryChecks}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox Text="{Binding SelectedHistoryEntry.Details}" IsReadOnly="True" AcceptsReturn="True" MinHeight="110" FontFamily="Cascadia Mono,Consolas,monospace" />
            <TextBlock Text="{DynamicResource Deployments_HistoryOutput}" FontWeight="SemiBold" />
            <TextBox Text="{Binding SelectedHistoryEntry.Output}" IsReadOnly="True" AcceptsReturn="True" MinHeight="260" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" Background="#080B10" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsPreflightModalOpen}">
      <Border Classes="card" Width="720" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="42" Height="42" CornerRadius="21" Background="#102A24" BorderBrush="#0F766E" BorderThickness="1">
              <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#5EEAD4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Deployments_PreflightModalTitle}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PreflightModalMessage}" Foreground="#A8B4C5" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#0E131B" CornerRadius="8" Padding="10">
            <TextBlock Text="SSH · Git · Docker · Compose · rama · archivos · entorno" Foreground="#8290A3" FontSize="11" TextAlignment="Center" />
          </Border>

          <ListBox Grid.Row="2" ItemsSource="{Binding Checks}" MinHeight="120" MaxHeight="360">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="deploy:PreflightCheckResult">
                <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#172033" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="10" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="3" Content="{DynamicResource Common_Close}" Command="{Binding ClosePreflightModalCommand}" HorizontalAlignment="Right" IsEnabled="{Binding !IsBusy}" />
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsPostflightModalOpen}">
      <Border Classes="card" Width="760" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Width="48" Height="48" CornerRadius="24" Background="#102A24" BorderBrush="#0F766E" BorderThickness="1">
              <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#5EEAD4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{DynamicResource Deployments_PostflightModalTitle}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PostflightModalMessage}" Foreground="#A8B4C5" TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Background="#102A24" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="OK" Foreground="#5EEAD4" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PostflightPassedCount}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#2A2410" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="WARN" Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PostflightWarningCount}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#2A1215" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="FAIL" Foreground="#F87171" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PostflightFailedCount}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="2" Text="{DynamicResource Deployments_PostDeployHelp}" Foreground="#66758A" FontSize="10" />

          <ListBox Grid.Row="3" ItemsSource="{Binding PostChecks}" MinHeight="120" MaxHeight="360">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="deploy:PostDeployCheckResult">
                <Border Background="#0E131B" CornerRadius="8" Padding="11" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#172033" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="10" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <TextBlock Text="El postvuelo queda abierto para revisión manual antes de continuar." Foreground="#66758A" FontSize="10" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource Common_Close}" Command="{Binding ClosePostflightModalCommand}" IsEnabled="{Binding !IsBusy}" Padding="18,8" />
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
