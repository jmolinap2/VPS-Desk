<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             x:Class="VpsDesk.Desktop.Views.PageHost"
             x:DataType="vm:MainWindowViewModel">
  <!--
    El conmutador de páginas, compartido por todos los hosts de plataforma
    (MainShell en escritorio, MobileShell en Android/iOS). Vive solo
    desacoplado del sidebar/top bar para que cada plataforma lo envuelva como
    le convenga.
  -->
  <Grid>
    <views:DashboardView IsVisible="{Binding IsDashboardPage}" />
    <views:ServersView IsVisible="{Binding IsServersPage}" />
    <views:ContainersView IsVisible="{Binding IsContainersPage}" />

    <Grid IsVisible="{Binding IsProjectsPage}">
      <views:ProjectsView DataContext="{Binding ProjectsModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsDeploymentsPage}">
      <views:DeploymentsView DataContext="{Binding DeploymentsModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsEnvironmentPage}">
      <views:EnvironmentView DataContext="{Binding FilesModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsLogsPage}">
      <views:LogsView DataContext="{Binding LogsModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsStoragePage}">
      <views:StorageView DataContext="{Binding StorageModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsFilesPage}">
      <views:FilesView DataContext="{Binding FilesModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsTerminalPage}">
      <views:TerminalView DataContext="{Binding TerminalModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsSecurityPage}">
      <views:SecurityView DataContext="{Binding SecurityModule}" />
    </Grid>

    <Grid IsVisible="{Binding IsSettingsPage}">
      <views:SettingsView DataContext="{Binding SettingsModule}" />
    </Grid>
  </Grid>
</UserControl>
