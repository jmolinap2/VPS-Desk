<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:backup="using:VpsDesk.Application.AppBackups"
             xmlns:snapshot="using:VpsDesk.Application.Snapshots"
             xmlns:views="using:VpsDesk.Desktop.Views"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.BackupsView"
             x:DataType="vm:DeploymentsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <UserControl.Resources>
    <conv:BackupSizeConverter x:Key="BackupSize" />
    <conv:BackupDateConverter x:Key="BackupDate" />
    <conv:BackupContentLabelConverter x:Key="BackupContentLabel" />
  </UserControl.Resources>
  

  <Grid>
    <TabControl Margin="8,4,8,0">
      <!-- ───────────── Servidor (producción) ───────────── -->
      <TabItem Header="{DynamicResource Backups_TabServer}">
        <ScrollViewer>
          <StackPanel Margin="8,12,8,16" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Estado de un vistazo -->
            <StackPanel Spacing="10">
              <Border Classes="surface-inset">
                <StackPanel Spacing="2">
                  <TextBlock Classes="t-label" Text="{DynamicResource Backups_SummaryLastBackup}" />
                  <TextBlock Classes="t-headline" Text="{Binding LastBackupText}" />
                  <TextBlock Classes="t-body-s" Text="{Binding LastBackupWhere}" />
                </StackPanel>
              </Border>
              <Border Classes="surface-inset">
                <StackPanel Spacing="2">
                  <TextBlock Classes="t-label" Text="{DynamicResource Backups_SummarySnapshot}" />
                  <TextBlock Classes="t-headline" Text="{Binding LastSnapshotText}" IsVisible="{Binding HasSnapshot}" />
                  <TextBlock Classes="t-headline" Text="{DynamicResource Backups_SnapshotNone}" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding !HasSnapshot}" />
                </StackPanel>
              </Border>
              <Border Classes="surface-inset">
                <StackPanel Spacing="2">
                  <TextBlock Classes="t-label" Text="{DynamicResource Backups_SummaryPostgres}" />
                  <TextBlock Classes="t-headline" Text="{Binding PostgresStatus}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Crear copia -->
            <Border Classes="surface">
              <StackPanel Spacing="12" IsEnabled="{Binding CanUseAppBackups}">
                <TextBlock Text="{DynamicResource Backups_CreateTitle}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                  <TextBlock Classes="t-label" Text="{DynamicResource Backups_ContentLabel}" />
                  <ComboBox SelectedIndex="{Binding AppBackupContentIndex}" HorizontalAlignment="Stretch" MaxWidth="420">
                    <ComboBoxItem Content="{DynamicResource Backups_KindFull}" />
                    <ComboBoxItem Content="{DynamicResource Backups_KindDatabase}" />
                    <ComboBoxItem Content="{DynamicResource Backups_KindFiles}" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding CreateTargetsDatabase}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="t-label" Text="{DynamicResource Backups_ContainerLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="420" HorizontalAlignment="Stretch">
                      <ComboBox ItemsSource="{Binding PostgresContainers}" SelectedItem="{Binding SelectedPostgresContainer}"
                                PlaceholderText="{DynamicResource Backups_PostgresAuto}" HorizontalAlignment="Stretch" />
                      <Button Classes="btn-icon" Grid.Column="1" Command="{Binding RefreshPostgresCommand}"
                              ToolTip.Tip="{DynamicResource Backups_RefreshPostgres}" AutomationProperties.Name="{DynamicResource Common_Refresh}"><Path Classes="icon" Data="{StaticResource Icon.Refresh}" /></Button>
                    </Grid>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="t-label" Text="{DynamicResource Backups_DatabaseLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="420" HorizontalAlignment="Left">
                      <ComboBox ItemsSource="{Binding PostgresDatabases}" SelectedItem="{Binding SelectedBackupDatabase}"
                                PlaceholderText="{DynamicResource Backups_AllDatabases}" HorizontalAlignment="Stretch" />
                      <Button Classes="btn-icon" Grid.Column="1" Command="{Binding ClearBackupDatabaseCommand}"
                              IsEnabled="{Binding SelectedBackupDatabase, Converter={x:Static ObjectConverters.IsNotNull}}"
                              ToolTip.Tip="{DynamicResource Backups_AllDatabases}" AutomationProperties.Name="{DynamicResource Common_Close}"><Path Classes="icon" Data="{StaticResource Icon.Close}" /></Button>
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <WrapPanel>
                  <Button Classes="btn-primary" Content="{DynamicResource Backups_Create}" Command="{Binding CreateAppBackupCommand}" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshBackupInventoryCommand}" Margin="0,0,8,6" />
                </WrapPanel>

                <Expander Header="{DynamicResource Backups_Settings}">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="t-label" Text="{DynamicResource Deployments_RemoteRepository}" />
                      <TextBox Text="{Binding RemoteRepositoryPath}" PlaceholderText="/root/mi-app" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="t-label" Text="{DynamicResource Backups_Retention}" />
                      <NumericUpDown Value="{Binding AppBackupKeepCopies}" Minimum="1" Maximum="10" Increment="1" FormatString="0" Width="130" HorizontalAlignment="Left" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding StoreAppBackupOnServer}" HorizontalAlignment="Stretch">
                      <TextBlock Text="{DynamicResource Backups_StoreOnServer}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding BackupBeforeDeploy}" HorizontalAlignment="Stretch">
                      <TextBlock Text="{DynamicResource Backups_BeforeDeploy}" TextWrapping="Wrap" />
                    </CheckBox>
                    <StackPanel Spacing="4">
                      <ComboBox SelectedIndex="{Binding DataSaverModeIndex}" HorizontalAlignment="Left" MinWidth="220">
                        <ComboBoxItem Content="{DynamicResource Backups_DataAuto}" />
                        <ComboBoxItem Content="{DynamicResource Backups_DataAlways}" />
                        <ComboBoxItem Content="{DynamicResource Backups_DataNever}" />
                      </ComboBox>
                      <TextBlock Classes="t-body-s" Text="{Binding DataSaverStatus}" />
                      <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_DataSaverHelp}" />
                    </StackPanel>
                    <Button Classes="btn-secondary" Content="{DynamicResource Backups_SavePreferences}" Command="{Binding SaveBackupPreferencesCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <!-- Copias disponibles -->
            <Border Classes="surface">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Backups_Inventory}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                <TextBlock Classes="t-body-s" Text="{Binding BackupInventoryStatus}" />

                <Border Classes="surface-inset" Margin="0" IsVisible="{Binding !HasAppBackupInventory}">
                  <StackPanel Spacing="8">
                    <Path Classes="icon tertiary" Data="{StaticResource Icon.Folder}" />
                    <TextBlock Classes="t-headline" Text="{DynamicResource Backups_EmptyTitle}" FontWeight="SemiBold" />
                    <TextBlock Classes="t-body-s" TextWrapping="Wrap" Text="{DynamicResource Backups_Empty}" />
                  </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding AppBackupInventory}" SelectedItem="{Binding SelectedAppBackup}"
                         MaxHeight="380" IsVisible="{Binding HasAppBackupInventory}" IsEnabled="{Binding CanUseAppBackups}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="backup:AppBackupInfo">
                      <StackPanel Spacing="4" Margin="4,8" ToolTip.Tip="{Binding FullPath}">
                        <WrapPanel>
                          <Border Classes="status">
                            <TextBlock Text="{Binding Content, Converter={StaticResource BackupContentLabel}}" FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Primary}" />
                          </Border>
                          <TextBlock Text="{Binding CreatedAt, Converter={StaticResource BackupDate}}" FontWeight="SemiBold" Margin="0,0,12,0" />
                          <TextBlock Text="{Binding SizeBytes, Converter={StaticResource BackupSize}}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,12,0" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Backups_Remote}" IsVisible="{Binding StoredOnServer}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.12}" />
                        <TextBlock Text="{DynamicResource Backups_Local}" IsVisible="{Binding !StoredOnServer}" Foreground="{DynamicResource Brush.Info}" FontSize="{DynamicResource Font.Size.12}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel IsVisible="{Binding HasAppBackupInventory}">
                  <Button Content="{DynamicResource Backups_RestoreDb}" Command="{Binding RequestRestoreDatabaseCommand}"
                          IsEnabled="{Binding CanRestoreDatabase}" Classes="btn-secondary" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Backups_Download}" Command="{Binding DownloadSelectedBackupCommand}" IsEnabled="{Binding CanDownloadSelectedBackup}" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Backups_Export}" Click="ExportBackup_Click" IsEnabled="{Binding CanExportSelectedBackup}" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Backups_Verify}" Command="{Binding VerifySelectedBackupCommand}" IsEnabled="{Binding CanManageSelectedBackup}" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Common_Delete}" Command="{Binding RequestDeleteBackupCommand}" IsEnabled="{Binding CanManageSelectedBackup}" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_RecoveryHelp}" IsVisible="{Binding HasAppBackupInventory}" />
              </StackPanel>
            </Border>

            <!-- Snapshot del VPS completo -->
            <Border Classes="surface">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Backups_Snapshot}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_SnapshotHelp}" />
                <TextBlock Text="{Binding SnapshotSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" />
                <CheckBox IsChecked="{Binding SnapshotBeforeDeploy}" IsEnabled="{Binding CanUseSnapshots}" HorizontalAlignment="Stretch">
                  <TextBlock Text="{DynamicResource Backups_SnapshotBeforeDeploy}" TextWrapping="Wrap" />
                </CheckBox>
                <WrapPanel>
                  <Button Content="{DynamicResource Backups_CreateSnapshot}" Command="{Binding RequestCreateSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}" Classes="btn-secondary" Margin="0,0,8,6" />
                  <Button Classes="btn-secondary" Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}" Margin="0,0,8,6" />
                </WrapPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasProviderBackups}">
                  <TextBlock Text="{DynamicResource Backups_Provider}" FontWeight="SemiBold" />
                  <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_ProviderHelp}" />
                  <ItemsControl ItemsSource="{Binding ProviderBackups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="snapshot:VpsBackupInfo">
                        <WrapPanel Margin="0,3">
                          <TextBlock Text="{Binding CreatedAt, Converter={StaticResource BackupDate}}" Margin="0,0,16,0" />
                          <TextBlock Text="{Binding SizeKilobytes, Converter={StaticResource BackupSize}, ConverterParameter=kb}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </WrapPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Expander Header="{DynamicResource Backups_DangerZone}" Foreground="{DynamicResource Brush.Danger}">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_DangerHelp}" />
                    <Button Classes="btn-secondary" Content="{DynamicResource Backups_RestoreSnapshot}" Command="{Binding RequestRestoreSnapshotCommand}"
                            IsEnabled="{Binding CanRestoreSnapshot}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ───────────── Este dispositivo (la herramienta VPS Desk) ───────────── -->
      <TabItem Header="{DynamicResource Backups_TabDevice}">
        <ScrollViewer>
          <StackPanel Margin="8,12,8,16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <views:LocalBackupsView DataContext="{Binding LocalBackupSettings}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Eliminar una copia -->
    <Border Classes="modal-scrim" Classes.open="{Binding HasPendingBackupDeletion}" PointerPressed="OnModalScrimPressed">
      <Border Classes="modal-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="t-title" Text="{DynamicResource Backups_DeleteTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="btn-icon" Command="{Binding CancelBackupDeletionCommand}"
                    AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}">
              <Path Classes="icon" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Classes="t-body" Text="{Binding BackupDeletionMessage}" TextWrapping="Wrap" />
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Content="{DynamicResource Common_Cancel}"
                    Command="{Binding CancelBackupDeletionCommand}" />
            <Button Grid.Column="1" Classes="btn-danger" HorizontalAlignment="Stretch" Content="{DynamicResource Common_Delete}"
                    Command="{Binding ConfirmDeleteBackupCommand}" IsEnabled="{Binding CanUseAppBackups}" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- Restaurar una base de datos (acción de nivel 3: frase escrita + copia previa) -->
    <Border Classes="modal-scrim" Classes.open="{Binding HasPendingDatabaseRestore}" PointerPressed="OnModalScrimPressed">
      <Border Classes="modal-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="t-title" Text="{DynamicResource Backups_RestoreDbTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="btn-icon" Command="{Binding CancelDatabaseRestoreCommand}"
                    AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}">
              <Path Classes="icon" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <TextBlock Classes="t-body" Text="{Binding DatabaseRestoreMessage}" TextWrapping="Wrap" />
              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Backups_RestoreDbWhich}" />
                <ComboBox ItemsSource="{Binding RestoreDatabases}" SelectedItem="{Binding SelectedRestoreDatabase}"
                          PlaceholderText="{DynamicResource Backups_AllDatabases}" HorizontalAlignment="Stretch" MinHeight="48" />
              </StackPanel>
              <CheckBox IsChecked="{Binding BackupDatabaseBeforeRestore}" HorizontalAlignment="Stretch">
                <TextBlock Classes="t-body-s" Text="{DynamicResource Backups_RestoreDbSafety}" TextWrapping="Wrap" />
              </CheckBox>
              <StackPanel Spacing="6">
                <TextBlock Classes="t-label danger" Text="{DynamicResource Backups_TypeToConfirm}" TextWrapping="Wrap" />
                <TextBox Text="{Binding DatabaseRestoreConfirmation}" PlaceholderText="RESTAURAR" MinHeight="48" VerticalContentAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Classes="btn-secondary" MinWidth="110" Content="{DynamicResource Common_Cancel}"
                    Command="{Binding CancelDatabaseRestoreCommand}" />
            <Button Grid.Column="1" Classes="btn-danger" HorizontalAlignment="Stretch" Content="{DynamicResource Backups_RestoreDb}"
                    Command="{Binding ConfirmDatabaseRestoreCommand}" IsEnabled="{Binding CanConfirmDatabaseRestore}" />
          </Grid>
        </Grid>
      </Border>
    </Border>
    <views:DeploymentModals />
  </Grid>
</UserControl>
