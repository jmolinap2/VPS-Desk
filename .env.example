# Configuración local de VPS Desk
# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Nunca subas .env con credenciales reales.

SERVER_NAME=Mi VPS
SERVER_PROVIDER=Hostinger
SERVER_HOST=example.com
SERVER_USER=root
SSH_PORT=22
SSH_KEY_PATH=C:\Users\YOUR_USER\.ssh\id_ed25519

# Opcional pero recomendado: fija la identidad SSH del servidor.
# Acepta el valor SHA256 mostrado por OpenSSH, con o sin el prefijo SHA256:.
SSH_HOST_FINGERPRINT=

# Proyecto local que contiene tus scripts de deploy o migración.
REPO_LOCAL=C:\Repos\your-app

# Ubicación remota del proyecto dentro del VPS.
REMOTE_REPO_PATH=/home/your-user/your-app
COMPOSE_FILE=docker-compose.yml

# Opcional. Déjalo vacío salvo que tu flujo de deploy lo necesite.
GIT_TOKEN=

# Opcional. Prefiere llaves SSH cuando sea posible.
SSH_PASSWORD=

# Opcional. Snapshots del VPS completo (solo Hostinger). Crea el token en
# hPanel > Cuenta > API. VPS Desk localiza el VPS por la IP de SERVER_HOST;
# define HOSTINGER_VM_ID solo si usas un nombre de host en vez de la IP.
# Hostinger guarda UN snapshot por VPS, caduca a los 1 día y no es descargable:
# crear uno nuevo sobrescribe el anterior. Los backups automáticos de Hostinger
# (hasta 4) solo se consultan aquí; se restauran desde hPanel.
#
# Para conservar varias copias descargables, VPS Desk ofrece "Copia de la
# aplicación" (PostgreSQL + proyecto + configuración) y guarda las últimas N en
# Documentos\VPS Desk\Backups\<servidor>. Cambia la carpeta con VPSDESK_BACKUP_DIR.
HOSTINGER_API_TOKEN=
HOSTINGER_VM_ID=
