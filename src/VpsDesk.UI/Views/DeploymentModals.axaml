<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:deploy="using:VpsDesk.Application.Deployments"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.DeploymentModals"
             x:DataType="vm:DeploymentsViewModel">
  <!--
    Capa de modales de despliegue (confirmar, prevuelo, postvuelo, ejecución),
    compartida por DeploymentsView (escritorio) y MobileDeploymentsView
    (teléfono). Cada tarjeta usa MaxWidth + Margin, así que se adapta al ancho
    disponible en vez de salirse de la pantalla.
  -->
  <UserControl.Resources>
    <conv:DeploymentStatusMessageConverter x:Key="DeploymentStatusMessageConverter" />
    <conv:PreflightStatusConverter x:Key="PreflightStatusConverter" />
    <conv:PostflightStatusConverter x:Key="PostflightStatusConverter" />
  </UserControl.Resources>

  <Grid>
  <Border Background="#B0000000" IsVisible="{Binding HasPendingDeploy}">
    <Border Classes="card" MaxWidth="620" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="{DynamicResource Deployments_ConfirmTitle}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PendingDeployMessage}" TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelDeployCommand}" />
          <Button Content="{DynamicResource Deployments_Confirm}"
                  Command="{Binding ConfirmDeployCommand}"
                  Background="#0F766E"
                  Foreground="White" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#B0000000" IsVisible="{Binding HasPendingSnapshotAction}">
    <Border Classes="card" MaxWidth="620" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding PendingSnapshotTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding PendingSnapshotMessage}" TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSnapshotActionCommand}" Margin="0,0,8,0" />
          <Button Content="{Binding PendingSnapshotConfirmLabel}" Command="{Binding ConfirmSnapshotActionCommand}"
                  Background="#0F766E" Foreground="White" FontWeight="SemiBold" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#B0000000" IsVisible="{Binding IsPreflightModalOpen}">
    <Border Classes="card" MaxWidth="720" MaxHeight="650" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
            PointerEntered="OnPreflightPointerEntered"
            PointerExited="OnPreflightPointerExited"
            PointerPressed="OnPreflightPointerPressed">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="42" Height="42" CornerRadius="21"
                  Background="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=background}"
                  BorderBrush="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=border}"
                  BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=glyph}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Deployments_PreflightModalTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PreflightModalMessage}" Foreground="#A8B4C5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0E131B" CornerRadius="8" Padding="10">
          <TextBlock Text="SSH · Git · Docker · Compose · objetivo · migraciones · entorno"
                     Foreground="#8290A3"
                     FontSize="11"
                     TextAlignment="Center" />
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Checks}" MinHeight="120" MaxHeight="360">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="deploy:PreflightCheckResult">
              <Border Background="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=background}"
                      BorderBrush="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=border}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10"
                      Margin="0,3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="24" Height="24" CornerRadius="12"
                          BorderBrush="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=border}"
                          BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=glyph}"
                               Foreground="{Binding Status, Converter={StaticResource PreflightStatusConverter}}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8290A3" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Background="#101722"
                          BorderBrush="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=border}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="9,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Converter={StaticResource PreflightStatusConverter}, ConverterParameter=label}"
                               Foreground="{Binding Status, Converter={StaticResource PreflightStatusConverter}}"
                               FontWeight="SemiBold"
                               FontSize="10" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding PreflightCountdownText}"
                     IsVisible="{Binding HasPreflightCountdown}"
                     Foreground="#66758A"
                     FontSize="11"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{DynamicResource Common_Accept}"
                  Command="{Binding ClosePreflightModalCommand}"
                  IsVisible="{Binding HasPreflightCountdown}"
                  Background="#0F766E"
                  Foreground="White"
                  FontWeight="SemiBold"
                  Padding="20,8" />
          <Button Grid.Column="1"
                  Content="{DynamicResource Common_Close}"
                  Command="{Binding ClosePreflightModalCommand}"
                  IsVisible="{Binding !HasPreflightCountdown}"
                  HorizontalAlignment="Right"
                  IsEnabled="{Binding !IsBusy}" />
        </Grid>
      </Grid>
    </Border>
  </Border>

  <Border Background="#B0000000" IsVisible="{Binding IsPostflightModalOpen}">
    <Border Classes="card" MaxWidth="760" MaxHeight="680" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Width="48" Height="48" CornerRadius="24" Background="#102A24" BorderBrush="#0F766E" BorderThickness="1">
            <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#5EEAD4" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{DynamicResource Deployments_PostflightModalTitle}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PostflightModalMessage}" Foreground="#A8B4C5" TextWrapping="Wrap" MaxWidth="620" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Border Background="#102A24" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="OK" Foreground="#5EEAD4" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PostflightPassedCount}" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#2A2410" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="WARN" Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PostflightWarningCount}" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#2A1215" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="FAIL" Foreground="#F87171" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PostflightFailedCount}" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{DynamicResource Deployments_PostDeployHelp}" Foreground="#66758A" FontSize="10" />

        <ListBox Grid.Row="3" ItemsSource="{Binding PostChecks}" MinHeight="120" MaxHeight="360">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="deploy:PostDeployCheckResult">
              <Border Background="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=background}"
                      BorderBrush="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=border}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="11"
                      Margin="0,3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="24" Height="24" CornerRadius="12"
                          BorderBrush="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=border}"
                          BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=glyph}"
                               Foreground="{Binding Status, Converter={StaticResource PostflightStatusConverter}}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8290A3" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Background="#101722"
                          BorderBrush="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=border}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="9,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Converter={StaticResource PostflightStatusConverter}, ConverterParameter=label}"
                               Foreground="{Binding Status, Converter={StaticResource PostflightStatusConverter}}"
                               FontWeight="SemiBold"
                               FontSize="10" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
          <TextBlock Text="El postvuelo queda abierto para revisión manual antes de continuar."
                     Foreground="#66758A"
                     FontSize="10"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{DynamicResource Common_Close}"
                  Command="{Binding ClosePostflightModalCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Padding="18,8" />
        </Grid>
      </Grid>
    </Border>
  </Border>

  <Border Background="#B0000000" IsVisible="{Binding IsOperationFeedbackModalOpen}">
    <Border Classes="card" MaxWidth="650" MaxHeight="690" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Width="56" Height="56" CornerRadius="16" Background="#102A24" BorderBrush="#0F766E" BorderThickness="1">
            <Grid>
              <Grid IsVisible="{Binding IsOperationFeedbackRunning}">
                <Ellipse Width="9" Height="9" Fill="#5EEAD4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Ellipse Width="6" Height="6" Fill="#14B8A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Width="9" Height="9" Fill="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
              </Grid>
              <TextBlock Text="✓" FontSize="27" FontWeight="Bold" Foreground="#5EEAD4"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding OperationFeedbackSucceeded}" />
              <TextBlock Text="!" FontSize="25" FontWeight="Bold" Foreground="#F87171"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding IsOperationFeedbackFailed}" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding OperationFeedbackTitle}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OperationFeedbackMessage}" Foreground="#A8B4C5" TextWrapping="Wrap" MaxWidth="540" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0E1B20" BorderBrush="#245F54" BorderThickness="1" CornerRadius="9" Padding="11"
                IsVisible="{Binding IsOperationFeedbackRunning}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
            <ProgressBar Width="74" Height="6" IsIndeterminate="True" Foreground="#14B8A6" Background="#173B36" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Conexión activa · la operación sigue en curso" Foreground="#8DE7CE" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Button Grid.Row="2"
                Content="{DynamicResource Deployments_OperationToggleTerminal}"
                Command="{Binding ToggleOperationFeedbackOutputCommand}"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="#314158"
                Foreground="#A8B4C5" />

        <Border Grid.Row="3" Background="#05080C" BorderBrush="#245F54" BorderThickness="1" CornerRadius="8"
                MinHeight="130" MaxHeight="330" IsVisible="{Binding IsOperationFeedbackOutputExpanded}">
          <TextBox Text="{Binding OperationFeedbackOutput}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="14"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <Button Grid.Row="4"
                Content="{DynamicResource Common_Accept}"
                Command="{Binding CloseOperationFeedbackModalCommand}"
                IsEnabled="{Binding !IsOperationFeedbackRunning}"
                HorizontalAlignment="Right"
                Padding="20,8"
                Background="#0F766E"
                Foreground="White" />
        <Button Grid.Row="4"
                Content="{DynamicResource Common_Cancel}"
                Command="{Binding CancelAppBackupOperationCommand}"
                IsVisible="{Binding IsAppBackupBusy}"
                HorizontalAlignment="Left" />
      </Grid>
    </Border>
  </Border>
  </Grid>
</UserControl>
