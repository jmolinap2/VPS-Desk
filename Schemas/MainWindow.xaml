<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VPS Desk"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        SnapsToDevicePixels="True"
        Background="#202020"
        Foreground="#F4F4F4">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="5"
                            CaptionHeight="32"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── Brushes ── -->
        <SolidColorBrush x:Key="BgBrush"       Color="#202020"/>
        <SolidColorBrush x:Key="SidebarBrush"  Color="#181818"/>
        <SolidColorBrush x:Key="HeaderBrush"   Color="#1C1C1C"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#2A2A2A"/>
        <SolidColorBrush x:Key="CardAltBrush"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderBrush"    Color="#404040"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#F4F4F4"/>
        <SolidColorBrush x:Key="MutedBrush"     Color="#A0A0A0"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#0078D4"/>
        <SolidColorBrush x:Key="SuccessBrush"   Color="#4ED68A"/>
        <SolidColorBrush x:Key="WarnBrush"      Color="#FFD166"/>
        <SolidColorBrush x:Key="DangerBrush"    Color="#FF8181"/>

        <!-- ── Card border ── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
        </Style>

        <!-- ── Typography ── -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageSubTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <!-- ── Inputs ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource CardAltBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="9,7"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background"      Value="{StaticResource CardAltBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="9,7"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#333333"/>
            <Setter Property="Foreground"      Value="#F4F4F4"/>
            <Setter Property="BorderBrush"     Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#A0A0A0"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Transparent overlay toggle to open/close -->
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom">
                                <Border Background="#2A2A2A"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd"    Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="Arrow" Property="Data"        Value="M 0 4 L 4 0 L 8 4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"          Property="Background"              Value="#252525"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground"    Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,3,0,7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="MinHeight"       Value="36"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background"      Value="{StaticResource CardAltBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#7A2020"/>
        </Style>

        <!-- ── Sidebar nav button ── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="12,11"/>
            <Setter Property="Margin"                     Value="0,1"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="FontSize"                   Value="13"/>
        </Style>

        <!-- ── Title bar buttons (Segoe Fluent Icons) ── -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontFamily"      Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#F4F4F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground"            Value="#252525"/>
            <Setter Property="AlternatingRowBackground" Value="#2E2E2E"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="AutoGenerateColumns"      Value="True"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="12"/>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         OUTER BORDER — gives the rounded window edge
    ══════════════════════════════════════════════════════════════════ -->
    <Border x:Name="MainBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border Grid.Row="0"
                    x:Name="TitleBarBackground"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="VPS Desk"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontFamily="Segoe UI"
                               FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeBtn"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE921;"
                                Style="{StaticResource TitleBarBtn}"
                                ToolTip="Minimizar"/>
                        <Button x:Name="MaximizeBtn"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE922;"
                                Style="{StaticResource TitleBarBtn}"
                                ToolTip="Maximizar"/>
                        <Button x:Name="CloseBtn"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE8BB;"
                                Style="{StaticResource CloseTitleBarBtn}"
                                ToolTip="Cerrar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ MAIN LAYOUT ══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ── -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="VPS Desk"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="2,0,0,14"/>
                            <TextBlock Text="&#x276F; HOLOS"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="MIGRATOR"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,-3,0,20"/>

                            <Button x:Name="NavOperations" Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operations" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavDashboard" Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE6FF;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavStorage" Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Storage" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavLogs" Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF000;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Log Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSettings" Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Environment badge at bottom -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Entorno objetivo"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           ToolTip="Indica a que entorno apunta este deploy. En Production se bloquean opciones peligrosas (omitir migraciones, omitir checks publicos). Haz click para cambiar."/>
                                <Button x:Name="EnvironmentButton"
                                        Content="STAGING"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="0,7,0,0"
                                        ToolTip="DEV → STAGING → PRODUCTION&#x0a;En Production se activan validaciones de seguridad adicionales.&#x0a;Click para cambiar entorno."/></StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ── RIGHT PANE ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top action bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenScriptsBtn" Content="Scripts"          Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button x:Name="OpenLogBtn"     Content="Log local"        Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button x:Name="StopButton" Style="{StaticResource DangerBtn}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Detener" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RunButton" Style="{StaticResource PrimaryBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ejecutar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="EnvironmentStatusText"
                                       Text="VPS: SIN VERIFICAR"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       FontSize="12"/>
                        </DockPanel>
                    </Border>

                    <!-- Page area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="22">

                            <!-- ════════════ OPERATIONS ════════════ -->
                            <Grid x:Name="PageOperations" Visibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="Deployment Settings" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Configura el deploy y las migraciones para el entorno objetivo." Style="{StaticResource PageSubTitle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left column -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="Accion" Style="{StaticResource Label}"/>
                                                    <ComboBox x:Name="ActionCombo">
                                                        <ComboBoxItem Content="Deploy completo" IsSelected="True"/>
                                                        <ComboBoxItem Content="Solo migraciones"/>
                                                    </ComboBox>
                                                    <TextBlock Text="Repo local" Style="{StaticResource Label}"/>
                                                    <TextBox x:Name="RepoLocalText" Text="C:\Repos\OmniSuite"/>
                                                    <StackPanel x:Name="AdvancedGeneralPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Repo remoto"     Style="{StaticResource Label}"/>
                                                        <TextBox x:Name="RemoteRepoPathText" Text="/root/OmniSuite"/>
                                                        <TextBlock Text="Rama"            Style="{StaticResource Label}"/>
                                                        <TextBox x:Name="BranchText"      Text="develop"/>
                                                        <TextBlock Text="Compose file"    Style="{StaticResource Label}"/>
                                                        <TextBox x:Name="ComposeFileText" Text="docker-compose.hostinger.yml"/>
                                                        <TextBlock Text="Token GitHub"    Style="{StaticResource Label}"/>
                                                        <PasswordBox x:Name="GitTokenBox"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="Deployment &amp; Migration" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="Objetivo deploy" Style="{StaticResource Label}"/>
                                                    <ComboBox x:Name="DeployTargetCombo">
                                                        <ComboBoxItem Content="Both - Front + API" IsSelected="True"/>
                                                        <ComboBoxItem Content="Backend - Solo API"/>
                                                        <ComboBoxItem Content="Frontend - Solo Front"/>
                                                    </ComboBox>
                                                    <TextBlock Text="Modo migracion" Style="{StaticResource Label}"/>
                                                    <ComboBox x:Name="MigrationModeCombo">
                                                        <ComboBoxItem Content="B - Host + todos los tenants" IsSelected="True"/>
                                                        <ComboBoxItem Content="H - Solo Host"/>
                                                        <ComboBoxItem Content="T - Solo todos los tenants"/>
                                                        <ComboBoxItem Content="U - Un tenant especifico"/>
                                                        <ComboBoxItem Content="N - Ninguna"/>
                                                    </ComboBox>
                                                    <TextBlock Text="Tenant (solo modo U)" Style="{StaticResource Label}"/>
                                                    <TextBox x:Name="TenantText"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <CheckBox x:Name="SkipPullCheck"         Content="Omitir pull"            Margin="0,0,14,6"/>
                                                        <CheckBox x:Name="SkipMigrationsCheck"   Content="Omitir migraciones"     Margin="0,0,14,6"/>
                                                        <CheckBox x:Name="SkipBuildCheck"        Content="Omitir build"           Margin="0,0,14,6"/>
                                                        <CheckBox x:Name="SkipPublicChecksCheck" Content="Omitir checks publicos" Margin="0,0,14,6"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Right column -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="SSH" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="Servidor" Style="{StaticResource Label}"/>
                                                    <TextBox x:Name="ServerHostText"/>
                                                    <TextBlock Text="Usuario"  Style="{StaticResource Label}"/>
                                                    <TextBox x:Name="ServerUserText"/>
                                                    <TextBlock Text="Modo auth" Style="{StaticResource Label}"/>
                                                    <ComboBox x:Name="SshAuthCombo">
                                                        <ComboBoxItem Content="Auto - Llave si existe, si no password" IsSelected="True"/>
                                                        <ComboBoxItem Content="Key - Solo llave SSH"/>
                                                        <ComboBoxItem Content="Password - Pedir clave SSH"/>
                                                    </ComboBox>
                                                    <TextBlock Text="Password / passphrase" Style="{StaticResource Label}"/>
                                                    <PasswordBox x:Name="SshPasswordBox"/>
                                                    <CheckBox x:Name="RememberSshPasswordCheck" Content="Recordar clave SSH cifrada"/>
                                                    <StackPanel x:Name="AdvancedSshPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Puerto SSH" Style="{StaticResource Label}"/>
                                                        <TextBox x:Name="SshPortText" Text="22"/>
                                                        <TextBlock Text="Ruta llave"  Style="{StaticResource Label}"/>
                                                        <TextBox x:Name="SshKeyPathText" Text="C:\Users\USER\.ssh\id_ed25519"/>
                                                        <CheckBox x:Name="SshBatchModeCheck"       Content="SshBatchMode (sin prompts)"/>
                                                        <CheckBox x:Name="InteractivePasswordCheck" Content="Abrir terminal interactiva para password" IsChecked="True"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
                                                    <CheckBox x:Name="CreateRestorePointCheck" Content="Crear punto de control antes de ejecutar" IsChecked="True"/>
                                                    <CheckBox x:Name="RestartExplorerCheck"    Content="Reiniciar status tras ejecucion"/>
                                                    <Button x:Name="AdvancedToggleButton"
                                                            Content="[ SYS.ADVANCED ]"
                                                            Style="{StaticResource SecondaryBtn}"
                                                            Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Output card -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Realtime output" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" Margin="0"/>
                                                <ProgressBar x:Name="RunProgressBar" Height="6" Width="240" Minimum="0" Maximum="100" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock x:Name="StatusBadge"
                                                       Text="Sistema listo."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       Margin="0,0,0,6"/>
                                            <TextBox x:Name="LogTextBox"
                                                     Height="240"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     Background="#1A1A1A"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     IsReadOnly="True"
                                                     Margin="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ════════════ DASHBOARD ════════════ -->
                            <Grid x:Name="PageDashboard" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Estado del VPS, servicios y ejecuciones recientes." Style="{StaticResource PageSubTitle}"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,14">
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="CPU"    Style="{StaticResource Label}"/><TextBlock x:Name="CpuText"    Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Memory" Style="{StaticResource Label}"/><TextBlock x:Name="MemoryText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Disk"   Style="{StaticResource Label}"/><TextBlock x:Name="DiskText"   Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0">      <StackPanel><TextBlock Text="Uptime" Style="{StaticResource Label}"/><TextBlock x:Name="UptimeText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <Button x:Name="RefreshDashboardBtn" Style="{StaticResource PrimaryBtn}" DockPanel.Dock="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock x:Name="OverallStatusText"   Text="Estado VPS: SIN VERIFICAR" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="DashboardSourceText" Text="Fuente: pendiente"         Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" FontSize="12" FontFamily="Segoe UI"/>
                                                <TextBlock x:Name="LastCheckedText"     Text="Ultima verificacion: --"   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" FontSize="12" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="SQL"   Style="{StaticResource Label}"/><TextBlock x:Name="SqlStatusText"   Text="No verificado" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="API"   Style="{StaticResource Label}"/><TextBlock x:Name="ApiStatusText"   Text="No verificado" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0">      <StackPanel><TextBlock Text="Front" Style="{StaticResource Label}"/><TextBlock x:Name="FrontStatusText" Text="No verificado" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/></StackPanel></Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Recent runs" Style="{StaticResource SectionTitle}"/>
                                            <DataGrid x:Name="RecentRunsGrid" Height="200"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ════════════ STORAGE ════════════ -->
                            <Grid x:Name="PageStorage" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Storage" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Uso de disco remoto y almacenamiento Docker." Style="{StaticResource PageSubTitle}"/>

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <Button x:Name="RefreshStorageBtn" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="PruneBuilderBtn" Content="Prune builder" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                                <Button x:Name="PruneImagesBtn"  Content="Prune images"  Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                                <Button x:Name="PruneAllBtn" Style="{StaticResource DangerBtn}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Prune all" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="StorageStatusText" Text="Storage no verificado" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="12"/>
                                        </DockPanel>
                                    </Border>

                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Disk used"    Style="{StaticResource Label}"/><TextBlock x:Name="DiskUsedText"    Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Disk free"    Style="{StaticResource Label}"/><TextBlock x:Name="DiskFreeText"    Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0">      <StackPanel><TextBlock Text="Disk percent" Style="{StaticResource Label}"/><TextBlock x:Name="DiskPercentText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/></StackPanel></Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Docker images" Style="{StaticResource SectionTitle}"/>
                                            <DataGrid x:Name="DockerImagesGrid" Height="180"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Top directories" Style="{StaticResource SectionTitle}"/>
                                            <DataGrid x:Name="TopDirectoriesGrid" Height="180"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ════════════ LOG CENTER ════════════ -->
                            <Grid x:Name="PageLogs" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Log Center" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Output local o logs remotos via SSH." Style="{StaticResource PageSubTitle}"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                    <ComboBox x:Name="RemoteLogSourceCombo" Width="200" Margin="0,0,6,0">
                                                        <ComboBoxItem Content="migrator"    IsSelected="True"/>
                                                        <ComboBoxItem Content="holos-api"/>
                                                        <ComboBoxItem Content="holos-front"/>
                                                        <ComboBoxItem Content="holos-sql"/>
                                                        <ComboBoxItem Content="host-syslog"/>
                                                        <ComboBoxItem Content="host-auth"/>
                                                    </ComboBox>
                                                    <TextBox x:Name="RemoteLogTailText" Text="300" Width="80" Margin="0,0,6,0"/>
                                                    <Button x:Name="LoadRemoteLogBtn" Style="{StaticResource PrimaryBtn}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Load remote" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Button x:Name="ClearLogBtn" Content="Limpiar" Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBox x:Name="RemoteLogTextBox"
                                                     Height="440"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     Background="#1A1A1A"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Margin="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ════════════ SETTINGS ════════════ -->
                            <Grid x:Name="PageSettings" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Configuracion local cargada desde .env y AppData." Style="{StaticResource PageSubTitle}"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Configuration summary" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="SettingsSummaryText"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="ReloadEnvBtn" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8FE;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reload .env" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="SaveSettingsBtn"   Content="Guardar settings"            Style="{StaticResource SecondaryBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </ScrollViewer>
                </Grid><!-- /right pane -->
            </Grid><!-- /main layout -->
        </Grid>
    </Border>
</Window>

