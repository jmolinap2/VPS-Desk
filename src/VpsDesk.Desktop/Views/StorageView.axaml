<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:storage="using:VpsDesk.Domain.Storage"
             x:Class="VpsDesk.Desktop.Views.StorageView"
             x:DataType="vm:StorageViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Storage_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Storage_Subtitle}" Foreground="#8290A3" FontSize="11" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding LastUpdated}" Foreground="#8290A3" VerticalAlignment="Center" />
        <Button Content="{DynamicResource Storage_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.35*,*,*,*" ColumnSpacing="12">
      <Border Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Text="{DynamicResource Storage_RootFilesystem}" Foreground="#8290A3" FontSize="11" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Text="{Binding RootUsagePercent, StringFormat={}{0:F0}%}" FontSize="30" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding RootUsagePercent}" Height="8" />
              <TextBlock Text="{Binding RootAvailable, StringFormat={}Libre: {0}}" Foreground="#66758A" FontSize="10" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding RootUsed, StringFormat={}Usado: {0}}" Foreground="#A8B4C5" FontSize="11" />
          <TextBlock Text="{Binding RootTotal, StringFormat={}Total: {0}}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerImages}" Foreground="#8290A3" FontSize="11" />
          <TextBlock Text="{Binding ImageCount}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ImagesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerVolumes}" Foreground="#8290A3" FontSize="11" />
          <TextBlock Text="{Binding VolumeCount}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VolumesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
      </Border>

      <Border Grid.Column="3" Classes="card">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_BuildCache}" Foreground="#8290A3" FontSize="11" />
          <TextBlock Text="{Binding BuildCacheReclaimable}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_Reclaimable}" Foreground="#66758A" FontSize="10" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel>
          <TextBlock Text="{DynamicResource Storage_CleanupTitle}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_CleanupHelp}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{DynamicResource Storage_CleanBuildCache}" Command="{Binding RequestBuildCacheCleanupCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="{DynamicResource Storage_CleanUnusedImages}" Command="{Binding RequestUnusedImagesCleanupCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="{DynamicResource Storage_CleanDockerSystem}" Command="{Binding RequestDockerSystemCleanupCommand}" IsEnabled="{Binding !IsBusy}" Background="#7F1D1D" Foreground="White" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="0.95*,1.45*,1.05*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Storage_DockerUsage}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="docker system df" Foreground="#66758A" FontSize="10" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding DockerUsage}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:DockerDiskUsage">
                <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Size}" Foreground="#A8B4C5" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Reclaimable}" Foreground="#66758A" FontSize="10" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Storage_HeavyDirectories}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Storage_HeavyDirectoriesHelp}" Foreground="#66758A" FontSize="10" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding HeavyDirectories}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:HeavyDirectoryInfo">
                <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="#A8B4C5" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Text="{DynamicResource Storage_CleanupOutput}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#8290A3" TextWrapping="Wrap" />
          <TextBox Grid.Row="2"
                   Text="{Binding CleanupOutput}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Background="#080B10"
                   BorderThickness="0"
                   Padding="12"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="4" Background="#B0000000" IsVisible="{Binding HasPendingCleanup}">
      <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="42" Height="42" CornerRadius="21" Background="#3A2412" BorderBrush="#A16207" BorderThickness="1">
              <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding PendingCleanupTitle}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_CleanupConfirmation}" Foreground="#8290A3" FontSize="11" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PendingCleanupMessage}" TextWrapping="Wrap" />
          <CheckBox Content="{DynamicResource Storage_IncludeUnusedVolumes}"
                    IsChecked="{Binding IncludeUnusedVolumes}"
                    IsVisible="{Binding ShowIncludeVolumesOption}" />
          <Border Background="#15100D" BorderBrush="#4B3525" BorderThickness="1" CornerRadius="8" Padding="10">
            <TextBlock Text="{DynamicResource Storage_CleanupSafety}" Foreground="#D6B98C" TextWrapping="Wrap" FontSize="11" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCleanupCommand}" />
            <Button Content="{DynamicResource Storage_ConfirmCleanup}" Command="{Binding ConfirmCleanupCommand}" Background="#7F1D1D" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
