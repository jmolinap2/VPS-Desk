<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:services="using:VpsDesk.Desktop.Services"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileProjectsView"
             x:DataType="vm:ProjectsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <!--
    Proyectos para teléfono: en vez de dos listas lado a lado (0.9* / 1.35*),
    una sola lista a la vez en pestañas, y las acciones de cada lista en una
    barra fija abajo. Menos elementos juntos, cada uno con espacio para leerse.
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- proyecto activo -->
    <Border Grid.Row="0" Margin="16,14,16,0" Padding="16" Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.L}">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Ui_ActiveProject}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ActiveProjectName}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ActiveProjectPath}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}"
                   FontSize="{DynamicResource Font.Size.11}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ActiveProjectMode}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- selector de lista + estado -->
    <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="8">
      <Border Classes="seg-track">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
          <Button x:Name="AssociatedTab" Classes="seg active" Click="OnTabClick" Tag="associated">
            <TextBlock>
              <Run Text="{DynamicResource Ui_AssociatedLabel}" /><Run Text="  " /><Run Text="{Binding AssociatedProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
          <Button x:Name="DiscoveredTab" Grid.Column="1" Classes="seg" Click="OnTabClick" Tag="discovered">
            <TextBlock>
              <Run Text="{DynamicResource Ui_Discovered}" /><Run Text="  " /><Run Text="{Binding DiscoveredProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" Margin="2,0" />
    </StackPanel>

    <!-- listas -->
    <Panel Grid.Row="2">
      <ListBox x:Name="AssociatedList" Classes="projects" Margin="16,0,16,8" Background="Transparent"
               ItemsSource="{Binding AssociatedProjects}" SelectedItem="{Binding SelectedProject}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="services:ProjectWorkspace">
            <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Size.14}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding RemoteRepositoryPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}"
                           FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CapabilitySummary}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ListBox x:Name="DiscoveredList" Classes="projects" Margin="16,0,16,8" Background="Transparent" IsVisible="False"
               ItemsSource="{Binding DiscoveredProjects}" SelectedItem="{Binding SelectedDiscovery}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectDiscoveryItem">
            <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Size.14}" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding RemoteRepositoryPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}"
                           FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="{DynamicResource Font.Size.11}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis">
                  <Run Text="{DynamicResource Ui_BranchLabel}" /><Run Text="{Binding Branch}" Foreground="{DynamicResource Brush.Text.Tertiary}" /><Run Text="{DynamicResource Ui_ComposeLabel}" /><Run Text="{Binding ComposeFile}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </TextBlock>
                <TextBlock Text="{DynamicResource Ui_Associated}" IsVisible="{Binding AlreadyAssociated}" Foreground="{DynamicResource Brush.Info}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

    <!-- acciones de la lista visible -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Bar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
      <Panel>
        <Grid x:Name="AssociatedActions" ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Content="{DynamicResource Ui_RemoveAssociation}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasActiveProject}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="{DynamicResource Radius.M}"
                  Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" />
          <Button Grid.Column="1" Content="{DynamicResource Ui_UseSelected}" Command="{Binding ActivateSelectedCommand}" IsEnabled="{Binding HasActiveProject}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="{DynamicResource Radius.M}"
                  Background="{DynamicResource Brush.Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </Grid>
        <Grid x:Name="DiscoveredActions" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
          <Button Content="{DynamicResource Ui_DiscoverProjects}" Command="{Binding DiscoverCommand}" IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="{DynamicResource Radius.M}"
                  Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" />
          <Button Grid.Column="1" Content="{DynamicResource Ui_AssociateProject}" Command="{Binding AssociateSelectedCommand}" IsEnabled="{Binding HasDiscoveredProjects}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="{DynamicResource Radius.M}"
                  Background="{DynamicResource Brush.Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
