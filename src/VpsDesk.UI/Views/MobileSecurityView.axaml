<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:security="using:VpsDesk.Domain.Security"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileSecurityView"
             x:DataType="vm:SecurityViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <DockPanel LastChildFill="True" Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{DynamicResource Security_Title}" Classes="t-title" />
          <TextBlock Text="{DynamicResource Security_Subtitle}" Classes="t-body-s" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding LastChecked}" Classes="t-body-s" VerticalAlignment="Top" />
      </Grid>

      <!-- resumen: tres indicadores en una fila -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <Border Classes="surface" Padding="12">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding PassedCount}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Security_Passed}" Classes="t-label" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="surface" Padding="12">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding WarningCount}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Security_Warnings}" Classes="t-label" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="surface" Padding="12">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding CriticalCount}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Security_Critical}" Classes="t-label" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <Button Classes="btn-primary" Content="{DynamicResource Security_RunAudit}" Command="{Binding RunAuditCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />

      <Border Classes="surface-inset" Padding="10,8">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Panel>
      <ListBox Classes="file-entries" ItemsSource="{Binding Checks}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="security:SecurityCheck">
            <Border Classes="surface" Padding="14,12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.M}" Padding="8,4" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Severity}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
