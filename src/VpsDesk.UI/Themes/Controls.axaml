<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Componentes base del sistema de diseño (docs/DESIGN_SYSTEM.md §4), compartidos por escritorio
    y móvil. Solo usan tokens de Themes/Tokens.axaml. Las vistas nuevas o rediseñadas usan estas
    clases; las antiguas se migran por fases (docs/UX_AUDIT.md §5).
  -->

  <!-- ── Tipografía (§3.2) ─────────────────────────────────────────────── -->
  <Style Selector="TextBlock.t-display">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.t-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.t-headline">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.t-body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.t-body-s">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.t-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.t-overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.t-mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" /></Style>
  <Style Selector="TextBlock.success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></Style>
  <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></Style>
  <Style Selector="TextBlock.danger"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></Style>

  <!-- ── Superficies (§4.2) ─────────────────────────────────────────────── -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.surface-inset">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
  </Style>
  <Style Selector="Border.sheet-handle">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ── Distintivos de estado: píldora con fondo suave + texto semántico ── -->
  <Style Selector="Border.status">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
  </Style>
  <Style Selector="Border.status TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.status.success"><Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" /></Style>
  <Style Selector="Border.status.success > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></Style>
  <Style Selector="Border.status.warning"><Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" /></Style>
  <Style Selector="Border.status.warning > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></Style>
  <Style Selector="Border.status.danger"><Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" /></Style>
  <Style Selector="Border.status.danger > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></Style>
  <Style Selector="Border.status.accent"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" /></Style>
  <Style Selector="Border.status.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" /></Style>
  <Style Selector="Border.status.info"><Setter Property="Background" Value="{DynamicResource Brush.Info.Subtle}" /></Style>
  <Style Selector="Border.status.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Info}" /></Style>

  <!-- Pestañas: títulos de la escala tipográfica (headline) -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!-- Barra de progreso con el acento de la app (el de Fluent usa el del sistema) -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
  </Style>

  <!-- ── Iconos de trazo (§3.6) ─────────────────────────────────────────── -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.tertiary"><Setter Property="Stroke" Value="{DynamicResource Brush.Text.Tertiary}" /></Style>
  <Style Selector="Path.icon.accent"><Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Text}" /></Style>
  <Style Selector="Path.icon.on-accent"><Setter Property="Stroke" Value="{DynamicResource Brush.Accent.OnAccent}" /></Style>
  <Style Selector="Path.icon.success"><Setter Property="Stroke" Value="{DynamicResource Brush.Success}" /></Style>
  <Style Selector="Path.icon.warning"><Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" /></Style>
  <Style Selector="Path.icon.danger"><Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" /></Style>

  <!-- ── Botones (§4.1): altura 48, verbo concreto, una sola acción principal ── -->
  <Style Selector="Button.btn-primary, Button.btn-secondary, Button.btn-ghost, Button.btn-danger">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.btn-primary:pressed, Button.btn-secondary:pressed, Button.btn-ghost:pressed, Button.btn-danger:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.btn-primary:disabled, Button.btn-secondary:disabled, Button.btn-ghost:disabled, Button.btn-danger:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
  </Style>
  <Style Selector="Button.btn-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
  </Style>
  <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
  </Style>

  <Style Selector="Button.btn-secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Button.btn-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
  </Style>

  <Style Selector="Button.btn-ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="Button.btn-danger">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>

  <!-- Botón de icono: área táctil de 48 aunque el icono mida 20 -->
  <Style Selector="Button.btn-icon">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.btn-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.btn-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
  </Style>

  <!-- Fila pulsable de ancho completo (ajustes, navegación a una hoja) -->
  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
  </Style>
<!-- ── Control segmentado (Nuevo / Historial, Salida / Pasos) ─────────── -->
  <Style Selector="Border.seg-track">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <!-- ── Chips de elección única (ListBox con WrapPanel) ────────────────── -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.chips > ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.chips > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
  </Style>
  <Style Selector="ListBox.chips > ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
  </Style>
  <Style Selector="ListBox.chips > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.chips > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- ── Fila de comprobación (prevuelo / postvuelo): icono de estado + texto ── -->
  <Style Selector="Border.check-icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.check-icon > Panel > Path">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.check-icon.passed"><Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" /></Style>
  <Style Selector="Border.check-icon.passed > Panel > Path.ok"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Border.check-icon.warning"><Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" /></Style>
  <Style Selector="Border.check-icon.warning > Panel > Path.warn"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Border.check-icon.failed"><Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" /></Style>
  <Style Selector="Border.check-icon.failed > Panel > Path.bad"><Setter Property="IsVisible" Value="True" /></Style>

  <!-- ── Modales (DESIGN_SYSTEM §4.3-4.4): tarjeta centrada en escritorio, hoja inferior en móvil ── -->
  <Style Selector="Border.modal-scrim">
    <Setter Property="Background" Value="{DynamicResource Brush.Scrim}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.modal-card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="MaxHeight" Value="680" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #66000000" />
    <Setter Property="RenderTransform" Value="translateY(24px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=".mobile Border.modal-card">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MaxWidth" Value="100000" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="20,12,20,20" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.XL.Top}" />
    <Setter Property="RenderTransform" Value="translateY(420px)" />
  </Style>
  <Style Selector="Border.modal-scrim.open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Border.modal-scrim.open > Border.modal-card">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <!-- Presentación de las vistas migradas en teléfono. -->
  <Style Selector=".mature TextBox, .mature ComboBox, .mature NumericUpDown, .mature CheckBox, .mature Expander">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector=".mature TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=".mature Button.seg">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector=".mature TextBox">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.14}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=".mature CheckBox ContentPresenter">
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ListBox.file-entries">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.file-entries ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="72" />
  </Style>
</Styles>
