<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:deploy="using:VpsDesk.Application.Deployments"
             xmlns:activity="using:VpsDesk.Domain.Activity"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             xmlns:views="using:VpsDesk.Desktop.Views"
             x:Class="VpsDesk.Desktop.Views.DeploymentsView"
             x:DataType="vm:DeploymentsViewModel">
  <UserControl.Resources>
    <conv:DeploymentStatusMessageConverter x:Key="DeploymentStatusMessageConverter" />
    <conv:PreflightStatusConverter x:Key="PreflightStatusConverter" />
    <conv:PostflightStatusConverter x:Key="PostflightStatusConverter" />
  </UserControl.Resources>

  <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{DynamicResource Deployments_NewDeployment}" Command="{Binding ShowNewDeploymentCommand}" />
        <Button Content="{DynamicResource Deployments_History}" Command="{Binding ShowHistoryCommand}" />
        <TextBlock Text="{Binding DeploymentHistory.Count, StringFormat={}{0} registros}"
                   Foreground="#66758A"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Deployments_LastValidation}" Foreground="#66758A" FontSize="10" />
        <TextBlock Text="{Binding LastChecked}" Foreground="#8290A3" FontSize="11" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" IsVisible="{Binding IsNewDeploymentView}" ClipToBounds="True">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Classes="card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto">
              <Button Command="{Binding ToggleDeploymentConfigurationCommand}"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="18,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding RemoteRepositoryPath}"
                               FontWeight="SemiBold"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Branch}" Foreground="#8290A3" FontSize="11" />
                      <TextBlock Text="·" Foreground="#465468" FontSize="11" />
                      <TextBlock Text="{Binding ComposeFile}" Foreground="#8290A3" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="·" Foreground="#465468" FontSize="11" />
                      <TextBlock Text="{Binding SelectedTargetLabel}" Foreground="#5EEAD4" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border IsVisible="{Binding IsDeploymentRunning}"
                            Background="#0E2A24"
                            BorderBrush="#0F766E"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#8DE7CE"
                                   FontSize="10"
                                   MaxWidth="330"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="⌃" IsVisible="{Binding IsDeploymentConfigurationExpanded}" FontSize="18" Foreground="#8290A3" />
                    <TextBlock Text="⌄" IsVisible="{Binding IsDeploymentConfigurationCollapsed}" FontSize="18" Foreground="#8290A3" />
                  </StackPanel>
                </Grid>
              </Button>

              <Border Grid.Row="1"
                      BorderBrush="#202A38"
                      BorderThickness="0,1,0,0"
                      IsVisible="{Binding IsDeploymentConfigurationExpanded}">
                <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel ToolTip.Tip="{DynamicResource Deployments_RemoteRepositoryTooltip}">
                      <TextBlock Text="{DynamicResource Deployments_RemoteRepository}" Foreground="#8290A3" FontSize="11" />
                      <TextBox Text="{Binding RemoteRepositoryPath}" PlaceholderText="/root/mi-app" />
                      <ComboBox Margin="0,5,0,0"
                                ItemsSource="{Binding AvailableProjects}"
                                SelectedItem="{Binding SelectedProjectSuggestion}"
                                IsVisible="{Binding HasProjectSuggestions}"
                                PlaceholderText="{DynamicResource Deployments_ProjectPlaceholder}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="deploy:DeploymentProjectCandidate">
                            <TextBlock Text="{Binding RemoteRepositoryPath}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom">
                      <Button Content="{DynamicResource Deployments_Discover}"
                              Command="{Binding DiscoverRemoteOptionsCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              Margin="0,0,8,0" />
                      <Button Content="{DynamicResource Deployments_PullSource}"
                              Command="{Binding PullSourceCommand}"
                              ToolTip.Tip="{DynamicResource Deployments_PullSourceTooltip}"
                              IsEnabled="{Binding !IsBusy}"
                              Margin="0,0,8,0" />
                      <Button Content="{DynamicResource Deployments_RunPreflight}"
                              Command="{Binding RunPreflightCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              Margin="0,0,8,0" />
                      <Button Content="{DynamicResource Deployments_Execute}"
                              Command="{Binding StartDeploymentCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              Background="#0F766E"
                              Foreground="White"
                              FontWeight="SemiBold" />
                    </WrapPanel>
                  </Grid>

                  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel ToolTip.Tip="{DynamicResource Deployments_BranchTooltip}">
                      <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
                        <TextBlock Text="Git" Foreground="#5EEAD4" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="·" Foreground="#465468" FontSize="10" />
                        <TextBlock Text="{DynamicResource Deployments_Branch}" Foreground="#8290A3" FontSize="11" />
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding AvailableBranches}"
                                SelectedItem="{Binding Branch}"
                                PlaceholderText="{DynamicResource Deployments_BranchPlaceholder}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{DynamicResource Deployments_ComposeFile}" Foreground="#8290A3" FontSize="11" />
                      <TextBox Text="{Binding ComposeFile}" PlaceholderText="docker-compose.yml" />
                      <ComboBox Margin="0,5,0,0"
                                ItemsSource="{Binding AvailableComposeFiles}"
                                SelectedItem="{Binding SelectedComposeSuggestion}"
                                PlaceholderText="{DynamicResource Deployments_ComposePlaceholder}" />
                    </StackPanel>
                  </Grid>

                  <Border Grid.Row="2" Background="#0E131B" BorderBrush="#202A38" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock Text="Modelo del proyecto" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ProjectModelStatus}"
                                     Foreground="{Binding ProjectModelStatus, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                IsVisible="{Binding HasProjectRecipe}"
                                Background="#102A24"
                                BorderBrush="#0F766E"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding ProjectRecipeFileName}" Foreground="#5EEAD4" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                      </Grid>

                      <Border IsVisible="{Binding !HasProjectRecipe}"
                              Background="#101B2A"
                              BorderBrush="#294A70"
                              BorderThickness="1"
                              CornerRadius="9"
                              Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                          <Border Width="34" Height="34" CornerRadius="17" Background="#17304D" VerticalAlignment="Top">
                            <TextBlock Text="V" Foreground="#7DD3FC" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text=".vpsdesk.yml · integración opcional del proyecto" FontWeight="SemiBold" Foreground="#B9DBFF" />
                            <TextBlock Text="VPS Desk funciona sin este archivo. Si lo agregas en la raíz del repositorio, el propio proyecto puede describir sus objetivos de despliegue, migraciones y parámetros guiados sin acoplar VPS Desk a una arquitectura concreta."
                                       Foreground="#8FB5D9" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="Targets de despliegue · migraciones · parámetros · versionado con Git"
                                       Foreground="#7DD3FC" FontSize="10" FontWeight="SemiBold" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border IsVisible="{Binding HasProjectRecipe}"
                              Background="#0D241F"
                              BorderBrush="#0F766E"
                              BorderThickness="1"
                              CornerRadius="9"
                              Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                          <Border Width="34" Height="34" CornerRadius="17" Background="#103D34" VerticalAlignment="Top">
                            <TextBlock Text="✓" Foreground="#7EE7CD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Integración VPS Desk activa" FontWeight="SemiBold" Foreground="#9AF0D8" />
                            <TextBlock Text="Este repositorio enseña a VPS Desk cómo quiere ser operado. La receta viaja con Git y habilita una experiencia guiada para targets y migraciones; el prevuelo y la confirmación siguen siendo obligatorios antes de ejecutar cambios."
                                       Foreground="#8FCABC" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="La receta pertenece al proyecto; VPS Desk sigue siendo genérico."
                                       Foreground="#5EEAD4" FontSize="10" FontWeight="SemiBold" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Qué quieres ejecutar" Foreground="#8290A3" FontSize="11" />
                          <StackPanel IsVisible="{Binding ShowDeploymentTarget}" Spacing="5">
                            <TextBlock Text="Objetivo de despliegue" FontSize="11" />
                            <ComboBox ItemsSource="{Binding AvailableTargets}"
                                      SelectedItem="{Binding SelectedDeploymentTarget}"
                                      PlaceholderText="Selecciona servicios">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="deploy:ProjectDeploymentTarget">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <CheckBox Content="Solo ejecutar migraciones"
                                    IsChecked="{Binding MigrationOnly}"
                                    IsVisible="{Binding HasMigrationRecipe}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasMigrationRecipe}">
                          <TextBlock Text="Migraciones de base de datos" Foreground="#8290A3" FontSize="11" />
                          <CheckBox Content="Ejecutar migraciones en este pase"
                                    IsChecked="{Binding RunMigrations}"
                                    IsEnabled="{Binding !MigrationOnly}" />
                          <ComboBox ItemsSource="{Binding MigrationModes}"
                                    SelectedItem="{Binding SelectedMigrationMode}"
                                    IsVisible="{Binding ShowMigrationOptions}"
                                    PlaceholderText="Selecciona el alcance">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="deploy:ProjectMigrationMode">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <StackPanel IsVisible="{Binding RequiresMigrationInput}" Spacing="4">
                            <TextBlock Text="{Binding MigrationInputLabel}" Foreground="#8290A3" FontSize="10" />
                            <TextBox Text="{Binding MigrationInput}" PlaceholderText="{Binding MigrationInputPlaceholder}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Deployments_Safety}" FontWeight="SemiBold" Margin="0,0,0,6" />
                      <CheckBox Content="{DynamicResource Deployments_RequireEnv}" IsChecked="{Binding RequireEnvironmentFile}" />
                      <TextBox Text="{Binding EnvironmentFileName}" PlaceholderText=".env" Margin="22,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                      <CheckBox Content="{DynamicResource Deployments_PullImages}"
                                IsChecked="{Binding PullImages}"
                                IsEnabled="{Binding !MigrationOnly}" />
                      <CheckBox Content="{DynamicResource Deployments_BuildImages}"
                                IsChecked="{Binding BuildImages}"
                                IsEnabled="{Binding !MigrationOnly}" />
                      <CheckBox Content="{DynamicResource Deployments_CleanBuildCache}"
                                IsChecked="{Binding CleanBuildCache}"
                                IsEnabled="{Binding !MigrationOnly}"
                                ToolTip.Tip="{DynamicResource Deployments_CleanBuildCacheTooltip}" />
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Deployments_HealthUrls}" Foreground="#8290A3" FontSize="11" />
                      <TextBox Text="{Binding HttpHealthUrls}"
                               AcceptsReturn="True"
                               MinHeight="62"
                               IsEnabled="{Binding !MigrationOnly}"
                               PlaceholderText="https://app.example.com/health" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Deployments_SaveProfile}"
                            Command="{Binding SaveProfileCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            VerticalAlignment="Bottom" />
                  </Grid>

                  <Border Grid.Row="5"
                          Background="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=background}"
                          BorderBrush="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=border}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="11">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Width="25" Height="25" CornerRadius="13"
                              BorderBrush="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=border}"
                              BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=glyph}"
                                   Foreground="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusMessage}"
                                 Foreground="{Binding StatusMessage, Converter={StaticResource DeploymentStatusMessageConverter}, ConverterParameter=foreground}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="Punto de restauración del servidor" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SnapshotSummary}" Foreground="#8290A3" FontSize="11" TextWrapping="Wrap" />
                <CheckBox Content="Crear un snapshot automáticamente antes de desplegar"
                          IsChecked="{Binding SnapshotBeforeDeploy}"
                          IsVisible="{Binding IsSnapshotConfigured}"
                          Margin="0,6,0,0" />
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Right">
                <Button Content="Crear snapshot" Command="{Binding RequestCreateSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}" Margin="0,0,8,6" />
                <Button Content="Restaurar" Command="{Binding RequestRestoreSnapshotCommand}" IsEnabled="{Binding CanRestoreSnapshot}" Margin="0,0,8,6" />
                <Button Content="&#8635;" Command="{Binding RefreshSnapshotCommand}" IsEnabled="{Binding CanUseSnapshots}" Margin="0,0,0,6" ToolTip.Tip="Consultar el snapshot actual" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="16" IsVisible="{Binding IsAppBackupConfigured}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="Copia de la aplicación (descargable)" FontWeight="SemiBold" />
                <TextBlock Text="PostgreSQL (todas las bases) + proyecto + configuración, guardados en esta máquina con rotación."
                           Foreground="#8290A3" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AppBackupSummary}" Foreground="#8290A3" FontSize="11" TextWrapping="Wrap" />
                <CheckBox Content="Crear una copia automáticamente antes de desplegar"
                          IsChecked="{Binding BackupBeforeDeploy}"
                          Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Conservar las últimas" VerticalAlignment="Center" FontSize="12" />
                  <NumericUpDown Value="{Binding AppBackupKeepCopies}" Minimum="1" Maximum="10" Increment="1"
                                 FormatString="0" Width="110" />
                  <TextBlock Text="copias" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Right">
                <Button Content="Crear copia" Command="{Binding CreateAppBackupCommand}" IsEnabled="{Binding CanUseAppBackups}" Margin="0,0,8,6" />
                <Button Content="Abrir carpeta" Command="{Binding OpenAppBackupFolderCommand}" Margin="0,0,8,6" />
                <Button Content="&#8635;" Command="{Binding RefreshAppBackupsCommand}" Margin="0,0,0,6" ToolTip.Tip="Releer las copias locales" />
              </WrapPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="250,*" ColumnSpacing="14" MinHeight="430">
            <Border Classes="card" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Deployments_Process}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Deployments_ProcessHelp}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="deploy:DeploymentStepResult">
                        <Border Background="#0E131B" CornerRadius="8" Padding="10" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding ExitCode, StringFormat=exit {0}}" Foreground="#66758A" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" BorderBrush="#245F54" BorderThickness="1.5" ClipToBounds="True">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Deployments_Output}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeploymentOutcomeTitle}" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding HasExecutionActivity}" />
                    <TextBlock Text="{Binding DeploymentNextAction}" Foreground="#A8B4C5" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !IsDeploymentRunning}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsDeploymentRunning}">
                    <Ellipse Width="9" Height="9" Fill="#34D399" />
                    <TextBlock Text="LIVE" Foreground="#5EEAD4" FontSize="10" FontWeight="Bold" />
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                  <TextBlock Text="{Binding DeploymentProgressText}" Foreground="#F1F5F9" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                             IsVisible="{Binding IsDeploymentRunning}" views:DeploymentAttention.IsRunning="{Binding IsDeploymentRunning}" />
                  <ProgressBar IsVisible="{Binding IsDeploymentRunning}"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding DeploymentProgressPercent}"
                               Height="7"
                               Foreground="#14B8A6"
                               Background="#17252B" />
                  <TextBlock Text="{Binding DeploymentLastActivity}" Foreground="#94A3B8" FontSize="11" IsVisible="{Binding HasExecutionActivity}" />
                  <WrapPanel IsVisible="{Binding HasExecutionActivity}">
                    <Button Content="{Binding OutputFollowLabel}" Command="{Binding ToggleOutputFollowCommand}" Margin="0,0,12,4" />
                    <TextBlock Text="{Binding OutputFollowHint}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </WrapPanel>
                </StackPanel>

                <TextBox Grid.Row="2"
                         MinHeight="280"
                         Text="{Binding DeploymentOutput}"
                         IsReadOnly="True"
                         views:TextBoxAutoScroll.IsEnabled="{Binding FollowDeploymentOutput}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="13"
                         Foreground="#CBD5E1"
                         Background="#05080C"
                         BorderThickness="0"
                         Padding="16"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

    </Grid>

    <Grid Grid.Row="1" IsVisible="{Binding IsHistoryView}" ColumnDefinitions="0.85*,1.45*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Deployments_History}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Deployments_HistoryHelp}" Foreground="#66758A" FontSize="11" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding DeploymentHistory}" SelectedItem="{Binding SelectedHistoryEntry}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="activity:OperationHistoryEntry">
                <Border Background="#0E131B" CornerRadius="8" Padding="11" Margin="0,3">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Foreground="#8290A3" />
                      <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ServerName}" Foreground="#66758A" FontSize="10" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Deployments_HistoryDetail}" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Servidor" Foreground="#66758A" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedHistoryEntry.ServerName}" />
              <TextBlock Grid.Row="1" Text="Entorno" Foreground="#66758A" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Environment}" />
              <TextBlock Grid.Row="2" Text="Repositorio" Foreground="#66758A" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHistoryEntry.RemoteRepositoryPath}" />
              <TextBlock Grid.Row="3" Text="Rama" Foreground="#66758A" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Branch}" />
              <TextBlock Grid.Row="4" Text="Compose" Foreground="#66758A" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedHistoryEntry.ComposeFile}" />
              <TextBlock Grid.Row="5" Text="Resultado" Foreground="#66758A" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Outcome}" />
              <TextBlock Grid.Row="6" Text="Duración" Foreground="#66758A" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedHistoryEntry.Duration, StringFormat={}{0:g}}" />
              <TextBlock Grid.Row="7" Text="Paso fallido" Foreground="#66758A" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedHistoryEntry.FailedStep}" />
            </Grid>
            <TextBlock Text="{DynamicResource Deployments_HistoryChecks}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox Text="{Binding SelectedHistoryEntry.Details}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     MinHeight="110"
                     FontFamily="Cascadia Mono,Consolas,monospace" />
            <TextBlock Text="{DynamicResource Deployments_HistoryOutput}" FontWeight="SemiBold" />
            <TextBox Text="{Binding SelectedHistoryEntry.Output}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     MinHeight="260"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Background="#080B10" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <views:DeploymentModals Grid.RowSpan="2" />
  </Grid>
</UserControl>
