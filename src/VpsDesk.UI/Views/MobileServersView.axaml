<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:servers="using:VpsDesk.Domain.Servers"
             x:Class="VpsDesk.Desktop.Views.MobileServersView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Servidores para teléfono (docs/DESIGN_SYSTEM.md). Una sola columna: lista de tarjetas y, al
    tocar una, una hoja inferior con el editor. Cada tarjeta muestra el entorno (PROD/STAGING) para
    no confundir servidores. La acción principal («Nuevo servidor») queda fija al pie.
  -->
  <UserControl.Styles>
    <!-- retroalimentación al tocar una tarjeta -->
    <Style Selector="Button.serverCard">
      <Setter Property="Padding" Value="14" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.serverCard:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>

    <!-- resultado de "Probar conexión": neutro mientras prueba, verde si conecta, rojo si falla -->
    <Style Selector="Border.testResult">
      <Setter Property="Background" Value="{DynamicResource Brush.Info.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.testResult.ok">
      <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style Selector="Border.testResult.failed">
      <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="Border.testResult TextBlock.msg">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
    </Style>
    <Style Selector="Border.testResult.ok TextBlock.msg">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style Selector="Border.testResult.failed TextBlock.msg">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
      <!-- estado del editor (resultado de probar conexión, errores SSH) -->
      <StackPanel DockPanel.Dock="Top" Margin="16,12,16,12" Spacing="10">
        <TextBlock Classes="t-body-s" Text="{DynamicResource Servers_SavedLocally}" TextWrapping="Wrap" />
        <Border Classes="surface-inset">
          <TextBlock Classes="t-body-s" Text="{Binding ServerEditorMessage}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <!-- acción principal, fija al pie -->
      <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource Brush.Surface.Bar}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
        <Button Classes="btn-primary" Content="{DynamicResource Servers_New}" Click="OnNewServerClick" HorizontalAlignment="Stretch" />
      </Border>

      <!-- lista de tarjetas -->
      <ScrollViewer Margin="16,0">
        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="servers:ServerProfile">
              <Button Classes="row serverCard" Click="OnServerCardClick" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.Accent.Subtle}"
                          VerticalAlignment="Center">
                    <Path Classes="icon accent" Data="{StaticResource Icon.Server}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="t-headline" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Classes="status danger"
                              IsVisible="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static servers:ServerEnvironment.Production}}">
                        <TextBlock Text="{DynamicResource Deployments_EnvProd}" />
                      </Border>
                      <Border Classes="status warning"
                              IsVisible="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static servers:ServerEnvironment.Staging}}">
                        <TextBlock Text="{DynamicResource Deployments_EnvStaging}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="t-mono" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Username}" /><Run Text="@" /><Run Text="{Binding Host}" /><Run Text=":" /><Run Text="{Binding Port}" />
                    </TextBlock>
                  </StackPanel>
                  <Path Grid.Column="2" Classes="icon tertiary" Data="{StaticResource Icon.ChevronRight}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- scrim -->
    <Border x:Name="Scrim" Classes="m-scrim" PointerPressed="OnScrimPointerPressed" />

    <!-- hoja del editor -->
    <Border x:Name="Sheet" Classes="m-sheet" VerticalAlignment="Bottom" MaxHeight="660">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
          <Border Classes="sheet-handle" Margin="0,10,0,4" />
          <Grid ColumnDefinitions="*,Auto" Margin="20,4,8,8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="t-title" Text="{DynamicResource Servers_ConnectionProfile}" />
              <TextBlock Classes="t-label" Text="{Binding SelectedServerInList.Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Classes="btn-icon" Click="OnCloseSheetClick"
                    AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}">
              <Path Classes="icon" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,4,20,8">
          <StackPanel Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_Name}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorName}" PlaceholderText="{DynamicResource Servers_NamePlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_Provider}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorProvider}" PlaceholderText="{DynamicResource Servers_ProviderPlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_Host}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorHost}" PlaceholderText="203.0.113.10" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Servers_SshPort}" />
                <NumericUpDown MinHeight="48" Minimum="1" Maximum="65535" Value="{Binding EditorPort}" VerticalContentAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Servers_Username}" />
                <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorUsername}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Servers_Environment}" />
                <ComboBox MinHeight="48" ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding EditorEnvironment}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="t-label" Text="{DynamicResource Servers_Authentication}" />
                <ComboBox MinHeight="48" ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding EditorAuthenticationType}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_PrivateKeyPath}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorPrivateKeyPath}" PlaceholderText="C:\Users\you\.ssh\id_ed25519" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_PasswordSession}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorSecret}" PasswordChar="●" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_HostFingerprint}" />
              <TextBox MinHeight="48" VerticalContentAlignment="Center" Text="{Binding EditorHostKeyFingerprint}" PlaceholderText="SHA256:..." />
              <TextBlock Classes="t-label" Text="{DynamicResource Servers_HostFingerprintHelp}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="10" Margin="20,8,20,20">
          <!-- resultado visible junto a los botones: la tarjeta de la página queda tapada por la hoja -->
          <Border Classes="testResult" Classes.ok="{Binding ServerTestSucceeded}" Classes.failed="{Binding ServerTestFailed}">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingServer}" Height="3" />
              <TextBlock Classes="msg" Text="{Binding ServerEditorMessage}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Classes="btn-secondary" Content="{DynamicResource Servers_TestConnection}" Command="{Binding TestServerCommand}"
                  IsEnabled="{Binding !IsTestingServer}" HorizontalAlignment="Stretch" Click="OnActionClick" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Classes="btn-secondary" Content="{DynamicResource Servers_SaveProfile}" Command="{Binding SaveServerCommand}"
                    HorizontalAlignment="Stretch" Click="OnActionClick" />
            <Button Grid.Column="1" Classes="btn-primary" Content="{DynamicResource Servers_UseServer}" Command="{Binding ActivateServerCommand}"
                    HorizontalAlignment="Stretch" Click="OnActivateClick" />
          </Grid>
          <Button Classes="btn-danger" Content="{DynamicResource Common_Delete}" Command="{Binding DeleteServerCommand}"
                  HorizontalAlignment="Stretch" Click="OnDeleteClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
