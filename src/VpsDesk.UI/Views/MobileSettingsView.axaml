<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             xmlns:services="using:VpsDesk.Desktop.Services"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileSettingsView"
             x:DataType="vm:SettingsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid>
    <ScrollViewer Padding="16,12,16,24">
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource Ui_LocalVPSDeskPreferencesPasswordsPrivate}" Classes="t-body-s" TextWrapping="Wrap" />

        <Border Classes="surface" DataContext="{Binding Updates}" IsVisible="{Binding IsAvailableOnPlatform}" x:DataType="vm:UpdatesViewModel">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Ui_Updates}" />
              <TextBlock Text="{DynamicResource Ui_VPSDeskChecksForUpdatesAt}" Classes="t-body-s" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Classes="t-body-s" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ReleaseNotes}" Classes="t-body-s" TextWrapping="Wrap" IsVisible="{Binding IsUpdateAvailable}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}" Height="6" />
            <Button Classes="btn-primary" Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
            <Button Classes="btn-secondary" Content="{DynamicResource Ui_CheckForUpdates}" Command="{Binding CheckCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Ui_General}" />
              <TextBlock Text="{DynamicResource Ui_LanguageAndRefreshFrequencyLabel}" Classes="t-body-s" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Ui_Language}" Classes="t-label" />
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch" MinHeight="48" />
            <TextBlock Text="{DynamicResource Ui_AutomaticRefreshSeconds}" Classes="t-label" />
            <ComboBox ItemsSource="{Binding RefreshIntervalOptions}" SelectedItem="{Binding RefreshIntervalSeconds}" HorizontalAlignment="Stretch" MinHeight="48" />
          </StackPanel>
        </Border>

        <views:LocalBackupsView />
        <CheckBox x:CompileBindings="False"
                  IsChecked="{Binding SoundEnabled, Source={x:Static services:NotificationCenter.Shared}, Mode=TwoWay}"
                  Content="{DynamicResource Notifications_Sound}" />

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Ui_RemoteEditing}" />
              <TextBlock Text="{DynamicResource Ui_ProtectionsWhenEditingFilesOverSFTP}" Classes="t-body-s" />
            </StackPanel>
            <CheckBox IsChecked="{Binding BackupBeforeRemoteSave}" Content="{DynamicResource Ui_CreateABakCopyBeforeOverwriting}" />
          </StackPanel>
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Nav_Terminal}" />
              <TextBlock Text="{DynamicResource Ui_CommandsAndOutputAreNeverSaved}" Classes="t-body-s" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Ui_FontSize}" Classes="t-label" />
            <NumericUpDown Minimum="11" Maximum="22" Increment="1" Value="{Binding TerminalFontSize}" HorizontalAlignment="Stretch" MinHeight="48" VerticalContentAlignment="Center" />
            <TextBlock Text="{DynamicResource Ui_ScrollbackLines}" Classes="t-label" />
            <ComboBox ItemsSource="{Binding TerminalScrollbackOptions}" SelectedItem="{Binding TerminalScrollbackLines}" HorizontalAlignment="Stretch" MinHeight="48" />
            <CheckBox IsChecked="{Binding ConfirmMultilineTerminalPaste}" Content="{DynamicResource Ui_ConfirmBeforePastingMultipleLines}" />
          </StackPanel>
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="t-headline" Text="{DynamicResource Ui_LocalData}" />
              <TextBlock Text="{DynamicResource Ui_ProfilesHistoryAndPreferencesAreStored}" Classes="t-body-s" />
            </StackPanel>
            <Border Classes="surface-inset">
              <TextBlock Text="{Binding SettingsPath}" Classes="t-mono" TextWrapping="Wrap" />
            </Border>
            <Button Classes="btn-secondary" Content="{DynamicResource Ui_OpenFolder}" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="btn-danger" Content="{DynamicResource Ui_ResetPreferences}" Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding StatusMessage}" Classes="t-label" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
