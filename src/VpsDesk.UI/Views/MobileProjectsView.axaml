<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:services="using:VpsDesk.Desktop.Services"
             x:Class="VpsDesk.Desktop.Views.MobileProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <!--
    Proyectos para teléfono: en vez de dos listas lado a lado (0.9* / 1.35*),
    una sola lista a la vez en pestañas, y las acciones de cada lista en una
    barra fija abajo. Menos elementos juntos, cada uno con espacio para leerse.
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- proyecto activo -->
    <Border Grid.Row="0" Margin="16,14,16,0" Padding="16" Background="#121826" BorderBrush="#1E2735" BorderThickness="1" CornerRadius="18">
      <StackPanel Spacing="4">
        <TextBlock Text="Proyecto activo" Foreground="#8290A3" FontSize="10.5" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ActiveProjectName}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ActiveProjectPath}" Foreground="#91A0B5" FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="11" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ActiveProjectMode}" Foreground="#5EEAD4" FontSize="11" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- selector de lista + estado -->
    <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="8">
      <Border Classes="seg-track">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
          <Button x:Name="AssociatedTab" Classes="seg active" Click="OnTabClick" Tag="associated">
            <TextBlock>
              <Run Text="Asociados" /><Run Text="  " /><Run Text="{Binding AssociatedProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
          <Button x:Name="DiscoveredTab" Grid.Column="1" Classes="seg" Click="OnTabClick" Tag="discovered">
            <TextBlock>
              <Run Text="Descubiertos" /><Run Text="  " /><Run Text="{Binding DiscoveredProjects.Count}" Foreground="{DynamicResource Brush.Accent.Text}" />
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <TextBlock Text="{Binding StatusMessage}" Foreground="#8290A3" FontSize="11" TextWrapping="Wrap" Margin="2,0" />
    </StackPanel>

    <!-- listas -->
    <Panel Grid.Row="2">
      <ListBox x:Name="AssociatedList" Classes="projects" Margin="16,0,16,8" Background="Transparent"
               ItemsSource="{Binding AssociatedProjects}" SelectedItem="{Binding SelectedProject}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="services:ProjectWorkspace">
            <Border Background="#121826" BorderBrush="#1E2735" BorderThickness="1" CornerRadius="16" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="#5EEAD4" FontSize="10" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding RemoteRepositoryPath}" Foreground="#8290A3" FontSize="11"
                           FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CapabilitySummary}" Foreground="#66758A" FontSize="10.5" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ListBox x:Name="DiscoveredList" Classes="projects" Margin="16,0,16,8" Background="Transparent" IsVisible="False"
               ItemsSource="{Binding DiscoveredProjects}" SelectedItem="{Binding SelectedDiscovery}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectDiscoveryItem">
            <Border Background="#121826" BorderBrush="#1E2735" BorderThickness="1" CornerRadius="16" Padding="14">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Background="#102A24" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeLabel}" Foreground="#5EEAD4" FontSize="10" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding RemoteRepositoryPath}" Foreground="#8290A3" FontSize="11"
                           FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="10.5" Foreground="#66758A" TextTrimming="CharacterEllipsis">
                  <Run Text="Rama " /><Run Text="{Binding Branch}" Foreground="#8290A3" /><Run Text="  ·  Compose " /><Run Text="{Binding ComposeFile}" Foreground="#8290A3" />
                </TextBlock>
                <TextBlock Text="ASOCIADO" IsVisible="{Binding AlreadyAssociated}" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

    <!-- acciones de la lista visible -->
    <Border Grid.Row="3" Background="#0E1219" BorderBrush="#1A2230" BorderThickness="0,1,0,0" Padding="16,10,16,12">
      <Panel>
        <Grid x:Name="AssociatedActions" ColumnDefinitions="*,*" ColumnSpacing="10">
          <Button Content="Quitar asociación" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasActiveProject}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="13"
                  Background="#121826" BorderBrush="#2A3A52" BorderThickness="1" />
          <Button Grid.Column="1" Content="Usar seleccionado" Command="{Binding ActivateSelectedCommand}" IsEnabled="{Binding HasActiveProject}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="13"
                  Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </Grid>
        <Grid x:Name="DiscoveredActions" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="False">
          <Button Content="Detectar proyectos" Command="{Binding DiscoverCommand}" IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="13"
                  Background="#121826" BorderBrush="#2A3A52" BorderThickness="1" />
          <Button Grid.Column="1" Content="Asociar proyecto" Command="{Binding AssociateSelectedCommand}" IsEnabled="{Binding HasDiscoveredProjects}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,13" CornerRadius="13"
                  Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
