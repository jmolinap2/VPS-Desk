<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             x:Class="VpsDesk.Desktop.Views.EnvironmentView"
             x:DataType="vm:FilesViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="14">
    <Border Classes="surface">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{DynamicResource Files_EnvManagerTitle}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" IsVisible="{Binding IsEnvironmentFile}">
              <TextBlock Text=".ENV" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" FontWeight="Bold" />
            </Border>
            <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" IsVisible="{Binding IsEditorDirty}">
              <TextBlock Text="{DynamicResource Files_Unsaved}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding EditorPath}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsEnvironmentFile}">
          <Button Content="{DynamicResource Files_Reload}" Command="{Binding ReloadEditorCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,4" />
          <Button Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEnvironmentVariablesCommand}" Margin="0,0,8,4" />
          <Button Content="{DynamicResource Files_Save}" Command="{Binding RequestSaveCommand}" IsEnabled="{Binding CanSaveEditor}" Background="{DynamicResource Brush.Accent}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Border Classes="surface" IsVisible="{Binding !IsEnvironmentFile}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource Nav_Environment}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Header_Environment}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid IsVisible="{Binding IsEnvironmentFile}" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource Files_EnvVariables}" Command="{Binding OpenEnvironmentManagerCommand}" Background="{DynamicResource Brush.Info.Subtle}" Foreground="{DynamicResource Brush.Text.Primary}" />
            <Button Content="{DynamicResource Files_EnvRawFile}" Command="{Binding CloseEnvironmentManagerCommand}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding EnvironmentVariables.Count, StringFormat={}{0} variables}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" VerticalAlignment="Center" />
            <CheckBox Content="{DynamicResource Files_BackupBeforeSave}" IsChecked="{Binding CreateBackupBeforeSave}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="surface" Padding="16" ClipToBounds="True">
          <Grid>
            <Grid IsVisible="{Binding IsEnvironmentManagerOpen}" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Files_EnvManagerTitle}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Files_EnvManagerHelp}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="{DynamicResource Files_EnvRevealSecrets}" IsChecked="{Binding RevealEnvironmentSecrets}" VerticalAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8" Margin="8,0">
                <TextBlock Text="{DynamicResource Files_EnvName}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Files_EnvValue}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="" Width="90" />
              </Grid>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EnvVariablesList" ItemsSource="{Binding EnvironmentVariables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvironmentVariableRow">
                      <Border Background="{DynamicResource Brush.Surface.Inset}" BorderBrush="{DynamicResource Brush.Surface.Inset}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="9" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" FontFamily="{DynamicResource Font.Mono}" />
                          <Grid Grid.Column="1">
                            <TextBox Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" PasswordChar="●" IsVisible="{Binding IsValueMasked}" FontFamily="{DynamicResource Font.Mono}" />
                            <TextBox Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" IsVisible="{Binding !IsValueMasked}" FontFamily="{DynamicResource Font.Mono}" />
                          </Grid>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.S}" Padding="6,2" IsVisible="{Binding IsSecret}">
                              <TextBlock Text="{DynamicResource Files_EnvSecret}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="{DynamicResource Common_Delete}"
                                    Command="{Binding #EnvVariablesList.((vm:FilesViewModel)DataContext).RemoveEnvironmentVariableCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding !IsReadOnly}"
                                    Padding="8,4" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="9" IsVisible="{Binding !IsEditorReadOnly}">
                <Grid ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NewEnvironmentKey}" PlaceholderText="{DynamicResource Ui_NEWVARIABLE}" FontFamily="{DynamicResource Font.Mono}" />
                  <TextBox Grid.Column="1" Text="{Binding NewEnvironmentValue}" PlaceholderText="{DynamicResource Ui_Value}" FontFamily="{DynamicResource Font.Mono}" />
                  <Button Grid.Column="2" Content="{DynamicResource Files_EnvAdd}" Command="{Binding AddEnvironmentVariableCommand}" Background="{DynamicResource Brush.Info.Subtle}" Foreground="{DynamicResource Brush.Info}" />
                </Grid>
              </Border>

              <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding EnvironmentManagerMessage}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding EnvironmentManagerValid}" />
                  <TextBlock Text="{Binding EnvironmentManagerMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding !EnvironmentManagerValid}" />
                  <TextBlock Text="{Binding LastBackupPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEnvironmentVariablesCommand}" VerticalAlignment="Center" />
              </Grid>
            </Grid>

            <Grid IsVisible="{Binding IsRawEditorVisible}" RowDefinitions="Auto,*" RowSpacing="10">
              <Border Background="{DynamicResource Brush.Surface.Inset}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="10">
                <TextBlock Text="{DynamicResource Files_SensitiveWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
              </Border>
              <TextBox Foreground="{DynamicResource Brush.Code.Text}" CaretBrush="{DynamicResource Brush.Accent.Text}" Grid.Row="1"
                       Text="{Binding EditorContent}"
                       IsReadOnly="{Binding IsEditorReadOnly}"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource Font.Size.13}"
                       Background="{DynamicResource Brush.Surface.Code}"
                       BorderBrush="{DynamicResource Brush.Border.Subtle}"
                       BorderThickness="1"
                       Padding="16"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding HasPendingSave}">
        <Border Classes="surface" MaxWidth="660" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource Files_ConfirmSave}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PendingSaveMessage}" TextWrapping="Wrap" />
            <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="10">
              <TextBlock Text="{DynamicResource Files_ConflictProtection}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSaveCommand}" />
              <Button Content="{DynamicResource Files_Save}" Command="{Binding ConfirmSaveCommand}" Background="{DynamicResource Brush.Accent}" Foreground="White" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
