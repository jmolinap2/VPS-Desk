<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../VpsDesk.Desktop/Assets/vps-desk.ico</ApplicationIcon>
    <AssemblyName>VPS-Desk-Setup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)"
                      LogicalName="VpsDesk.Payload.zip"
                      Condition="Exists('$(PayloadZip)')" />
  </ItemGroup>
</Project>
