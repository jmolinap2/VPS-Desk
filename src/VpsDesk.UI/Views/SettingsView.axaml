<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             x:Class="VpsDesk.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
      <StackPanel Spacing="3">
        <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Ui_LocalVPSDeskPreferencesPasswordsPrivate}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="surface">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Ui_General}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_LanguageAndRefreshFrequency}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="220,240" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="16">
            <TextBlock Text="{DynamicResource Ui_Language}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage}" />

            <TextBlock Grid.Row="1" Text="{DynamicResource Ui_AutomaticRefresh}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <ComboBox Width="110"
                        ItemsSource="{Binding RefreshIntervalOptions}"
                        SelectedItem="{Binding RefreshIntervalSeconds}" />
              <TextBlock Text="{DynamicResource Ui_Seconds}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Tertiary}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <views:LocalBackupsView />

      <Border Classes="surface">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Ui_RemoteEditing}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_ProtectionsWhenEditingAppsettingsEnvAnd}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Grid.Row="1"
                    IsChecked="{Binding BackupBeforeRemoteSave}"
                    Content="{DynamicResource Ui_CreateABakCopyBeforeOverwriting}" />
        </Grid>
      </Border>

      <Border Classes="surface">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Nav_Terminal}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_InteractiveSSHPreferencesCommandsAndOutput}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="220,260" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
            <TextBlock Text="{DynamicResource Ui_FontSize}" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1"
                           Minimum="11" Maximum="22" Increment="1"
                           Value="{Binding TerminalFontSize}" />

            <TextBlock Grid.Row="1" Text="{DynamicResource Ui_ScrollbackLines}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding TerminalScrollbackOptions}"
                      SelectedItem="{Binding TerminalScrollbackLines}" />

            <TextBlock Grid.Row="2" Text="{DynamicResource Ui_MultilinePaste}" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Grid.Column="1"
                      IsChecked="{Binding ConfirmMultilineTerminalPaste}"
                      Content="{DynamicResource Ui_AskForConfirmationBeforeSending}" />
          </Grid>
        </Grid>
      </Border>

      <Border Classes="surface">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Ui_LocalDataAndDiagnostics}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_VPSDeskStoresProfilesHistoryAnd}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource Ui_PreferencesFile}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SettingsPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Ui_OpenFolder}" Command="{Binding OpenDataFolderCommand}" />

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Ui_ResetPreferences}" Command="{Binding ResetDefaultsCommand}" />
          </Grid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
