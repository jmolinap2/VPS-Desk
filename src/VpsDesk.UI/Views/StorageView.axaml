<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:storage="using:VpsDesk.Domain.Storage"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.StorageView"
             x:DataType="vm:StorageViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
  </UserControl.Resources>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Storage_Title}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Storage_Subtitle}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding LastUpdated}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
        <Button Content="{DynamicResource Storage_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.35*,*,*,*" ColumnSpacing="12">
      <Border Classes="surface" ClipToBounds="True">
        <StackPanel Spacing="7">
          <TextBlock Text="{DynamicResource Storage_RootFilesystem}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Text="{Binding RootUsagePercent, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="{DynamicResource Font.Size.28}"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding RootAvailable, StringFormat={}Libre: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            </StackPanel>
          </Grid>
          <Border Height="8" Background="{DynamicResource Brush.Border.Strong}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding RootUsagePercent}"
                         Foreground="{Binding RootUsagePercent, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="8" />
          </Border>
          <TextBlock Text="{Binding RootUsed, StringFormat={}Usado: {0}}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" />
          <TextBlock Text="{Binding RootTotal, StringFormat={}Total: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="surface" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerImages}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          <TextBlock Text="{Binding ImageCount}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ImagesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="surface" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerVolumes}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          <TextBlock Text="{Binding VolumeCount}" FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VolumesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="3" Classes="surface" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_BuildCache}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          <TextBlock Text="{Binding BuildCacheReclaimable}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_Reclaimable}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="surface" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource Storage_CleanupTitle}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_CleanupHelp}"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"
                     FontSize="{DynamicResource Font.Size.11}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Content="{DynamicResource Storage_CleanBuildCache}"
                  Command="{Binding RequestBuildCacheCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Margin="0,0,8,8" />
          <Button Content="{DynamicResource Storage_CleanUnusedImages}"
                  Command="{Binding RequestUnusedImagesCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Margin="0,0,8,8" />
          <Button Content="{DynamicResource Storage_CleanDockerSystem}"
                  Command="{Binding RequestDockerSystemCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="{DynamicResource Brush.Danger}"
                  Foreground="White"
                  Margin="0,0,8,8" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="0.95*,1.45*,1.05*" ColumnSpacing="14">
      <Border Classes="surface">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Storage_DockerUsage}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="docker system df" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding DockerUsage}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:DockerDiskUsage">
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Size}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Reclaimable}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="surface">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Storage_HeavyDirectories}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Storage_HeavyDirectoriesHelp}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding HeavyDirectories}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:HeavyDirectoryInfo">
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="surface">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Text="{DynamicResource Storage_CleanupOutput}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" />
          <TextBox Foreground="{DynamicResource Brush.Code.Text}" CaretBrush="{DynamicResource Brush.Accent.Text}" Grid.Row="2"
                   Text="{Binding CleanupOutput}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="{DynamicResource Font.Mono}"
                   Background="{DynamicResource Brush.Surface.Code}"
                   BorderThickness="0"
                   Padding="12"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="4" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding HasPendingCleanup}">
      <Border Classes="surface" MaxWidth="620" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="42" Height="42" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1">
              <Path Classes="icon" Data="{StaticResource Icon.Alert}" HorizontalAlignment="Center" VerticalAlignment="Center"  />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding PendingCleanupTitle}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_CleanupConfirmation}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PendingCleanupMessage}" TextWrapping="Wrap" />
          <CheckBox Content="{DynamicResource Storage_IncludeUnusedVolumes}"
                    IsChecked="{Binding IncludeUnusedVolumes}"
                    IsVisible="{Binding ShowIncludeVolumesOption}" />
          <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="10">
            <TextBlock Text="{DynamicResource Storage_CleanupSafety}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.11}" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCleanupCommand}" />
            <Button Content="{DynamicResource Storage_ConfirmCleanup}" Command="{Binding ConfirmCleanupCommand}" Background="{DynamicResource Brush.Danger}" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
