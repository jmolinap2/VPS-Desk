<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:files="using:VpsDesk.Domain.Files"
             x:Class="VpsDesk.Desktop.Views.FilesView"
             x:DataType="vm:FilesViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Files_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Files_Subtitle}" Foreground="#8290A3" FontSize="11" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" Foreground="#8290A3" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Content="↑" Width="38" Command="{Binding GoParentCommand}" IsEnabled="{Binding CanGoParent}" ToolTip.Tip="{DynamicResource Common_Up}" />
        <Button Grid.Column="1" Content="/" Width="38" Command="{Binding GoRootCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Root" />
        <TextBox Grid.Column="2" Text="{Binding CurrentPath}" PlaceholderText="/var/www" FontFamily="Cascadia Mono,Consolas,monospace" />
        <Button Grid.Column="3" Content="{DynamicResource Common_Go}" Command="{Binding NavigatePathCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="4" Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="170,0.9*,6,1.35*" ColumnSpacing="10" ClipToBounds="True">
      <Border Classes="card" Padding="10" ClipToBounds="True">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Files_QuickAccess}" FontSize="13" FontWeight="SemiBold" Margin="4,2,0,8" />
          <Button Content="Home" Command="{Binding GoHomeCommand}" HorizontalContentAlignment="Left" />
          <Button Content="/opt" Command="{Binding GoOptCommand}" HorizontalContentAlignment="Left" />
          <Button Content="/etc" Command="{Binding GoEtcCommand}" HorizontalContentAlignment="Left" />
          <Button Content="/var/log" Command="{Binding GoVarLogCommand}" HorizontalContentAlignment="Left" />
          <Button Content="/srv" Command="{Binding GoSrvCommand}" HorizontalContentAlignment="Left" />
          <Separator Margin="0,8" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" Margin="4,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Margin="14,12,14,8" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource Files_RemoteDirectory}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CurrentPath}" Foreground="#8290A3" FontSize="10" FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="SFTP" Foreground="#7DD3FC" VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="1" Margin="14,0,14,4" ColumnDefinitions="2.1*,0.75*,0.8*,1.15*" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource Files_Name}" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Files_Type}" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{DynamicResource Files_Size}" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Files_Modified}" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
          </Grid>

          <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Margin="8,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="files:RemoteFileEntry">
                <Border CornerRadius="6" Padding="9,7" Margin="0,1" Background="#0E131B">
                  <Grid ColumnDefinitions="2.1*,0.75*,0.8*,1.15*" ColumnSpacing="10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#8290A3" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="#A8B4C5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding LastWriteTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#66758A" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="3" Margin="14,8,14,12" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} elementos}" Foreground="#66758A" FontSize="10" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource Files_OpenSelected}" Command="{Binding OpenSelectedCommand}" IsEnabled="{Binding HasSelection}" />
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="2"
                    ResizeDirection="Columns"
                    Background="#202A38"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <Border Grid.Column="3" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource Files_TextEditor}" FontSize="16" FontWeight="SemiBold" />
                <Border Background="#2A2410" CornerRadius="10" Padding="8,2" IsVisible="{Binding IsEditorDirty}">
                  <TextBlock Text="{DynamicResource Files_Unsaved}" Foreground="#FBBF24" FontSize="9" FontWeight="SemiBold" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding EditorPath}" Foreground="#8290A3" FontSize="10" FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding HasOpenTextFile}">
              <Button Content="{DynamicResource Files_Reload}" Command="{Binding ReloadEditorCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,6,0" />
              <Button Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEditorCommand}" Margin="0,0,6,0" />
              <Button Content="{DynamicResource Files_Save}" Command="{Binding RequestSaveCommand}" IsEnabled="{Binding CanSaveEditor}" Margin="0,0,6,0" Background="#0F766E" Foreground="White" />
              <Button Content="{DynamicResource Files_CloseEditor}" Command="{Binding CloseEditorCommand}" />
            </WrapPanel>
          </Grid>

          <Border Grid.Row="1"
                  Background="#2A2410"
                  BorderBrush="#6B5314"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  IsVisible="{Binding IsSensitiveFile}">
            <TextBlock Text="{DynamicResource Files_SensitiveWarning}" Foreground="#F4D37A" FontSize="10" TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="2">
            <Border Background="#080B10" CornerRadius="8" Padding="16" IsVisible="{Binding !HasOpenTextFile}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{DynamicResource Files_NoEditor}" Foreground="#8290A3" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Files_EditorHelp}" Foreground="#66758A" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
              </StackPanel>
            </Border>

            <TextBox Text="{Binding EditorContent}"
                     IsVisible="{Binding HasOpenTextFile}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="13"
                     Background="#080B10"
                     BorderBrush="#202A38"
                     BorderThickness="1"
                     Padding="16"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasOpenTextFile}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding EditorValidationMessage}" Foreground="#5EEAD4" FontSize="10" IsVisible="{Binding IsEditorValid}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EditorValidationMessage}" Foreground="#F87171" FontSize="10" IsVisible="{Binding !IsEditorValid}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding EditorFileType}" Foreground="#8290A3" FontSize="9" FontWeight="SemiBold" />
                <TextBlock Text="·" Foreground="#465468" FontSize="9" />
                <TextBlock Text="{Binding EditorLineCount, StringFormat={}{0} líneas}" Foreground="#66758A" FontSize="9" />
                <TextBlock Text="·" Foreground="#465468" FontSize="9" />
                <TextBlock Text="{Binding EditorCharacterCount, StringFormat={}{0} caracteres}" Foreground="#66758A" FontSize="9" />
              </StackPanel>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="{DynamicResource Files_BackupBeforeSave}"
                      IsChecked="{Binding CreateBackupBeforeSave}"
                      VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasPendingSave}">
      <Border Classes="card" Width="660" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource Files_ConfirmSave}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PendingSaveMessage}" TextWrapping="Wrap" />
          <Border Background="#101922" CornerRadius="8" Padding="10">
            <TextBlock Text="{DynamicResource Files_ConflictProtection}" Foreground="#8FA5BA" FontSize="10" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSaveCommand}" />
            <Button Content="{DynamicResource Files_Save}" Command="{Binding ConfirmSaveCommand}" Background="#0F766E" Foreground="White" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
