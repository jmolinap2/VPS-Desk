<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:servers="using:VpsDesk.Domain.Servers"
             x:Class="VpsDesk.Desktop.Views.ServersView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <!-- resultado de "Probar conexión": neutro mientras prueba, verde si conecta, rojo si falla -->
    <Style Selector="Border.testResult">
      <Setter Property="Background" Value="#0E131B" />
      <Setter Property="BorderBrush" Value="#1E2735" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.testResult.ok">
      <Setter Property="Background" Value="#0D241F" />
      <Setter Property="BorderBrush" Value="#0F766E" />
    </Style>
    <Style Selector="Border.testResult.failed">
      <Setter Property="Background" Value="#2A1215" />
      <Setter Property="BorderBrush" Value="#B91C1C" />
    </Style>
    <Style Selector="Border.testResult SelectableTextBlock.msg">
      <Setter Property="Foreground" Value="#8290A3" />
    </Style>
    <Style Selector="Border.testResult.ok SelectableTextBlock.msg">
      <Setter Property="Foreground" Value="#7EE7CD" />
    </Style>
    <Style Selector="Border.testResult.failed SelectableTextBlock.msg">
      <Setter Property="Foreground" Value="#FCA5A5" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="24" ColumnDefinitions="340,*" ColumnSpacing="18">
    <Border Classes="card">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel>
          <TextBlock Text="{DynamicResource Servers_Title}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Servers_SavedLocally}" Foreground="#8290A3" FontSize="11" />
        </StackPanel>
        <ListBox Grid.Row="1" Margin="0,16,0,12" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServerInList}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="servers:ServerProfile">
              <Border Padding="10" Margin="0,2" Background="#0E131B" CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Host}" Foreground="#8290A3" FontSize="11" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="{DynamicResource Servers_New}" Command="{Binding NewServerCommand}" />
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Text="{DynamicResource Servers_ConnectionProfile}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Servers_AgentlessHelp}" Foreground="#8290A3" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource Servers_Name}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorName}" PlaceholderText="{DynamicResource Servers_NamePlaceholder}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{DynamicResource Servers_Provider}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorProvider}" PlaceholderText="{DynamicResource Servers_ProviderPlaceholder}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_Host}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorHost}" PlaceholderText="203.0.113.10" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_SshPort}" Foreground="#8290A3" />
              <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding EditorPort}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_Username}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorUsername}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_Environment}" Foreground="#8290A3" />
              <ComboBox ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding EditorEnvironment}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_Authentication}" Foreground="#8290A3" />
              <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding EditorAuthenticationType}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_PrivateKeyPath}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorPrivateKeyPath}" PlaceholderText="C:\Users\you\.ssh\id_ed25519" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_PasswordSession}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorSecret}" PasswordChar="●" />
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource Servers_HostFingerprint}" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorHostKeyFingerprint}" PlaceholderText="SHA256:..." />
              <TextBlock Text="{DynamicResource Servers_HostFingerprintHelp}" Foreground="#66758A" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>

          <Border Classes="testResult" Classes.ok="{Binding ServerTestSucceeded}" Classes.failed="{Binding ServerTestFailed}">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingServer}" Height="3" Foreground="#5EEAD4" />
              <SelectableTextBlock Classes="msg" Text="{Binding ServerEditorMessage}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <WrapPanel>
            <Button Content="{DynamicResource Servers_TestConnection}" Command="{Binding TestServerCommand}" IsEnabled="{Binding !IsTestingServer}" Margin="0,0,10,8" />
            <Button Content="{DynamicResource Servers_SaveProfile}" Command="{Binding SaveServerCommand}" Margin="0,0,10,8" />
            <Button Content="{DynamicResource Servers_UseServer}" Command="{Binding ActivateServerCommand}" Margin="0,0,10,8" />
            <Button Content="{DynamicResource Common_Delete}" Command="{Binding DeleteServerCommand}" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
