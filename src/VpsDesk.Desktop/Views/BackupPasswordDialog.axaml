<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VpsDesk.Desktop.Views.BackupPasswordDialog"
        Width="440" CanResize="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" />
    <TextBlock x:Name="DescriptionText" Foreground="#8290A3" TextWrapping="Wrap" />
    <TextBlock Text="Contraseña" FontWeight="SemiBold" />
    <TextBox x:Name="PasswordInput" PasswordChar="●" />
    <StackPanel x:Name="ConfirmationPanel" Spacing="6">
      <TextBlock Text="Confirmar contraseña" FontWeight="SemiBold" />
      <TextBox x:Name="ConfirmationInput" PasswordChar="●" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Cancelar" Click="Cancel_Click" />
      <Button x:Name="ConfirmButton" Content="Continuar" Classes="primary" Click="Confirm_Click" />
    </StackPanel>
  </StackPanel>
</Window>
