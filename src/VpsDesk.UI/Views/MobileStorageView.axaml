<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:storage="using:VpsDesk.Domain.Storage"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileStorageView"
             x:DataType="vm:StorageViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
  </UserControl.Resources>

  <Grid>
    <ScrollViewer Padding="16,16,16,24">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{DynamicResource Storage_Title}" Classes="t-title" />
            <TextBlock Text="{Binding LastUpdated}" Classes="t-body-s" />
          </StackPanel>
          <Button Grid.Column="1" Classes="btn-icon" AutomationProperties.Name="{DynamicResource Storage_Refresh}" ToolTip.Tip="{DynamicResource Storage_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" VerticalAlignment="Center" ><Path Classes="icon" Data="{StaticResource Icon.Refresh}" /></Button>
        </Grid>

        <!-- disco raíz: porcentaje grande y barra -->
        <Border Classes="surface">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Storage_RootFilesystem}" Classes="t-label" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Text="{Binding RootUsagePercent, StringFormat={}{0:F0}%}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         FontSize="{DynamicResource Font.Size.28}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding RootAvailable, StringFormat={}Libre: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.12}" />
                <TextBlock Text="{Binding RootUsed, StringFormat={}Usado: {0}}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" />
                <TextBlock Text="{Binding RootTotal, StringFormat={}Total: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
              </StackPanel>
            </Grid>
            <Border Height="8" Background="{DynamicResource Brush.Border.Strong}" CornerRadius="{DynamicResource Radius.S}" ClipToBounds="True">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding RootUsagePercent}"
                           Foreground="{Binding RootUsagePercent, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                           Background="Transparent" BorderThickness="0" Height="8" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Docker: tres indicadores en cuadrícula -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
          <Border Classes="surface" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Storage_DockerImages}" Classes="t-label" />
              <TextBlock Text="{Binding ImageCount}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ImagesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="surface" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Storage_DockerVolumes}" Classes="t-label" />
              <TextBlock Text="{Binding VolumeCount}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VolumesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="surface" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Storage_BuildCache}" Classes="t-label" />
              <TextBlock Text="{Binding BuildCacheReclaimable}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_Reclaimable}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- limpieza: las acciones pasan siempre por confirmación -->
        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Storage_CleanupTitle}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_CleanupHelp}" Classes="t-body-s" />
            </StackPanel>
            <Button Classes="btn-secondary" Content="{DynamicResource Storage_CleanBuildCache}" Command="{Binding RequestBuildCacheCleanupCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
            <Button Classes="btn-secondary" Content="{DynamicResource Storage_CleanUnusedImages}" Command="{Binding RequestUnusedImagesCleanupCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
            <Button Classes="btn-danger" Content="{DynamicResource Storage_CleanDockerSystem}" Command="{Binding RequestDockerSystemCleanupCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <Border Classes="surface-inset" Padding="10,8">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource Storage_DockerUsage}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
              <TextBlock Text="docker system df" Classes="t-body-s" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding DockerUsage}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="storage:DockerDiskUsage">
                  <Border Classes="surface-inset" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Size}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Reclaimable}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource Storage_HeavyDirectories}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_HeavyDirectoriesHelp}" Classes="t-body-s" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding HeavyDirectories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="storage:HeavyDirectoryInfo">
                  <Border Classes="surface-inset" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="surface">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Storage_CleanupOutput}" FontSize="{DynamicResource Font.Size.14}" FontWeight="SemiBold" />
            <TextBox Foreground="{DynamicResource Brush.Code.Text}" CaretBrush="{DynamicResource Brush.Accent.Text}" Text="{Binding CleanupOutput}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="{DynamicResource Font.Mono}"
                     FontSize="{DynamicResource Font.Size.11}"
                     Background="{DynamicResource Brush.Surface.Code}"
                     BorderThickness="0"
                     Padding="10"
                     MinHeight="120"
                     MaxHeight="260"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- confirmación de limpieza: hoja inferior -->
    <Border Classes="m-scrim" PointerPressed="OnScrimPressed" Classes.open="{Binding HasPendingCleanup}" />
    <Border Classes="m-sheet" Classes.open="{Binding HasPendingCleanup}" VerticalAlignment="Bottom" Padding="20,18,20,22">
      <StackPanel Spacing="12">
        <Border Classes="sheet-handle" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="48" Height="48" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1">
            <Path Classes="icon" Data="{StaticResource Icon.Alert}" HorizontalAlignment="Center" VerticalAlignment="Center"  />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding PendingCleanupTitle}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Storage_CleanupConfirmation}" Classes="t-body-s" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding PendingCleanupMessage}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
        <CheckBox Content="{DynamicResource Storage_IncludeUnusedVolumes}" IsChecked="{Binding IncludeUnusedVolumes}" IsVisible="{Binding ShowIncludeVolumesOption}" />
        <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Padding="12">
          <TextBlock Text="{DynamicResource Storage_CleanupSafety}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.11}" />
        </Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Classes="btn-secondary" Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCleanupCommand}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Classes="btn-danger" Content="{DynamicResource Storage_ConfirmCleanup}" Command="{Binding ConfirmCleanupCommand}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
