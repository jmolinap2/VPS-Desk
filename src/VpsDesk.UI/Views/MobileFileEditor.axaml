<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             Classes="mature" x:Class="VpsDesk.Desktop.Views.MobileFileEditor"
             x:DataType="vm:FilesViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <!--
    Editor de archivos remotos para teléfono. Lo usan la página Entorno (.env)
    y el editor a pantalla completa de Archivos. Incluye la confirmación de
    guardado como hoja inferior, para que aparezca sobre el editor en ambos sitios.
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- cabecera: badges, ruta y acciones -->
    <Border Grid.Row="0" Classes="surface" Padding="14" Margin="0,0,0,10">
      <StackPanel Spacing="12">
        <WrapPanel>
          <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" Margin="0,0,6,4">
            <TextBlock Text="{Binding EditorFileType}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
          </Border>
          <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" Margin="0,0,6,4" IsVisible="{Binding IsEnvironmentFile}">
            <TextBlock Text=".ENV" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" FontWeight="Bold" />
          </Border>
          <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" Margin="0,0,6,4" IsVisible="{Binding IsEditorReadOnly}">
            <TextBlock Text="{DynamicResource Files_ReadOnlyBadge}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
          </Border>
          <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,3" Margin="0,0,6,4" IsVisible="{Binding IsEditorDirty}">
            <TextBlock Text="{DynamicResource Files_Unsaved}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>

        <TextBlock Text="{Binding EditorPath}" Classes="t-mono" TextTrimming="CharacterEllipsis" />

        <Expander Header="{DynamicResource Files_EditorTools}" HorizontalAlignment="Stretch"><WrapPanel>
          <Button Classes="btn-secondary" Content="{DynamicResource Files_Reload}" Command="{Binding ReloadEditorCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
          <Button Classes="btn-secondary" Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEditorCommand}" IsVisible="{Binding !IsEnvironmentManagerOpen}" Margin="0,0,8,8" />
          <Button Classes="btn-secondary" Content="{DynamicResource Files_EnvVariables}" Command="{Binding OpenEnvironmentManagerCommand}" IsVisible="{Binding IsEnvironmentFile}" Margin="0,0,8,8" />
          <Button Classes="btn-secondary" Content="{DynamicResource Files_EnvRawFile}" Command="{Binding CloseEnvironmentManagerCommand}" IsVisible="{Binding IsEnvironmentFile}" Margin="0,0,8,8" />
          
        </WrapPanel></Expander>
      </StackPanel>
    </Border>

    <!-- avisos: archivo sensible y solo lectura -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
      <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Padding="12" IsVisible="{Binding IsSensitiveFile}">
        <TextBlock Text="{DynamicResource Files_SensitiveWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="surface-inset" IsVisible="{Binding IsEditorReadOnly}">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource Files_ReadOnlyBanner}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
          <Button Classes="btn-secondary" Content="{DynamicResource Files_SwitchToEdit}" Command="{Binding SwitchToEditModeCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- contenido: texto crudo o gestor de variables -->
    <Grid Grid.Row="2">
      <TextBox Foreground="{DynamicResource Brush.Code.Text}" CaretBrush="{DynamicResource Brush.Accent.Text}" Text="{Binding EditorContent}"
               IsReadOnly="{Binding IsEditorReadOnly}"
               IsVisible="{Binding IsRawEditorVisible}"
               AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Files_TextEditor}"
               TextWrapping="NoWrap"
               FontFamily="{DynamicResource Font.Mono}"
               FontSize="{DynamicResource Font.Size.13}"
               Background="{DynamicResource Brush.Surface.Code}"
               BorderBrush="{DynamicResource Brush.Border.Subtle}"
               BorderThickness="1"
               Padding="14"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />

      <ScrollViewer IsVisible="{Binding IsEnvironmentManagerOpen}" VerticalScrollBarVisibility="Auto">
        <views:MobileEnvVariables />
      </ScrollViewer>
    </Grid>

    <!-- validación y opciones -->
    <Border Grid.Row="3" Classes="surface-inset" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding EditorValidationMessage}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding IsEditorValid}" />
        <TextBlock Text="{Binding EditorValidationMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding !IsEditorValid}" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}">
          <Run Text="{Binding EditorLineCount}" /><Run Text="{DynamicResource Ui_Lines}" /><Run Text="{Binding EditorCharacterCount}" /><Run Text="{DynamicResource Ui_Characters}" />
        </TextBlock>
        <Button Classes="btn-primary" Content="{DynamicResource Files_Save}" Command="{Binding RequestSaveCommand}" IsEnabled="{Binding CanSaveEditor}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>

    <!-- confirmación de guardado: hoja inferior sobre el editor -->
    <Border Grid.RowSpan="4" Classes="m-scrim" PointerPressed="OnScrimPressed" Classes.open="{Binding HasPendingSave}" />
    <Border Grid.RowSpan="4" Classes="m-sheet" Classes.open="{Binding HasPendingSave}" VerticalAlignment="Bottom" Padding="20,18,20,22">
      <StackPanel Spacing="12">
        <Border Classes="sheet-handle" />
        <CheckBox Content="{DynamicResource Files_BackupBeforeSave}" IsChecked="{Binding CreateBackupBeforeSave}" />
        <TextBlock Text="{DynamicResource Files_ConfirmSave}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PendingSaveMessage}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
        <Border Classes="surface-inset">
          <TextBlock Text="{DynamicResource Files_ConflictProtection}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
        </Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Classes="btn-secondary" Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSaveCommand}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Classes="btn-primary" Content="{DynamicResource Files_Save}" Command="{Binding ConfirmSaveCommand}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
