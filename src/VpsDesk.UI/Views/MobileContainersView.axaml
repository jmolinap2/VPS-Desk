<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:containers="using:VpsDesk.Domain.Containers"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.MobileContainersView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Contenedores para teléfono (docs/DESIGN_SYSTEM.md). Resumen con contadores, lista de tarjetas y
    una hoja de detalle con las acciones. Las acciones que detienen o reinician piden confirmación
    dentro de la propia hoja. La hoja se cierra con ✕, tocando el fondo o con «atrás».
  -->
  <UserControl.Resources>
    <conv:ContainerStateLabelConverter x:Key="StateLabel" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox#ContainersList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#ContainersList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#ContainersList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Top" Margin="16,12,8,8" ColumnDefinitions="*,Auto">
        <TextBlock Classes="t-body-s" Text="{Binding ContainerModule.StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="btn-icon" Command="{Binding ContainerModule.RefreshCommand}" IsEnabled="{Binding !ContainerModule.IsBusy}"
                AutomationProperties.Name="{DynamicResource Common_Refresh}" ToolTip.Tip="{DynamicResource Common_Refresh}">
          <Path Classes="icon" Data="{StaticResource Icon.Refresh}" />
        </Button>
      </Grid>

      <!-- resumen: texto + punto de color (nunca solo color) -->
      <WrapPanel DockPanel.Dock="Top" Margin="16,0,16,4">
          <Border Classes="status" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Info}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Containers_Total}" />
              <TextBlock Text="{Binding ContainerModule.TotalCount}" Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>
          </Border>
          <Border Classes="status success" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Containers_Running}" />
              <TextBlock Text="{Binding ContainerModule.RunningCount}" />
            </StackPanel>
          </Border>
          <Border Classes="status" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Containers_Stopped}" />
              <TextBlock Text="{Binding ContainerModule.StoppedCount}" Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>
          </Border>
          <Border Classes="status danger" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Containers_Unhealthy}" />
              <TextBlock Text="{Binding ContainerModule.UnhealthyCount}" />
            </StackPanel>
          </Border>
      </WrapPanel>

      <!-- lista de contenedores: tarjetas de ancho completo -->
      <ScrollViewer Margin="16,0,16,16">
        <ListBox x:Name="ContainersList" ItemsSource="{Binding ContainerModule.Items}" SelectedItem="{Binding ContainerModule.SelectedContainer}"
                 Background="Transparent" Padding="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="containers:DockerContainerInfo">
              <Border Classes="surface" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Panel VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Success}" IsVisible="{Binding IsRunning}" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Text.Tertiary}" IsVisible="{Binding !IsRunning}" />
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Classes="t-body" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Classes="t-label">
                        <Run Text="CPU " /><Run Text="{Binding CpuPercent, StringFormat={}{0:F1}%}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                      </TextBlock>
                      <TextBlock Classes="t-label">
                        <Run Text="RAM " /><Run Text="{Binding MemoryPercent, StringFormat={}{0:F1}%}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="status" IsVisible="{Binding !IsRunning}">
                      <TextBlock Text="{Binding State, Converter={StaticResource StateLabel}}" />
                    </Border>
                    <Path Classes="icon tertiary" Data="{StaticResource Icon.ChevronRight}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </DockPanel>

    <!-- scrim -->
    <Border Classes="m-scrim" Classes.open="{Binding ContainerModule.HasSelection}" PointerPressed="OnScrimPointerPressed" />

    <!-- hoja de detalle -->
    <Border Classes="m-sheet" Classes.open="{Binding ContainerModule.HasSelection}" VerticalAlignment="Bottom" MaxHeight="640">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="sheet-handle" Margin="0,10,0,4" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20,4,20,24" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="44" Height="44" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.Accent.Subtle}" VerticalAlignment="Center">
                <Path Classes="icon accent" Data="{StaticResource Icon.Box}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Classes="t-headline" Text="{Binding ContainerModule.SelectedContainer.Name}" TextTrimming="CharacterEllipsis" />
                <Border Classes="status" HorizontalAlignment="Left"
                        Classes.success="{Binding ContainerModule.SelectedContainer.IsRunning}">
                  <TextBlock Text="{Binding ContainerModule.SelectedContainer.State, Converter={StaticResource StateLabel}}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="2" Classes="btn-icon" Click="OnCloseSheetClick"
                      AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}">
                <Path Classes="icon" Data="{StaticResource Icon.Close}" />
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <Border Classes="surface-inset" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Classes="t-overline" Text="CPU" HorizontalAlignment="Center" />
                  <TextBlock Classes="t-headline" Text="{Binding ContainerModule.SelectedContainer.CpuPercent, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="surface-inset" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Classes="t-overline" Text="{DynamicResource Containers_Memory}" HorizontalAlignment="Center" />
                  <TextBlock Classes="t-body-s" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding ContainerModule.SelectedContainer.MemoryUsage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="surface-inset" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Classes="t-overline" Text="{DynamicResource Containers_Health}" HorizontalAlignment="Center" />
                  <TextBlock Classes="t-body-s" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding ContainerModule.SelectedContainer.Health}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Classes="t-label" Text="{DynamicResource Containers_Network}" />
                <TextBlock Grid.Column="1" Classes="t-body-s" Text="{Binding ContainerModule.SelectedContainer.NetworkIo}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Classes="t-label" Text="{DynamicResource Containers_Ports}" />
                <TextBlock Grid.Column="1" Classes="t-mono" Text="{Binding ContainerModule.SelectedContainer.Ports}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>

            <!-- acciones: reiniciar es la principal; detener es destructiva y pide confirmación -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Padding="8,0" Content="{DynamicResource Common_Start}"
                      Command="{Binding ContainerModule.RequestStartCommand}" IsEnabled="{Binding ContainerModule.CanStartSelected}" />
              <Button Grid.Column="1" Classes="btn-danger" HorizontalAlignment="Stretch" Padding="8,0" Content="{DynamicResource Common_Stop}"
                      Command="{Binding ContainerModule.RequestStopCommand}" IsEnabled="{Binding ContainerModule.CanStopSelected}" />
              <Button Grid.Column="2" Classes="btn-primary" HorizontalAlignment="Stretch" Padding="8,0" Content="{DynamicResource Common_Restart}"
                      Command="{Binding ContainerModule.RequestRestartCommand}" IsEnabled="{Binding ContainerModule.CanRestartSelected}" />
            </Grid>

            <!-- confirmación de la acción pedida -->
            <Border Classes="surface-inset" Background="{DynamicResource Brush.Warning.Subtle}" IsVisible="{Binding ContainerModule.HasPendingAction}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Path Classes="icon warning" Data="{StaticResource Icon.Alert}" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Classes="t-body-s warning" Text="{Binding ContainerModule.PendingActionMessage}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Button Classes="btn-secondary" MinWidth="110" Content="{DynamicResource Common_Cancel}" Command="{Binding ContainerModule.CancelActionCommand}" />
                  <Button Grid.Column="1" Classes="btn-primary" HorizontalAlignment="Stretch" Content="{DynamicResource Containers_ConfirmAction}"
                          Command="{Binding ContainerModule.ConfirmActionCommand}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="t-label" Text="{DynamicResource Containers_SafetyNote}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
