<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:views="using:VpsDesk.Desktop.Views"
             x:Class="VpsDesk.Desktop.Views.MainView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Host para plataformas de "single view" (Android, iOS, navegador):
    usa MobileShell (barra superior + cajón de navegación) en vez del
    MainShell de escritorio (sidebar fija de 250px, que no entra en una
    pantalla de teléfono).
  -->
  <views:MobileShell />
</UserControl>
