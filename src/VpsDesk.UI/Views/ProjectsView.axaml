<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:services="using:VpsDesk.Desktop.Services"
             x:Class="VpsDesk.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Border Classes="surface" Padding="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Ui_ActiveProject}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ActiveProjectName}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ActiveProjectPath}" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Font.Size.11}" />
          <TextBlock Text="{Binding ActiveProjectMode}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{DynamicResource Ui_UseSelected}"
                  Command="{Binding ActivateSelectedCommand}"
                  IsEnabled="{Binding HasActiveProject}" />
          <Button Content="{DynamicResource Ui_DiscoverProjects}"
                  Command="{Binding DiscoverCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="{DynamicResource Brush.Accent}"
                  Foreground="White"
                  FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="0.9*,1.35*" ColumnSpacing="14">
      <Border Classes="surface" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource Ui_AssociatedProjects}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_EachProjectKeepsItsPathBranch}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding AssociatedProjects}"
                   SelectedItem="{Binding SelectedProject}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="services:ProjectWorkspace">
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="11" Margin="0,3">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" />
                    </Grid>
                    <TextBlock Text="{Binding RemoteRepositoryPath}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               FontSize="{DynamicResource Font.Size.11}"
                               FontFamily="{DynamicResource Font.Mono}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CapabilitySummary}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{DynamicResource Ui_SelectAProjectToChangeThe}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Ui_RemoveAssociation}"
                    Command="{Binding RemoveSelectedCommand}"
                    IsEnabled="{Binding HasActiveProject}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="surface" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource Ui_DiscoveredOnTheVPS}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_VPSDeskFindsGitRepositoriesWith}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding DiscoveredProjects}"
                   SelectedItem="{Binding SelectedDiscovery}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectDiscoveryItem">
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="12" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Size.14}" />
                      <TextBlock Text="{Binding RemoteRepositoryPath}"
                                 Foreground="{DynamicResource Brush.Text.Tertiary}"
                                 FontSize="{DynamicResource Font.Size.11}"
                                 FontFamily="{DynamicResource Font.Mono}" />
                      <TextBlock Text="{Binding CapabilitySummary}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{DynamicResource Ui_Branch}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                        <TextBlock Text="{Binding Branch}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                        <TextBlock Text="{DynamicResource Ui_Compose}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" Margin="5,0,0,0" />
                        <TextBlock Text="{Binding ComposeFile}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                      <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,4">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" />
                      </Border>
                      <TextBlock Text="{DynamicResource Ui_Associated}"
                                 IsVisible="{Binding AlreadyAssociated}"
                                 Foreground="{DynamicResource Brush.Info}"
                                 FontSize="{DynamicResource Font.Size.11}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource Ui_StandardModeWorksWithoutASpecial}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Ui_AssociateProject}"
                    Command="{Binding AssociateSelectedCommand}"
                    IsEnabled="{Binding HasDiscoveredProjects}"
                    Background="{DynamicResource Brush.Accent}"
                    Foreground="White"
                    FontWeight="SemiBold" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
