<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:storage="using:VpsDesk.Domain.Storage"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.StorageView"
             x:DataType="vm:StorageViewModel">
  <UserControl.Resources>
    <conv:UsageToBrushConverter x:Key="UsageToBrush" />
  </UserControl.Resources>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Storage_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Storage_Subtitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding LastUpdated}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        <Button Content="{DynamicResource Storage_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.35*,*,*,*" ColumnSpacing="12">
      <Border Classes="card" ClipToBounds="True">
        <StackPanel Spacing="7">
          <TextBlock Text="{DynamicResource Storage_RootFilesystem}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Text="{Binding RootUsagePercent, StringFormat={}{0:F0}%}"
                       Foreground="{Binding RootUsagePercent, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding RootAvailable, StringFormat={}Libre: {0}}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
            </StackPanel>
          </Grid>
          <Border Height="8" Background="#27303D" CornerRadius="4" ClipToBounds="True">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding RootUsagePercent}"
                         Foreground="{Binding RootUsagePercent, Converter={StaticResource UsageToBrush}, ConverterParameter=disk}"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="8" />
          </Border>
          <TextBlock Text="{Binding RootUsed, StringFormat={}Usado: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
          <TextBlock Text="{Binding RootTotal, StringFormat={}Total: {0}}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerImages}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
          <TextBlock Text="{Binding ImageCount}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ImagesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_DockerVolumes}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
          <TextBlock Text="{Binding VolumeCount}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VolumesReclaimable, StringFormat={}Recuperable: {0}}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="3" Classes="card" ClipToBounds="True">
        <StackPanel Spacing="5">
          <TextBlock Text="{DynamicResource Storage_BuildCache}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
          <TextBlock Text="{Binding BuildCacheReclaimable}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_Reclaimable}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="card" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource Storage_CleanupTitle}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Storage_CleanupHelp}"
                     Foreground="{DynamicResource TextFaintBrush}"
                     FontSize="11"
                     TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Content="{DynamicResource Storage_CleanBuildCache}"
                  Command="{Binding RequestBuildCacheCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Margin="0,0,8,8" />
          <Button Content="{DynamicResource Storage_CleanUnusedImages}"
                  Command="{Binding RequestUnusedImagesCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Margin="0,0,8,8" />
          <Button Content="Liberar espacio Docker"
                  Command="{Binding RequestDockerSystemCleanupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="{DynamicResource DangerSurfaceBrush}"
                  Foreground="White"
                  Margin="0,0,8,8" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="0.95*,1.45*,1.05*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Storage_DockerUsage}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="docker system df" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding DockerUsage}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:DockerDiskUsage">
                <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Size}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Reclaimable}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource Storage_HeavyDirectories}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_HeavyDirectoriesHelp}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Analizar ahora"
                    Command="{Binding ScanHeavyDirectoriesCommand}"
                    IsEnabled="{Binding !IsScanningHeavyDirectories}" />
          </Grid>
          <TextBlock Grid.Row="1"
                     Text="{Binding HeavyDirectoriesStatus}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="11"
                     TextWrapping="Wrap" />
          <ListBox Grid.Row="2" ItemsSource="{Binding HeavyDirectories}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="storage:HeavyDirectoryInfo">
                <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Text="{DynamicResource Storage_CleanupOutput}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          <TextBox Grid.Row="2"
                   Text="{Binding CleanupOutput}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Background="{DynamicResource SurfaceInputBrush}"
                   BorderThickness="0"
                   Padding="12"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="4" Background="#B0000000" IsVisible="{Binding HasPendingCleanup}">
      <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="42" Height="42" CornerRadius="21" Background="#3A2412" BorderBrush="#A16207" BorderThickness="1">
              <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding PendingCleanupTitle}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Storage_CleanupConfirmation}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PendingCleanupMessage}" TextWrapping="Wrap" />
          <CheckBox Content="{DynamicResource Storage_IncludeUnusedVolumes}"
                    IsChecked="{Binding IncludeUnusedVolumes}"
                    IsVisible="{Binding ShowIncludeVolumesOption}" />
          <Border Background="#15100D" BorderBrush="#4B3525" BorderThickness="1" CornerRadius="8" Padding="10">
            <TextBlock Text="{DynamicResource Storage_CleanupSafety}" Foreground="#D6B98C" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCleanupCommand}" />
            <Button Content="{DynamicResource Storage_ConfirmCleanup}" Command="{Binding ConfirmCleanupCommand}" Background="{DynamicResource DangerSurfaceBrush}" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
