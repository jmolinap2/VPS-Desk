<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:servers="using:VpsDesk.Domain.Servers"
             x:Class="VpsDesk.Desktop.Views.MobileServersView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Servidores para teléfono. Una sola columna: lista de tarjetas arriba y, al
    tocar una, una hoja inferior con el editor. La vista de escritorio usa dos
    columnas fijas de 340px + resto, que en un teléfono dejaba el editor fuera
    de pantalla. El mensaje de estado (resultado de Probar conexión, errores de
    SSH) se muestra arriba, siempre visible.
  -->
  <UserControl.Styles>
    <!-- tarjeta de servidor con retroalimentación al tocar -->
    <Style Selector="Button.serverCard">
      <Setter Property="Background" Value="#121826" />
      <Setter Property="BorderBrush" Value="#1E2735" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.serverCard:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>

    <Style Selector="Button.sheetAction">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0,12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- resultado de "Probar conexion": neutro mientras prueba, verde si conecta, rojo si falla -->
    <Style Selector="Border.testResult">
      <Setter Property="Background" Value="#101B2A" />
      <Setter Property="BorderBrush" Value="#294A70" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.testResult.ok">
      <Setter Property="Background" Value="#0D241F" />
      <Setter Property="BorderBrush" Value="#0F766E" />
    </Style>
    <Style Selector="Border.testResult.failed">
      <Setter Property="Background" Value="#2A1215" />
      <Setter Property="BorderBrush" Value="#B91C1C" />
    </Style>
    <Style Selector="Border.testResult TextBlock.msg">
      <Setter Property="Foreground" Value="#9CC8F5" />
    </Style>
    <Style Selector="Border.testResult.ok TextBlock.msg">
      <Setter Property="Foreground" Value="#7EE7CD" />
    </Style>
    <Style Selector="Border.testResult.failed TextBlock.msg">
      <Setter Property="Foreground" Value="#FCA5A5" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
      <!-- cabecera y estado -->
      <StackPanel DockPanel.Dock="Top" Margin="18,16,18,12" Spacing="10">
        <StackPanel>
          <TextBlock Text="{DynamicResource Servers_Title}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Servers_SavedLocally}" FontSize="11" Foreground="#6B7686" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="#0E1219" BorderBrush="#1E2735" BorderThickness="1" CornerRadius="12" Padding="12,10">
          <TextBlock Text="{Binding ServerEditorMessage}" FontSize="12" Foreground="#9AA4B2" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <!-- botón principal de alta, fijo al pie -->
      <Border DockPanel.Dock="Bottom" Padding="18,10,18,18" Background="#0B0E14" BorderBrush="#1A2130" BorderThickness="0,1,0,0">
        <Button Content="{DynamicResource Servers_New}" Click="OnNewServerClick"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="0,13" CornerRadius="14" Background="#0F766E" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
      </Border>

      <!-- lista de tarjetas -->
      <ScrollViewer Margin="18,0,18,0">
        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="servers:ServerProfile">
              <Button Classes="serverCard" Click="OnServerCardClick" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,14">
                  <Border Width="38" Height="38" CornerRadius="12" Background="#0F241C" BorderBrush="#1C4433" BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="&#9638;" FontSize="16" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11.5" Foreground="#6B7686" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Username}" /><Run Text="@" /><Run Text="{Binding Host}" /><Run Text=":" /><Run Text="{Binding Port}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="&#8250;" FontSize="18" Foreground="#4A5568" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- scrim -->
    <Border x:Name="Scrim" Classes="m-scrim" PointerPressed="OnScrimPointerPressed" />

    <!-- hoja del editor -->
    <Border x:Name="Sheet" Classes="m-sheet" VerticalAlignment="Bottom" MaxHeight="640">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="0">
          <Border Width="40" Height="4" CornerRadius="2" Background="#2A3444" Margin="0,10,0,6" HorizontalAlignment="Center" />
          <Grid ColumnDefinitions="*,Auto" Margin="20,4,14,8">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Servers_ConnectionProfile}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedServerInList.Name}"
                         FontSize="11" Foreground="#6B7686" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Common_Close}" Click="OnCloseSheetClick"
                    Background="Transparent" BorderThickness="0" Padding="10,6" Foreground="#9AA4B2" />
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,4,20,8">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_Name}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorName}" PlaceholderText="{DynamicResource Servers_NamePlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_Provider}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorProvider}" PlaceholderText="{DynamicResource Servers_ProviderPlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_Host}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorHost}" PlaceholderText="203.0.113.10" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Servers_SshPort}" FontSize="11" Foreground="#8290A3" />
                <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding EditorPort}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource Servers_Username}" FontSize="11" Foreground="#8290A3" />
                <TextBox Text="{Binding EditorUsername}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Servers_Environment}" FontSize="11" Foreground="#8290A3" />
                <ComboBox ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding EditorEnvironment}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource Servers_Authentication}" FontSize="11" Foreground="#8290A3" />
                <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding EditorAuthenticationType}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_PrivateKeyPath}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorPrivateKeyPath}" PlaceholderText="C:\Users\you\.ssh\id_ed25519" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_PasswordSession}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorSecret}" PasswordChar="●" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Servers_HostFingerprint}" FontSize="11" Foreground="#8290A3" />
              <TextBox Text="{Binding EditorHostKeyFingerprint}" PlaceholderText="SHA256:..." />
              <TextBlock Text="{DynamicResource Servers_HostFingerprintHelp}" FontSize="10" Foreground="#66758A" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8" Margin="20,8,20,20">
          <!-- resultado visible junto a los botones: la tarjeta de la pagina queda tapada por la hoja -->
          <Border Classes="testResult" Classes.ok="{Binding ServerTestSucceeded}" Classes.failed="{Binding ServerTestFailed}">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingServer}" Height="3" Foreground="#5EEAD4" />
              <TextBlock Classes="msg" Text="{Binding ServerEditorMessage}" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Classes="sheetAction" Content="{DynamicResource Servers_TestConnection}" Command="{Binding TestServerCommand}"
                  IsEnabled="{Binding !IsTestingServer}" HorizontalAlignment="Stretch" Click="OnActionClick" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Classes="sheetAction" Content="{DynamicResource Servers_SaveProfile}" Command="{Binding SaveServerCommand}"
                    HorizontalAlignment="Stretch" Click="OnActionClick" />
            <Button Grid.Column="1" Classes="sheetAction" Content="{DynamicResource Servers_UseServer}" Command="{Binding ActivateServerCommand}"
                    HorizontalAlignment="Stretch" Background="#0F766E" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                    Click="OnActivateClick" />
          </Grid>
          <Button Classes="sheetAction" Content="{DynamicResource Common_Delete}" Command="{Binding DeleteServerCommand}"
                  HorizontalAlignment="Stretch" Background="#2A1416" BorderBrush="#4A1F22" Foreground="#F87171"
                  Click="OnDeleteClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
