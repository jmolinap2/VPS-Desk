<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             xmlns:files="using:VpsDesk.Domain.Files"
             xmlns:conv="using:VpsDesk.Desktop.Converters"
             x:Class="VpsDesk.Desktop.Views.FilesView"
             x:DataType="vm:FilesViewModel" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}">
  <UserControl.Resources>
    <conv:FileCategoryBrushConverter x:Key="CategoryBrush" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.explorer-row">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource Motion.Quick}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.explorer-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    </Style>
    <Style Selector="StackPanel.row-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource Motion.Quick}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.explorer-row:pointerover StackPanel.row-actions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.explorer-row:focus-within StackPanel.row-actions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.row-action">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.S}" />
    </Style>
    <Style Selector="Button.row-action-edit">
      <Setter Property="Background" Value="{DynamicResource Brush.Info.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
    </Style>
    <Style Selector="Border.editor-surface">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource Motion.Quick}" />
        </Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Files_Title}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Files_Subtitle}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Classes="surface" Padding="10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Classes="btn-icon" Command="{Binding GoParentCommand}" IsEnabled="{Binding CanGoParent}" ToolTip.Tip="{DynamicResource Common_Up}" AutomationProperties.Name="{DynamicResource Common_Up}"><Path Classes="icon" Data="{StaticResource Icon.ArrowUp}" /></Button>
        <Button Grid.Column="1" Content="/" Width="38" Command="{Binding GoRootCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Root" />
        <TextBox Grid.Column="2" Text="{Binding CurrentPath}" PlaceholderText="/var/www" FontFamily="{DynamicResource Font.Mono}" />
        <Button Grid.Column="3" Content="{DynamicResource Common_Go}" Command="{Binding NavigatePathCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="4" Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="176,*" ColumnSpacing="12" ClipToBounds="True">
      <Border Classes="surface" Padding="10" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Files_QuickAccess}" FontSize="{DynamicResource Font.Size.13}" FontWeight="SemiBold" Margin="4,2,0,8" />
            <Button Content="{DynamicResource Ui_Home}" Command="{Binding GoHomeCommand}" HorizontalContentAlignment="Left" />
            <Button Content="/opt" Command="{Binding GoOptCommand}" HorizontalContentAlignment="Left" />
            <Button Content="/etc" Command="{Binding GoEtcCommand}" HorizontalContentAlignment="Left" />
            <Button Content="/var/log" Command="{Binding GoVarLogCommand}" HorizontalContentAlignment="Left" />
            <Button Content="/srv" Command="{Binding GoSrvCommand}" HorizontalContentAlignment="Left" />
          </StackPanel>
          <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="9" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="surface editor-surface" Padding="0" ClipToBounds="True" IsVisible="{Binding !HasOpenTextFile}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Margin="16,14,16,9" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource Files_RemoteDirectory}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CurrentPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Info.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="SFTP" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
            </Border>
          </Grid>

          <Grid Grid.Row="1" Margin="16,0,16,5" ColumnDefinitions="2.1*,0.55*,0.6*,1.0*,1.6*" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource Files_Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Files_Type}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{DynamicResource Files_Size}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Files_Modified}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="" />
          </Grid>

          <ListBox Grid.Row="2" x:Name="EntriesList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Margin="8,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="files:RemoteFileEntry">
                <Border Classes="explorer-row" CornerRadius="{DynamicResource Radius.S}" Padding="10,8" Margin="0,1" Background="{DynamicResource Brush.Surface.Inset}" Focusable="True">
                  <Grid ColumnDefinitions="2.1*,0.55*,0.6*,1.0*,1.6*" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius.S}"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=tint}">
                        <Panel Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsDirectory}">
                            <Border Canvas.Left="1.5" Canvas.Top="3" Width="6" Height="2.3" CornerRadius="{DynamicResource Radius.XL.Top}" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <Border Canvas.Left="1.5" Canvas.Top="5" Width="13" Height="8.5" CornerRadius="{DynamicResource Radius.S}" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsScriptFile}">
                            <Polygon Points="4,3 4,13 13,8" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsConfigFile}">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <Ellipse Canvas.Left="5.2" Canvas.Top="5.2" Width="5.6" Height="5.6" Fill="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=tint}" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsImageFile}">
                            <Border Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12" CornerRadius="{DynamicResource Radius.S}" BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}" BorderThickness="1.3" />
                            <Ellipse Canvas.Left="4" Canvas.Top="4.5" Width="2.6" Height="2.6" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <Polygon Points="2.5,12.5 7,7 9.5,10 12,7.5 13.5,12.5" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsArchiveFile}">
                            <Border Canvas.Left="1.5" Canvas.Top="3" Width="13" Height="2.6" CornerRadius="{DynamicResource Radius.XL.Top}" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <Border Canvas.Left="2.3" Canvas.Top="6" Width="11.4" Height="7.5" CornerRadius="{DynamicResource Radius.XL.Top}" BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}" BorderThickness="1.2" />
                            <Line StartPoint="8,6.5" EndPoint="8,11" Stroke="{Binding Category, Converter={StaticResource CategoryBrush}}" StrokeThickness="1.2" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsBinaryFile}">
                            <Border Canvas.Left="3" Canvas.Top="1.5" Width="10" Height="13" CornerRadius="{DynamicResource Radius.S}" BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}" BorderThickness="1.3" />
                            <Line StartPoint="3,14" EndPoint="13,1.5" Stroke="{Binding Category, Converter={StaticResource CategoryBrush}}" StrokeThickness="1.4" StrokeLineCap="Round" />
                          </Canvas>
                          <Canvas Width="16" Height="16" IsVisible="{Binding IsPlainTextFile}">
                            <Border Canvas.Left="3" Canvas.Top="1.5" Width="10" Height="13" CornerRadius="{DynamicResource Radius.S}" BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}" BorderThickness="1.3" />
                            <Border Canvas.Left="5.2" Canvas.Top="6" Width="5.6" Height="1.3" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <Border Canvas.Left="5.2" Canvas.Top="9" Width="3.8" Height="1.3" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                          </Canvas>
                        </Panel>
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{DynamicResource Files_NoPreview}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" IsVisible="{Binding HasNoPreview}" />
                          <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.S}" Padding="6,1" IsVisible="{Binding IsSensitive}">
                            <TextBlock Text="{DynamicResource Files_Sensitive}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding LastWriteTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Classes="row-actions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{DynamicResource Files_OpenFolder}" Classes="row-action" IsVisible="{Binding IsDirectory}" Command="{Binding #EntriesList.((vm:FilesViewModel)DataContext).PreviewEntryCommand}" CommandParameter="{Binding}" />
                      <Button Content="{DynamicResource Files_View}" Classes="row-action" IsVisible="{Binding CanPreview}" Command="{Binding #EntriesList.((vm:FilesViewModel)DataContext).PreviewEntryCommand}" CommandParameter="{Binding}" />
                      <Button Content="{DynamicResource Files_Edit}" Classes="row-action row-action-edit" IsVisible="{Binding CanEdit}" Command="{Binding #EntriesList.((vm:FilesViewModel)DataContext).EditEntryCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="3" Margin="16,9,16,13" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} elementos}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
              <TextBlock Text="·" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
              <TextBlock Text="{Binding LastUpdated}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Files_OpenSelected}" Command="{Binding OpenSelectedCommand}" IsEnabled="{Binding HasSelection}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="surface editor-surface" ClipToBounds="True" IsVisible="{Binding HasOpenTextFile}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Classes="btn-icon" Command="{Binding CloseEditorCommand}" ToolTip.Tip="{DynamicResource Files_CloseEditor}" AutomationProperties.Name="{DynamicResource Files_CloseEditor}"><Path Classes="icon" Data="{StaticResource Icon.ArrowLeft}" /></Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource Files_TextEditor}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.M}" Padding="8,2">
                  <TextBlock Text="{Binding EditorFileType}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                </Border>
                <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.M}" Padding="8,2" IsVisible="{Binding IsEditorReadOnly}">
                  <TextBlock Text="{DynamicResource Files_ReadOnlyBadge}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                </Border>
                <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.M}" Padding="8,2" IsVisible="{Binding IsEditorDirty}">
                  <TextBlock Text="{DynamicResource Files_Unsaved}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding EditorPath}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" IsVisible="{Binding IsEnvironmentFile}" Margin="0,0,8,0">
                <Button Content="{DynamicResource Files_EnvVariables}" Command="{Binding OpenEnvironmentManagerCommand}" Margin="0,0,4,0" />
                <Button Content="{DynamicResource Files_EnvRawFile}" Command="{Binding CloseEnvironmentManagerCommand}" />
              </StackPanel>
              <Button Content="{DynamicResource Files_Reload}" Command="{Binding ReloadEditorCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,6,0" />
              <Button Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEditorCommand}" Margin="0,0,6,0" IsVisible="{Binding !IsEnvironmentManagerOpen}" />
              <Button Content="{DynamicResource Files_Save}" Command="{Binding RequestSaveCommand}" IsEnabled="{Binding CanSaveEditor}" Background="{DynamicResource Brush.Accent}" Foreground="White" />
            </WrapPanel>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="8">
            <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="10" IsVisible="{Binding IsSensitiveFile}">
              <TextBlock Text="{DynamicResource Files_SensitiveWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource Brush.Surface.Inset}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="10" IsVisible="{Binding IsEditorReadOnly}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource Files_ReadOnlyBanner}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{DynamicResource Files_SwitchToEdit}" Command="{Binding SwitchToEditModeCommand}" Margin="10,0,0,0" />
              </Grid>
            </Border>
          </StackPanel>

          <Grid Grid.Row="2">
            <TextBox Foreground="{DynamicResource Brush.Code.Text}" CaretBrush="{DynamicResource Brush.Accent.Text}" Text="{Binding EditorContent}" IsReadOnly="{Binding IsEditorReadOnly}" IsVisible="{Binding IsRawEditorVisible}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Font.Size.13}" Background="{DynamicResource Brush.Surface.Code}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <Border IsVisible="{Binding IsEnvironmentManagerOpen}" Background="{DynamicResource Brush.Surface.Code}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.S}" Padding="14">
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Files_EnvManagerTitle}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Files_EnvManagerHelp}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" Content="{DynamicResource Files_EnvRevealSecrets}" IsChecked="{Binding RevealEnvironmentSecrets}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource Files_EnvName}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource Files_EnvValue}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="" Width="74" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="EnvVariablesList" ItemsSource="{Binding EnvironmentVariables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EnvironmentVariableRow">
                        <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="8" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" FontFamily="{DynamicResource Font.Mono}" />
                            <Grid Grid.Column="1">
                              <TextBox Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" PasswordChar="●" IsVisible="{Binding IsValueMasked}" FontFamily="{DynamicResource Font.Mono}" />
                              <TextBox Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" IsVisible="{Binding !IsValueMasked}" FontFamily="{DynamicResource Font.Mono}" />
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="{DynamicResource Radius.S}" Padding="6,2" IsVisible="{Binding IsSecret}">
                                <TextBlock Text="{DynamicResource Files_EnvSecret}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Font.Size.11}" FontWeight="SemiBold" />
                              </Border>
                              <Button Content="{DynamicResource Common_Delete}" Command="{Binding #EnvVariablesList.((vm:FilesViewModel)DataContext).RemoveEnvironmentVariableCommand}" CommandParameter="{Binding}" Padding="8,4" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="9" IsVisible="{Binding !IsEditorReadOnly}">
                  <Grid ColumnDefinitions="0.9*,1.5*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding NewEnvironmentKey}" PlaceholderText="{DynamicResource Ui_NEWVARIABLE}" FontFamily="{DynamicResource Font.Mono}" />
                    <TextBox Grid.Column="1" Text="{Binding NewEnvironmentValue}" PlaceholderText="{DynamicResource Ui_Value}" FontFamily="{DynamicResource Font.Mono}" />
                    <Button Grid.Column="2" Content="{DynamicResource Files_EnvAdd}" Command="{Binding AddEnvironmentVariableCommand}" Background="{DynamicResource Brush.Info.Subtle}" Foreground="{DynamicResource Brush.Info}" />
                  </Grid>
                </Border>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding EnvironmentManagerMessage}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding EnvironmentManagerValid}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding EnvironmentManagerMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" IsVisible="{Binding !EnvironmentManagerValid}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{DynamicResource Files_Validate}" Command="{Binding ValidateEnvironmentVariablesCommand}" />
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding EditorValidationMessage}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="{DynamicResource Font.Size.11}" IsVisible="{Binding IsEditorValid}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EditorValidationMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="{DynamicResource Font.Size.11}" IsVisible="{Binding !IsEditorValid}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding EditorLineCount, StringFormat={}{0} líneas}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                <TextBlock Text="·" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
                <TextBlock Text="{Binding EditorCharacterCount, StringFormat={}{0} caracteres}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" />
              </StackPanel>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="{DynamicResource Files_BackupBeforeSave}" IsChecked="{Binding CreateBackupBeforeSave}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="3" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding HasPendingSave}">
      <Border Classes="surface" MaxWidth="660" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource Files_ConfirmSave}" FontSize="{DynamicResource Font.Size.20}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PendingSaveMessage}" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="10">
            <TextBlock Text="{DynamicResource Files_ConflictProtection}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.11}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelSaveCommand}" />
            <Button Content="{DynamicResource Files_Save}" Command="{Binding ConfirmSaveCommand}" Background="{DynamicResource Brush.Accent}" Foreground="White" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding HasImagePreview}">
      <Border Classes="surface" MaxWidth="420" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ImagePreviewName}" FontSize="{DynamicResource Font.Size.16}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Classes="btn-icon" Grid.Column="1" Command="{Binding CloseImagePreviewCommand}" AutomationProperties.Name="{DynamicResource Common_Close}" ToolTip.Tip="{DynamicResource Common_Close}"><Path Classes="icon" Data="{StaticResource Icon.Close}" /></Button>
          </Grid>
          <Border Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="{DynamicResource Radius.S}" Padding="6">
            <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxHeight="300" />
          </Border>
          <TextBlock Text="{Binding ImagePreviewMeta}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource Font.Size.11}" FontFamily="{DynamicResource Font.Mono}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>