# VPS Desk local configuration
# Copy this file to .env and replace the example values.
# Never commit .env with real credentials.

SERVER_HOST=example.com
SERVER_USER=root
SSH_PORT=22
SSH_KEY_PATH=C:\Users\YOUR_USER\.ssh\id_ed25519

# Local project that contains your deploy or migration scripts.
REPO_LOCAL=C:\Repos\your-app

# Remote project location on the VPS.
REMOTE_REPO_PATH=/home/your-user/your-app
COMPOSE_FILE=docker-compose.yml

# Optional. Leave empty unless your deploy flow needs it.
GIT_TOKEN=

# Optional. Prefer SSH keys when possible.
SSH_PASSWORD=
