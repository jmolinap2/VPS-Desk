<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpsDesk.Desktop.ViewModels"
             x:Class="VpsDesk.Desktop.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="Terminal SSH" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Sesión interactiva persistente sobre SSH. La salida y los comandos no se guardan en el historial de VPS Desk."
                   Foreground="#8290A3" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="#18382E" CornerRadius="14" Padding="10,5" IsVisible="{Binding IsConnected}">
          <TextBlock Text="CONECTADO" Foreground="#5EE6A8" FontWeight="SemiBold" FontSize="11" />
        </Border>
        <Border Background="#4A2519" CornerRadius="14" Padding="10,5" IsVisible="{Binding IsProduction}">
          <TextBlock Text="PRODUCCIÓN" Foreground="#F5B37A" FontWeight="SemiBold" FontSize="11" />
        </Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ActiveServerLabel}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="#8EA0B7" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Conectar" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnected}" />
          <Button Content="Desconectar" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
          <Button Content="Ctrl+C" Command="{Binding SendInterruptCommand}" IsEnabled="{Binding IsConnected}" />
          <Button Content="Limpiar" Command="{Binding ClearTerminalCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#070A0F" BorderBrush="#243244" BorderThickness="1" CornerRadius="10" Padding="10">
      <TextBox x:Name="OutputBox"
               Text="{Binding TerminalOutput}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas"
               FontSize="{Binding FontSize}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <TextBlock Text="$" FontFamily="Consolas" FontSize="16" Foreground="#5EE6A8" VerticalAlignment="Center" />
      <TextBox x:Name="CommandInput"
               Grid.Column="1"
               Text="{Binding CommandText}"
               PlaceholderText="Escribe un comando y presiona Enter..."
               FontFamily="Consolas"
               FontSize="{Binding FontSize}"
               KeyDown="CommandInput_OnKeyDown"
               IsEnabled="{Binding IsConnected}" />
      <Button Grid.Column="2" Content="Enviar" Command="{Binding SendCommand}" />
    </Grid>

    <Border Grid.Row="4" Background="#3A2814" BorderBrush="#8A6122" BorderThickness="1" CornerRadius="8" Padding="12"
            IsVisible="{Binding HasPendingMultilinePaste}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="Pegado multilínea" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PendingMultilineMessage}" Foreground="#D8C49B" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Cancelar" Command="{Binding CancelMultilinePasteCommand}" />
          <Button Content="Enviar de todos modos" Command="{Binding ConfirmMultilinePasteCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
